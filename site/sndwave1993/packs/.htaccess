# Paulywaulophone is now WAULOPHONE: its old pack and song folders go to the new ones
RedirectMatch 301 ^/sndwave1993/packs/paulyw/(.*)$ /sndwave1993/packs/waulophone/$1
RedirectMatch 301 ^/sndwave1993/packs/songs/paulywaulophone/friday-at-four\.(ogg|mp3)$ /sndwave1993/packs/songs/waulophone/knock-on-the-ear-and-wait.$1
