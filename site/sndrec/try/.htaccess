# The earlier "Try it online" (BASILISK 16) lived here; it is now SNDWAVE2000 at /sndwave2000/play/.
# Everything but poster.png (still shown on /sndwave2000/) goes there; index.html does the same if this is ignored.
<IfModule mod_alias.c>
  RedirectMatch 301 ^/sndrec/try/(?!poster\.png$).*$ /sndwave2000/play/
</IfModule>
