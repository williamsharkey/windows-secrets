# Victory Loop: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Victory Loop
pack     = w3x-heritage
kind     = chiptune
composer = Wolfgang_
source   = Victory Loop, a FamiTracker module (victoryloop.ftm) from OpenGameArt (https://opengameart.org/sites/default/files/victory.zip). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/8-bit-victory-loop
arranger = Algorithmic Industries house band
source_sha256= 3b062cf67d63f066b35a1604328f58bcebce857083fd357103cda387f6d84dae
note     = Played twice through on the six Windows 3.1 sounds: the NES module's pulses on the ding piano and ding chords, the triangle on the ding bass, the noise on a ding snare.
midi     = victory-loop.mid
script   = victory-loop.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
lead        ch1     "Still Upright"                          lufs=-19 pan=6 verb=0.25
chords      ch2     "Sonic Chords"                           lufs=-23 pan=-16 verb=0.2
bass        ch3     "Field Bass"                             lufs=-20
snare       ch4     "Basement Snare"                         lufs=-27 pan=10

[dna]
# the presets' DNA when this song was written (used before the pack discs' own)
"w3x-heritage:Basement Snare" = ding@t120]F;D64S0R67V95G11
"w3x-heritage:Field Bass" = ding<<<+#8/ringout@20[@40]@0CP@0CP@0CP<<<#6L60;A0D3000S40R300K43
"w3x-heritage:Sonic Chords" = ding@25]#6U2~7/ringout@20[@40]@0CP@0CP@0CP#6T-2L45;A0D2000S35R600V85K55G-1
"w3x-heritage:Still Upright" = ding@10]#6U2~6Q-20/ding@5[@60]#6T12U2~6L60Q20;A0D2500S25R600V85K79G-1
