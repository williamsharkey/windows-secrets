# Nag Screen Blues: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Nag Screen Blues
pack     = w3x-heritage
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE1993)
licence  = CC0-1.0 (the composition and this arrangement)
note     = A 12-bar shuffle blues in G, 96 bpm, four choruses: ding piano boogie and walking ding bass, ding chords on the off-beats, the ringout whistle and the tada horn trading choruses, chimes on the turnarounds. Only the six Windows 3.1 sounds.
midi     = nag-screen-blues.mid
script   = nag-screen-blues.py

[master]
loudness = -16
ceiling  = -1.0

[echo]
time     = 1/8
feedback = 0.2
tone     = 3000
level    = -9

[reverb]
size     = 1.6
predelay = 15
tone     = 5000
level    = -6

[tracks]
# name      source  preset                                  mix
piano       ch1     "Still Upright"                          lufs=-20 pan=6 verb=0.25
bass        ch2     "Field Bass"                             lufs=-20 pan=-8 verb=0.15
comp        ch3     "Western Chords"                         lufs=-25 pan=-18 verb=0.2
whistle     ch4     "Gentle Whistle"                         lufs=-20 pan=14 echo=0.15 verb=0.3 tune=-31
horn        ch5     "Indigo Wire"                            lufs=-20 pan=-12 verb=0.3
bells       ch6     "Urban Ring"                             lufs=-25 pan=28 verb=0.4
snare       ch7     "Basement Snare"                         lufs=-28 pan=10
shaker      ch8     "Hollow Shaker"                          lufs=-31 pan=-24
lead        ch9     "Slate Pilot"                            lufs=-21 pan=4 echo=0.15 verb=0.3 tune=-56

[dna]
