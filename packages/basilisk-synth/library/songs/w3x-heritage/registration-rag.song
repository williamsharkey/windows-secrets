# Registration Rag: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Registration Rag
pack     = w3x-heritage
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE1993)
licence  = CC0-1.0 (the composition and this arrangement)
note     = A piano rag, 92 bpm: intro, A strain in C, B strain in F, A strain, coda. Every sound is one of the six that came with Windows 3.1: a ding piano with a stride left hand, chimes bells, a ringout whistle and lead, a tada fanfare, ding and ringin brushes.
midi     = registration-rag.mid
script   = registration-rag.py

[master]
loudness = -16
ceiling  = -1.0

[echo]
time     = 1/8
feedback = 0.25
tone     = 3000
level    = -8

[reverb]
size     = 1.6
predelay = 15
tone     = 5000
level    = -6

[tracks]
# name      source  preset                                  mix
righthand   ch1     "Still Upright"                          lufs=-19 pan=6 verb=0.25
stridebass  ch2     "Field Bass"                             lufs=-21 pan=-10 verb=0.15
stridechords ch3     "Western Chords"                         lufs=-24 pan=-16 verb=0.2
whistle     ch4     "Gentle Whistle"                         lufs=-22 pan=20 echo=0.15 verb=0.3 tune=-31
bells       ch5     "Urban Ring"                             lufs=-25 pan=28 verb=0.4
fanfare     ch6     "Honey Hit"                              lufs=-22 pan=-4 verb=0.35
snare       ch7     "Basement Snare"                         lufs=-28 pan=10
shaker      ch8     "Hollow Shaker"                          lufs=-31 pan=-24
pad         ch9     "Honey Haze"                             lufs=-30 verb=0.4
lead        ch11    "Slate Pilot"                            lufs=-21 pan=14 echo=0.15 verb=0.3 tune=-56

[dna]
# the presets' DNA when this song was written (used before the pack discs' own)
