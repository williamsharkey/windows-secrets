# The Entertainer: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = The Entertainer
pack     = w3x-heritage
kind     = world
composer = Scott Joplin (1868-1917)
source   = The Entertainer, a ragtime two-step (1902). Score: The Mutopia Project, from a reproduction of the original 1902 edition.
licence  = The work: public domain (published 1902; the composer died 1917). The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=263
arranger = Algorithmic Industries house band
note     = The intro and the A and B strains on a ding piano with a stride left hand, the B strain doubled by the ringout whistle, chimes bells on each strain, ding brushes, and the rag's last bars on the tada fanfare. Only the six Windows 3.1 sounds.
midi     = the-entertainer.mid
script   = the-entertainer.py

[master]
loudness = -16
ceiling  = -1.0

[echo]
time     = 1/8
feedback = 0.2
tone     = 3000
level    = -9

[reverb]
size     = 1.5
predelay = 15
tone     = 5000
level    = -6

[tracks]
# name      source  preset                                  mix
righthand   ch1     "Still Upright"                          lufs=-19 pan=6 verb=0.25
inner       ch2     "Elevated Ballad"                        lufs=-24 pan=14 verb=0.25
stridebass  ch3     "Field Bass"                             lufs=-21 pan=-10 verb=0.15
stridechords ch4     "Western Chords"                         lufs=-24 pan=-16 verb=0.2
whistle     ch5     "Gentle Whistle"                         lufs=-22 pan=20 echo=0.15 verb=0.3 tune=-31
bells       ch6     "Urban Ring"                             lufs=-25 pan=28 verb=0.4
fanfare     ch7     "Honey Hit"                              lufs=-22 pan=-4 verb=0.35
snare       ch8     "Basement Snare"                         lufs=-29 pan=10
shaker      ch9     "Hollow Shaker"                          lufs=-31 pan=-24

[dna]
