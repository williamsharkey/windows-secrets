# Atrium Level B2: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Atrium Level B2
pack     = lifestyle-aesthetics
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE1993)
licence  = CC0-1.0 (the composition and this arrangement)
note     = City pop in C major, 96 bpm: escalator, tines, nylon guitar, slow-jam bass, the rounded major-seventh chord, kalimba and marimba droplets, fountain coins, sparkle, a faraway choir. Drums: Kit Manager 98 (Echo Chamber Kit).
midi     = atrium-level-b2.mid
script   = atrium-level-b2.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -5

[reverb]
size     = 2.2
predelay = 20
tone     = 6000
level    = -4

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Echo Chamber Kit"           lufs=-18 verb=0.1
bass        ch2     "Slow Jam Bass"                          lufs=-19
tines       ch3     "Atrium Keys"                            lufs=-22 pan=-16 echo=0.15 verb=0.3 tune=-12
nylon       ch4     "Food Court Nylon"                       lufs=-20 pan=14 verb=0.3
chord       ch5     "Rounded Corner Chord"                   lufs=-25 pan=-24 echo=0.3 verb=0.25
kalimba     ch6     "Hydro Kalimba"                          lufs=-24 pan=26 echo=0.3 verb=0.3
marimba     ch7     "Droplet Marimba"                        lufs=-23 pan=-30 echo=0.2 verb=0.3
choir       ch8     "Faraway Choir"                          lufs=-26 verb=0.5 width=1.3
pad         ch9     "Weather Map Pad"                        lufs=-28 verb=0.4 width=1.3
escalator   ch11    "Escalator Ascent"                       lufs=-25 verb=0.3
coins       ch12    "Fountain Coins"                         lufs=-26 pan=34 echo=0.3 verb=0.5
sparkle     ch13    "Sparkle Cascade"                        lufs=-27 verb=0.5

