# Aquarium (Level 3): a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Aquarium (Level 3)
pack     = lifestyle-aesthetics
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE1993)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Slowed mall-pop in D-flat, 74 bpm: tank bubbles, the reef pad, the aquarium screensaver bell, the rounded major-seventh chord, the slow-jam bass, a VHS bell pad, distant hold music, the atrium keys, a reflection ping and the goodbye pad at closing. Drums: Kit Manager 98 (Echo Chamber Kit).
midi     = aquarium-level-three.mid
script   = aquarium-level-three.py

[master]
loudness = -16
ceiling  = -1.0

[echo]
time     = 3/8
feedback = 0.4
tone     = 2800
level    = -4

[reverb]
size     = 3.2
predelay = 30
tone     = 4500
level    = -3

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Echo Chamber Kit"           lufs=-20 verb=0.2 lp=8000
bubbles     ch1     "Tank Bubbles"                           lufs=-26 pan=-24 verb=0.4
bell        ch2     "Aquarium Screensaver"                   lufs=-21 pan=10 echo=0.3 verb=0.45
chord       ch3     "Rounded Corner Chord"                   lufs=-25 pan=-20 echo=0.3 verb=0.3
bass        ch4     "Slow Jam Bass"                          lufs=-20
vhspad      ch5     "VHS Bell Pad"                           lufs=-26 verb=0.4 width=1.3
holdmusic   ch6     "Hold Music Loop"                        lufs=-30 pan=30 lp=3000 verb=0.4
keys        ch7     "Atrium Keys"                            lufs=-20 pan=-6 echo=0.2 verb=0.35 tune=-12
goodbye     ch8     "Goodbye Pad"                            lufs=-26 verb=0.45 width=1.3
reef        ch9     "Reef Pad"                               lufs=-29 width=1.4
ping        ch11    "Reflection Ping"                        lufs=-27 pan=26 echo=0.4 verb=0.5

