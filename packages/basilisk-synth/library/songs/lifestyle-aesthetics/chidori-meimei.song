# Chidori Meimei: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Chidori Meimei
pack     = lifestyle-aesthetics
kind     = world
composer = Japanese traditional
source   = Chidori Meimei, as printed for shamisen in Nagai and Obata, "Seiyo gakufu Nihon zokkyokushu" (Osaka: Miki Shoten, 1895). Score: The Mutopia Project.
licence  = The work: traditional, public domain; the source was printed in 1895. The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=1765
arranger = Algorithmic Industries house band
note     = Three times through over a slow mall-pop groove: the shamisen tune on kalimba, atrium keys and glass keyboard in turn, a slow-jam bass on the chord roots, the weather-map pad. Drums: Kit Manager 98 (Echo Chamber Kit).
midi     = chidori-meimei.mid
script   = chidori-meimei.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3200
level    = -6

[reverb]
size     = 2.4
predelay = 20
tone     = 5500
level    = -5

[tracks]
# name      source  preset                                  mix
kalimba     ch1     "Hydro Kalimba"                          lufs=-20 pan=-8 echo=0.25 verb=0.35
tines       ch2     "Atrium Keys"                            lufs=-20 pan=8 echo=0.15 verb=0.3 tune=-12
glass       ch3     "Glass Keyboard"                         lufs=-22 pan=20 echo=0.3 verb=0.4 tune=-39
bass        ch4     "Slow Jam Bass"                          lufs=-20
pad         ch5     "Weather Map Pad"                        lufs=-27 verb=0.4 width=1.3
kit         ch10    "kit-manager:Echo Chamber Kit"           lufs=-20 verb=0.15

[dna]
