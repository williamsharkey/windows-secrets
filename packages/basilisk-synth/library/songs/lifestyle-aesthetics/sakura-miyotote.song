# Sakura-Miyotote: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Sakura-Miyotote
pack     = lifestyle-aesthetics
kind     = world
composer = Japanese traditional
source   = Sakura-Miyotote, as printed for koto in Nagai and Obata, "Seiyo gakufu Nihon zokkyokushu" (Osaka: Miki Shoten, 1895). Score: The Mutopia Project.
licence  = The work: traditional, public domain. The edition used: public domain (Mutopia; the source was printed in 1895). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=1971
arranger = Algorithmic Industries house band
note     = Kalimba and glass keyboard alone, then a slow city-pop groove with tines, nylon arpeggios, bass, choir and marimba, then the last phrase on kalimba. Moved up a semitone from the 1895 print. Drums: Kit Manager 98 (Echo Chamber Kit).
midi     = sakura-miyotote.mid
script   = sakura-miyotote.py

[master]
loudness = -16
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.35
tone     = 3200
level    = -5

[reverb]
size     = 2.8
predelay = 24
tone     = 5500
level    = -4

[tracks]
# name      source  preset                                  mix
kalimba     ch1     "Hydro Kalimba"                          lufs=-20 pan=-8 echo=0.25 verb=0.35
glasskeys   ch2     "Glass Keyboard"                         lufs=-25 pan=24 echo=0.3 verb=0.45 tune=-39
tines       ch3     "Atrium Keys"                            lufs=-20 pan=6 echo=0.15 verb=0.3 tune=-12
nylon       ch4     "Food Court Nylon"                       lufs=-24 pan=-22 verb=0.25
bass        ch5     "Slow Jam Bass"                          lufs=-20
choir       ch6     "Faraway Choir"                          lufs=-25 verb=0.5 width=1.3
pad         ch7     "Weather Map Pad"                        lufs=-27 verb=0.4 width=1.3
coins       ch8     "Fountain Coins"                         lufs=-26 pan=32 echo=0.3 verb=0.5
kit         ch10    "kit-manager:Echo Chamber Kit"           lufs=-19 verb=0.1
marimba     ch11    "Droplet Marimba"                        lufs=-25 pan=-30 echo=0.2 verb=0.3
pool        ch12    "Liminal Pool Room"                      lufs=-29 width=1.3

