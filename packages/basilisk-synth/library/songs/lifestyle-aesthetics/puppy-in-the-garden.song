# Puppy Playing in the Garden: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Puppy Playing in the Garden
pack     = lifestyle-aesthetics
kind     = chiptune
composer = Spring Spring
source   = Puppy Playing in the Garden, a 0CC-FamiTracker module (puppy.0cc) from OpenGameArt (https://opengameart.org/sites/default/files/puppy.zip). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/puppy-playing-in-the-garden
arranger = Algorithmic Industries house band
source_sha256= 27a14bd6089e8612a5cd10da1cd3b31db096d129753d17c265e53f61b9e63370
note     = Played twice through: the NES module's VRC6 pulse on the kalimba, the pulses on tines and marimba, the triangle on the slow-jam bass, DPCM and noise on Kit Manager 98 (Echo Chamber Kit).
midi     = puppy-in-the-garden.mid
script   = puppy-in-the-garden.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
kalimba     ch1     "Hydro Kalimba"                          lufs=-20 pan=10 echo=0.25 verb=0.3
keys        ch2     "Midnight Tines"                         lufs=-22 pan=-14 verb=0.3
marimba     ch3     "Atrium Marimba"                         lufs=-23 pan=24 verb=0.3
bass        ch4     "Slow Jam Bass"                          lufs=-20
kit         ch10    "kit-manager:Echo Chamber Kit"           lufs=-19 verb=0.1

[dna]
# the presets' DNA when this song was written (used before the pack discs' own)
