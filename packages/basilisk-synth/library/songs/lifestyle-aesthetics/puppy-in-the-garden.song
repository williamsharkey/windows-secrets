"lifestyle-aesthetics:Atrium Marimba" = xpding;A0D700S0R400V90K59G8
"lifestyle-aesthetics:Hydro Kalimba" = kalimba_c4#10/droplet_soft#4FL45O5;A0D900S0R500G2
