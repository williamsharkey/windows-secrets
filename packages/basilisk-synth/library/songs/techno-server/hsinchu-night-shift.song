# Hsinchu Night Shift: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Hsinchu Night Shift
pack     = techno-server
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Minimal techno in A minor, 128 bpm: a morse-code sequence shifting a step every eight bars, a minor-seventh stab and the feedback chain, an offbeat sub, relay ticks and a shaker, the spring tank, a riser, the cold choir wash in the breakdown. Drums: Kit Manager 98 (Long Boom Kit).
midi     = hsinchu-night-shift.mid
script   = hsinchu-night-shift.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.5
tone     = 2400
level    = -3
lowcut   = 250

[reverb]
size     = 2.4
predelay = 20
tone     = 4500
level    = -6

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Long Boom Kit"              lufs=-16.5 verb=0.04
morse       ch1     "Granite Line"                           lufs=-21 pan=-10 echo=0.4 verb=0.15
stab        ch2     "Washed Fanfare"                         lufs=-22 pan=8 echo=0.45 verb=0.25
chain       ch3     "Feedback Chain Stab"                    lufs=-25 pan=-16 echo=0.5 verb=0.3
sub         ch4     "Quiet Sub"                              lufs=-19
wash        ch5     "Cold Wash"                              lufs=-25 verb=0.45 width=1.3
tick        ch6     "Rural Tick"                             lufs=-28 pan=30 echo=0.25
click       ch7     "Coral Click"                            lufs=-28 pan=-28
spring      ch8     "Spring Tank Hit"                        lufs=-24 verb=0.4
riser       ch9     "Crystal Riser"                          lufs=-26 verb=0.4
texture     ch11    "Marble Current"                         lufs=-30 verb=0.3
shaker      ch12    "Vinyl Shaker"                           lufs=-30 pan=20

