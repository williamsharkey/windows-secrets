# On Again Off Again: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = On Again Off Again
pack     = techno-server
kind     = chiptune
composer = Chance de la Soul
source   = On Again Off Again, a FamiTracker module (On_Again_Off_Again.ftm) from OpenGameArt (https://opengameart.org/sites/default/files/on_again_off_again_nsf_ftm.zip). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/nes-on-again-off-again
arranger = Algorithmic Industries house band
source_sha256= 41e4465d5fc5f7337a2df1dd0af0bad05f9b03e017621a8419c01976d80e6123
note     = Played twice through as techno: the NES module's pulses and VRC6 lines on a CSIRAC-pulse lead, a hit, morse blips and horns, the VRC6 saw on the sub, its triangle on relay ticks, DPCM and noise on Kit Manager 98 (Long Boom Kit).
midi     = on-again-off-again.mid
script   = on-again-off-again.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
lead        ch1     "Folded Call"                            lufs=-21 pan=6 echo=0.3
stab        ch2     "Lattice Hit"                            lufs=-24 pan=-12 echo=0.4
morse       ch3     "Granite Line"                           lufs=-24 pan=-20 echo=0.35
chords      ch4     "Waxed Horns"                            lufs=-25 pan=18 verb=0.25
sub         ch5     "Felt Sub"                               lufs=-19 tune=-57
tick        ch6     "Rural Tick"                             lufs=-29 pan=28
kit         ch10    "kit-manager:Long Boom Kit"              lufs=-17 verb=0.04

