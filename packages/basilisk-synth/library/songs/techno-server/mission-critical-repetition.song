# Mission-Critical Repetition: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Mission-Critical Repetition
pack     = techno-server
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Dub techno in C minor, 126 bpm: one-finger dub chords into a long echo, offbeat sub, Detroit strings, relay ticks, mains hum and a transmission from Apollo 8. Drums: Kit Manager 98 (Long Boom Kit).
midi     = mission-critical-repetition.mid
script   = mission-critical-repetition.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.55
tone     = 2400
level    = -2
lowcut   = 250

[reverb]
size     = 2.4
predelay = 20
tone     = 4500
level    = -6

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Long Boom Kit"              lufs=-16.5 verb=0.04
sub         ch2     "Dot Sub"                                lufs=-19 tune=-55
dub         ch3     "One-Finger Dub Chord"                   lufs=-21 pan=-10 echo=0.55 verb=0.25
strings     ch4     "Motor City Strings"                     lufs=-24 pan=12 verb=0.35 width=1.3
lead        ch5     "Soft Pilot"                             lufs=-22 pan=8 echo=0.35 verb=0.2
hum         ch6     "Dusk Texture"                           lufs=-30 verb=0.2
click       ch7     "Coded Click"                            lufs=-28 pan=-30 echo=0.2
tick        ch8     "Relay Wood Tick"                        lufs=-28 pan=32 echo=0.25
hat         ch9     "Copper Hat"                             lufs=-28 pan=18
voice       ch11    "Transmission Voice"                     lufs=-22 echo=0.3 verb=0.3
sweep       ch12    "Rose Sweep"                             lufs=-27 verb=0.4 width=1.4
clap        ch13    "Indigo Clap"                            lufs=-26 pan=-6 verb=0.2

