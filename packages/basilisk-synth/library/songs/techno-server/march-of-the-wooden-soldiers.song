# March of the Wooden Soldiers: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = March of the Wooden Soldiers
pack     = techno-server
kind     = world
composer = Pyotr Ilyich Tchaikovsky (1840-1893)
source   = March of the Wooden Soldiers, Album for the Young, Op. 39 No. 5 (1878). Score: The Mutopia Project, from Schirmer (1904).
licence  = The work: public domain (published 1878; the composer died 1893). The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=1806
arranger = Algorithmic Industries house band
note     = Techno at 126 bpm: the march three times, on morse blips with dub chords, then the motor-whine lead with Detroit strings, then everything with relay ticks; a transmission before the second pass. Drums: Kit Manager 98 (Long Boom Kit).
midi     = march-of-the-wooden-soldiers.mid
script   = march-of-the-wooden-soldiers.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.5
tone     = 2400
level    = -3
lowcut   = 250

[reverb]
size     = 2.2
predelay = 20
tone     = 4500
level    = -6

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Long Boom Kit"              lufs=-16.5 verb=0.04
morse       ch1     "Granite Line"                           lufs=-21 pan=-12 echo=0.4 verb=0.15
lead        ch2     "Soft Pilot"                             lufs=-20 pan=8 echo=0.3 verb=0.2
dub         ch3     "One-Finger Dub Chord"                   lufs=-22 pan=-6 echo=0.55 verb=0.25
strings     ch4     "Motor City Strings"                     lufs=-24 pan=14 verb=0.35 width=1.3
sub         ch5     "Dot Sub"                                lufs=-19 tune=-55
tick        ch6     "Relay Wood Tick"                        lufs=-28 pan=30 echo=0.25
hat         ch7     "Copper Hat"                             lufs=-28 pan=18
clap        ch8     "Indigo Clap"                            lufs=-26 pan=-6 verb=0.2
voice       ch9     "Transmission Voice"                     lufs=-22 echo=0.3 verb=0.3
hum         ch11    "Dusk Texture"                           lufs=-30 verb=0.2

