# In the Hall of the Mountain King: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = In the Hall of the Mountain King
pack     = game-port
kind     = world
composer = Edvard Grieg (1843-1907)
source   = In the Hall of the Mountain King, Peer Gynt Suite No. 1, Op. 46 No. 4 (1875), piano version. Score: The Mutopia Project, from The University Society (1918).
licence  = The work: public domain (composed 1875; the composer died 1907). The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=1888
arranger = Algorithmic Industries house band
note     = A chiptune: the theme on a pulse bass, then square leads and chord arpeggios over noise drums, the tempo climbing from 96 to 200 bpm, a 286 boot at the start and a coin at the end.
midi     = hall-of-the-mountain-king.mid
script   = hall-of-the-mountain-king.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 1/8
feedback = 0.25
tone     = 4000
level    = -7

[reverb]
size     = 1.2
predelay = 10
tone     = 6000
level    = -9

[tracks]
# name      source  preset                                  mix
lead        ch1     "Midnight Signal"                        lufs=-20 pan=-6 echo=0.12 verb=0.1
lead2       ch2     "Second Ray"                             lufs=-21 pan=20 echo=0.12
arp         ch3     "Lucid Line"                             lufs=-26 pan=-24
bass        ch4     "Waxed Line"                             lufs=-19 tune=-58
kick        ch5     "Silver Block"                           lufs=-21
snare       ch6     "Chrome Snap"                            lufs=-23
hat         ch7     "Slate Tick"                             lufs=-29 pan=18
coin        ch8     "Coin Jingle"                            lufs=-24 echo=0.2
boot        ch9     "Digital Sweep"                          lufs=-24 verb=0.2
riser       ch11    "Kinetic Riser"                          lufs=-27 verb=0.3

