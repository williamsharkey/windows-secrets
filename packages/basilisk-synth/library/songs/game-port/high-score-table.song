# High Score Table: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = High Score Table
pack     = game-port
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE1993)
licence  = CC0-1.0 (the composition and this arrangement)
note     = A chiptune at 144 bpm: a name-entry jingle, then the credits theme in C and a minor-key strain on pulse leads with a soft echo lead a sixteenth behind, a harmony line, chord arpeggios, an octave bass, noise drums from the pack's percussion, a coin and a 286 shutting down.
midi     = high-score-table.mid
script   = high-score-table.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 1/8
feedback = 0.25
tone     = 4000
level    = -8

[reverb]
size     = 1.2
predelay = 10
tone     = 6000
level    = -9

[tracks]
# name      source  preset                                  mix
lead        ch1     "Ivory Signal"                           lufs=-19 pan=-8 verb=0.1
echolead    ch2     "Ivory Signal"                           lufs=-26 pan=24
arp         ch3     "Pastel Signal"                          lufs=-26 pan=-24 tune=-56
bass        ch4     "Cobalt Anchor"                          lufs=-19 tune=-57
kick        ch5     "Silver Block"                           lufs=-21
snare       ch6     "Sunlit Knock"                           lufs=-23
hat         ch7     "Lagoon Click"                           lufs=-29 pan=18
coin        ch8     "Coin Jingle"                            lufs=-24 echo=0.2
fx          ch9     "Matte Uplink"                           lufs=-25 verb=0.3
harmony     ch11    "Warm Lead"                              lufs=-24 pan=14

