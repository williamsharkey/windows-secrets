# My Street: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = My Street
pack     = game-port
kind     = chiptune
composer = congusbongus
source   = My Street, a FastTracker 2 module (my street.xm), from OpenGameArt. Its notes are played here; its samples are not used.
licence  = The module: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/my-street
arranger = Algorithmic Industries house band
note     = The module's six instruments on Game Port presets: square lead, wave and sine arpeggios, a long pad, triangle bass; the noise channel on the Kit Manager 98 Noise Channel kit (snare and hat by pitch).
midi     = my-street.mid
script   = my-street.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.25
tone     = 4000
level    = -7

[reverb]
size     = 1.2
predelay = 10
tone     = 6000
level    = -9

[tracks]
# name      source  preset                                  mix
square      ch1     "Midnight Signal"                        lufs=-20 pan=-8 echo=0.12 verb=0.1
wave        ch2     "Lucid Line"                             lufs=-24 pan=22 echo=0.1
sine        ch3     "Second Ray"                             lufs=-23 pan=-20
bass        ch4     "Waxed Line"                             lufs=-19 tune=-58
long        ch5     "Cold Voice"                             lufs=-25 pan=12 verb=0.25 tune=-49
noise       ch10    "kit-manager:Noise Channel Kit"          lufs=-19 verb=0.05

[dna]
