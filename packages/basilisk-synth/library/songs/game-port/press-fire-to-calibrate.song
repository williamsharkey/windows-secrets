# Press Fire to Calibrate: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Press Fire to Calibrate
pack     = game-port
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE1993)
licence  = CC0-1.0 (the composition and this arrangement)
note     = A chiptune in A minor, 150 bpm: the 286 boots, pulse leads with a counter-melody, sixteenth-note chord arpeggios, an octave-jumping bass, noise drums from the pack's percussion, a coin.
midi     = press-fire-to-calibrate.mid
script   = press-fire-to-calibrate.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 4000
level    = -5

[reverb]
size     = 1.2
predelay = 10
tone     = 6000
level    = -9

[tracks]
# name      source  preset                                  mix
lead        ch1     "Midnight Signal"                        lufs=-19 pan=-8 echo=0.15 verb=0.12
lead2       ch2     "Cold Voice"                             lufs=-23 pan=22 echo=0.2 verb=0.15 tune=-49
arp         ch3     "Lucid Line"                             lufs=-25 pan=-26 echo=0.1
bass        ch4     "Waxed Line"                             lufs=-19 tune=-58
kick        ch5     "Silver Block"                           lufs=-20
snare       ch6     "Chrome Snap"                            lufs=-22 verb=0.1
hat         ch7     "Slate Tick"                             lufs=-28 pan=18
rim         ch8     "Glass Rim"                              lufs=-29 pan=-20
boot        ch9     "Digital Sweep"                          lufs=-23 verb=0.2
coin        ch11    "Coin Jingle"                            lufs=-24 pan=10 echo=0.2
riser       ch12    "Kinetic Riser"                          lufs=-26 verb=0.3
voice       ch13    "Pastel Signal"                          lufs=-23 pan=4 echo=0.3 verb=0.3 tune=-56

