# Duel Time: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Duel Time
pack     = game-port
kind     = chiptune
composer = Wolfgang_
source   = Duel Time, a FamiTracker module (DuelTime.ftm) from OpenGameArt (https://opengameart.org/sites/default/files/DuelTime.zip). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/8-bit-duel-theme
arranger = Algorithmic Industries house band
source_sha256= ebe917f826746dea7b5015ef1a56318254ee248283101b5d295bdcbbe1ae7bfa
note     = Played three times through: the NES module's pulses on two Game Port leads, the VRC6 pulses on an arpeggio and a warm lead, the triangle on the sub, the noise on Kit Manager 98 (Noise Channel Kit).
midi     = duel-time.mid
script   = duel-time.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
lead        ch1     "Lucid Line"                             lufs=-20 pan=-8 echo=0.12
lead2       ch2     "Harbor Whistle"                         lufs=-23 pan=20
bass        ch3     "Saffron Sub"                            lufs=-19
arp         ch4     "Zinc Ray"                               lufs=-25 pan=-24 tune=-57
vrc         ch5     "Warm Lead"                              lufs=-24 pan=24
kit         ch10    "kit-manager:Noise Channel Kit"          lufs=-19 verb=0.05

[dna]
