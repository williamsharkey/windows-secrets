# The Restorer's Afternoon: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = The Restorer's Afternoon
pack     = tape-parlour
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Late-60s chamber pop in D major, 84 bpm, on tape-replay voices: flutes over a descending bass, violas, cellos, choir, saxello, a trumpet solo, a recorder counter-line, the 8-foot organ stop and a parlour piano. Drums: Kit Manager 98 (Half-Time Kit).
midi     = the-restorers-afternoon.mid
script   = the-restorers-afternoon.py

[master]
loudness = -16
ceiling  = -1.0

[echo]
time     = 1/8
feedback = 0.25
tone     = 2800
level    = -8

[reverb]
size     = 1.9
predelay = 20
tone     = 4500
level    = -4

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Half-Time Kit"              lufs=-19 verb=0.12 lp=9000
flute       ch1     "Dusk Pilot"                             lufs=-19 pan=-10 verb=0.3 tune=-12
violas      ch2     "Hollow Legato"                          lufs=-23 pan=24 verb=0.35
cellos      ch3     "Wired Legato"                           lufs=-24 pan=-26 verb=0.3
bass        ch4     "Vinyl Section"                          lufs=-21
choir       ch5     "Modular Chorus"                         lufs=-20 pan=6 verb=0.4
saxello     ch6     "Gentle Chord"                           lufs=-25 pan=-18 verb=0.25
trumpet     ch7     "Northern Salute"                        lufs=-21 pan=14 verb=0.35
recorder    ch8     "Quiet Voice"                            lufs=-22 pan=30 echo=0.15 verb=0.3
organ       ch9     "Noble Stops"                            lufs=-26 pan=-6 verb=0.3
piano       ch11    "Swift Ivories"                          lufs=-23 pan=16 verb=0.25

