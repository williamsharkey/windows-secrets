# Cave: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Cave
pack     = tape-parlour
kind     = chiptune
composer = Wolfgang_
source   = Cave, a FamiTracker module (Cave.ftm) from OpenGameArt (https://opengameart.org/sites/default/files/cave_1.zip). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/8-bit-cave-loop
arranger = Algorithmic Industries house band
source_sha256= be13735b4e5e625568dbb03b72750d9fb6802cb946fd74e3afd23e2c9b31f6af
note     = Played twice through on tape-replay voices: the NES module's pulse 1 on the contrabass, pulse 2 on the cellos, the triangle on the flute, the noise on Kit Manager 98 (Half-Time Kit).
midi     = cave.mid
script   = cave.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
bass        ch1     "Vinyl Section"                          lufs=-20
cellos      ch2     "Northern Bows"                          lufs=-21 pan=-16 verb=0.3
flute       ch3     "Dusk Pilot"                             lufs=-21 pan=10 verb=0.3 tune=-12
kit         ch10    "kit-manager:Half-Time Kit"              lufs=-21 verb=0.12 lp=8000

[dna]
