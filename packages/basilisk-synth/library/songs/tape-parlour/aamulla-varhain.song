# Aamulla varhain: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Aamulla varhain
pack     = tape-parlour
kind     = world
composer = Finnish traditional
source   = Aamulla varhain (Early in the Morning), Finnish folk song. Score: The Mutopia Project (voice and piano; the tune is taken, the arrangement is new).
licence  = The work: traditional, public domain. The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=1020
arranger = Algorithmic Industries house band
note     = Late-60s chamber pop at 80 bpm on tape-replay voices: the tune on flute, choir, cellos and trumpet in turn, a recorder answering, violas, a parlour piano, a contrabass, the 8-foot organ stop, a soft kit, a ritardando at the end. Drums: Kit Manager 98 (Half-Time Kit).
midi     = aamulla-varhain.mid
script   = aamulla-varhain.py

[master]
loudness = -16
ceiling  = -1.0

[echo]
time     = 1/8
feedback = 0.25
tone     = 2800
level    = -8

[reverb]
size     = 1.9
predelay = 20
tone     = 4500
level    = -4

[tracks]
# name      source  preset                                  mix
flute       ch1     "Dusk Pilot"                             lufs=-19 pan=-10 verb=0.3 tune=-12
choir       ch2     "Modular Chorus"                         lufs=-20 pan=6 verb=0.4
recorder    ch3     "Quiet Voice"                            lufs=-23 pan=30 echo=0.15 verb=0.3
cellos      ch4     "Northern Bows"                          lufs=-21 pan=-24 verb=0.3
violas      ch5     "Hollow Legato"                          lufs=-24 pan=24 verb=0.35
piano       ch6     "Swift Ivories"                          lufs=-22 pan=16 verb=0.25
bass        ch7     "Vinyl Section"                          lufs=-22
organ       ch8     "Noble Stops"                            lufs=-26 pan=-6 verb=0.3
trumpet     ch9     "Northern Salute"                        lufs=-21 pan=10 verb=0.35
kit         ch10    "kit-manager:Half-Time Kit"              lufs=-20 verb=0.12 lp=9000

