# Wow and Flutter Waltz: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Wow and Flutter Waltz
pack     = tape-parlour
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = A baroque-pop waltz in A minor, 3/4 at 118 bpm, on tape-replay voices: bowed psaltery, a solo violin, violins, a harmonica-organ waltz, a tuba bass, the ocarina and a horn in the middle, the choir, a parlour piano intro. Drums: Kit Manager 98 (Half-Time Kit).
midi     = wow-and-flutter-waltz.mid
script   = wow-and-flutter-waltz.py

[master]
loudness = -16
ceiling  = -1.0

[echo]
time     = 1/4
feedback = 0.2
tone     = 2800
level    = -9

[reverb]
size     = 1.9
predelay = 20
tone     = 4500
level    = -4

[tracks]
# name      source  preset                                  mix
psaltery    ch1     "Amber Strings"                          lufs=-20 pan=-10 verb=0.3
violin      ch2     "Upper Legato"                           lufs=-20 pan=8 verb=0.3
violins     ch3     "Northern Strings"                       lufs=-23 pan=22 verb=0.35
organ       ch4     "Bakelite Stops"                         lufs=-25 pan=-18 verb=0.25
tuba        ch5     "Office Horns"                           lufs=-21
ocarina     ch6     "Federal Spark"                          lufs=-20 pan=4 echo=0.1 verb=0.35 tune=22
choir       ch7     "Upper Murmur"                           lufs=-26 verb=0.4
piano       ch8     "Swift Ivories"                          lufs=-22 pan=14 verb=0.25
horn        ch9     "Pewter Herald"                          lufs=-24 pan=-20 verb=0.35 tune=14
kit         ch10    "kit-manager:Half-Time Kit"              lufs=-22 verb=0.12 lp=8000

