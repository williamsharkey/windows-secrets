# Chipnese: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Chipnese
pack     = garden-rhythm
kind     = chiptune
composer = Spring Spring
source   = Chipnese, a 0CC-FamiTracker module (chipnese.0cc) from OpenGameArt (https://opengameart.org/sites/default/files/chipnese_0.zip). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/chipnese
arranger = Algorithmic Industries house band
source_sha256= 1f247922c637e7bf001ca2c06c6350ab5f96c39493ac8fc364ad6a46f08d35a0
note     = Played twice through: the NES module's VRC6 lines on the steelpan and marimbas, the triangle on the rave-organ bass, pulse 2 on a rave chord, pulse 1 on a steelpan peal, the VRC6 saw on the hoover, the noise on the radio kit.
midi     = chipnese.mid
script   = chipnese.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
steelpan    ch1     "Digital Tower"                          lufs=-20 pan=12 echo=0.25 verb=0.3
mallets     ch2     "Lagoon Mallets"                         lufs=-22 pan=-22 verb=0.3
organbass   ch3     "Molten Brass"                           lufs=-20
stab        ch4     "Winter Salute"                          lufs=-24 pan=20
pan2        ch5     "Brass Peal"                             lufs=-25 pan=-12 echo=0.2
hoover      ch6     "Lagoon Stab"                            lufs=-23 width=1.2
kit         ch10    "Humid Haze"                             lufs=-19 verb=0.05

