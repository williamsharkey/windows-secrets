# Squirrel's Hideout: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Squirrel's Hideout
pack     = garden-rhythm
kind     = chiptune
composer = Spring Spring
source   = Squirrel's Hideout, an Impulse Tracker module (hideoutCLEAN.it) from OpenGameArt (https://opengameart.org/sites/default/files/OST.zip). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/haydenwoffle-it-soundtrack
arranger = Algorithmic Industries house band
source_sha256= 229116f843b375c5321efd1c823b0c5e8667e8887500642566a32b58ac32ec97
note     = Played twice through: the module's timpani on the pack's timpani, its lines on rave piano, rave brass, steelpan, marimba and marimba-third, its pad and choirs on the aurora pad and the talking machines, its hat on the studio kit.
midi     = squirrels-hideout.mid
script   = squirrels-hideout.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
timpani     ch1     "Night Tower"                            lufs=-20 verb=0.3
ravepiano   ch2     "Lucid Punch"                            lufs=-21 pan=-10 verb=0.2 tune=-10
brass       ch3     "Molten Brass"                           lufs=-23 pan=14 verb=0.2
steelpan    ch4     "Digital Tower"                          lufs=-21 pan=12 echo=0.25 verb=0.3
mallets     ch5     "Lagoon Mallets"                         lufs=-23 pan=-24 echo=0.2 verb=0.3
pad         ch6     "Blue Aurora"                            lufs=-26 verb=0.4 width=1.3
tower       ch7     "Granite Tower"                          lufs=-25 pan=26 verb=0.3
stab        ch8     "Electric Stab"                          lufs=-25 pan=-20 verb=0.2
voice       ch9     "Brushed Chorus"                         lufs=-25 verb=0.35 tune=-17
chorus      ch11    "Metro Choir"                            lufs=-26 verb=0.4
kit         ch10    "White Pad"                              lufs=-21 verb=0.05

