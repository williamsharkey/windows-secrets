# Banzai-Bushi: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Banzai-Bushi
pack     = garden-rhythm
kind     = world
composer = Japanese traditional
source   = Banzai-Bushi, as printed for shamisen in Nagai and Obata, "Seiyo gakufu Nihon zokkyokushu" (Osaka: Miki Shoten, 1895). Score: The Mutopia Project.
licence  = The work: traditional, public domain. The edition used: public domain (Mutopia; the source was printed in 1895). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=1759
arranger = Algorithmic Industries house band
note     = Early-90s rave at 128 bpm: the shamisen tune on steelpan, marimba and the hoover, taiko and breakbeats, a tabla kit, rave-organ bass, rave piano, a robot choir and the talking machine's hello. All from the pack.
midi     = banzai-bushi.mid
script   = banzai-bushi.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.38
tone     = 3500
level    = -4

[reverb]
size     = 2.0
predelay = 15
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
kit         ch10    "Second Bloom"                           lufs=-17 verb=0.05
taiko       ch9     "Gentle Bloom"                           lufs=-20 verb=0.3
tabla       ch11    "Coded Bloom"                            lufs=-24 pan=24 verb=0.1
steelpan    ch1     "Digital Tower"                          lufs=-20 pan=12 echo=0.3 verb=0.3
ravepiano   ch2     "Lucid Punch"                            lufs=-21 pan=-10 verb=0.2 tune=-10
organbass   ch3     "Molten Brass"                           lufs=-20
hoover      ch4     "Lagoon Stab"                            lufs=-20 pan=6 width=1.3 verb=0.15
pad         ch5     "Bakelite Bloom"                         lufs=-26 verb=0.35 width=1.4
robot       ch6     "Grey Choir"                             lufs=-25 pan=-14 verb=0.4
hello       ch7     "Rubber Ahh"                             lufs=-21 echo=0.35 verb=0.3
marimba     ch8     "Lagoon Mallets"                         lufs=-23 pan=-24 echo=0.2 verb=0.3
shaker      ch12    "Swift Shaker"                           lufs=-29 pan=-30

