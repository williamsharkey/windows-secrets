# Sow Your Breaks in Spring: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Sow Your Breaks in Spring
pack     = garden-rhythm
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Early-90s rave in A minor, 140 bpm: a talking machine says hello, taiko hits, breakbeats from the radio kit, rave piano, rave-organ bass, the hoover riff, a scream, a steelpan breakdown with a robot choir, a tabla kit on the last run. All from the pack.
midi     = sow-your-breaks-in-spring.mid
script   = sow-your-breaks-in-spring.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.38
tone     = 3500
level    = -4

[reverb]
size     = 2.0
predelay = 15
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
kit         ch10    "Second Bloom"                           lufs=-16.5 verb=0.05
taiko       ch9     "Gentle Bloom"                           lufs=-21 verb=0.3
tabla       ch11    "Coded Bloom"                            lufs=-24 pan=24 verb=0.1
ravepiano   ch1     "Lucid Punch"                            lufs=-20 pan=-10 verb=0.2 tune=-10
organbass   ch2     "Molten Brass"                           lufs=-20
hoover      ch3     "Lagoon Stab"                            lufs=-20 pan=8 width=1.3 verb=0.15
scream      ch4     "Global Salute"                          lufs=-23 echo=0.3 verb=0.3
pad         ch5     "Bakelite Bloom"                         lufs=-25 verb=0.35 width=1.4
hello       ch6     "Rubber Ahh"                             lufs=-21 echo=0.35 verb=0.3
robot       ch7     "Grey Choir"                             lufs=-25 pan=-14 verb=0.4
steelpan    ch8     "Digital Tower"                          lufs=-21 pan=16 echo=0.3 verb=0.3
shaker      ch12    "Swift Shaker"                           lufs=-29 pan=-30

