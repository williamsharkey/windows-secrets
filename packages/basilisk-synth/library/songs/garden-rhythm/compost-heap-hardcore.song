# Compost Heap Hardcore: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Compost Heap Hardcore
pack     = garden-rhythm
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Early-90s hardcore in D minor, 150 bpm: taiko on the build, breakbeats from the radio kit with the hands kit on top, rave-piano fifths, rave-organ bass, the hoover riff, the scream, timpani, a goose-voice chant, a reese and the crystal-fantasia pad in the breakdown. All from the pack.
midi     = compost-heap-hardcore.mid
script   = compost-heap-hardcore.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.38
tone     = 3500
level    = -4

[reverb]
size     = 2.0
predelay = 15
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
kit         ch10    "Humid Haze"                             lufs=-17 verb=0.05
hands       ch9     "Wired Drift"                            lufs=-24 pan=24 verb=0.1
taiko       ch11    "Gentle Bloom"                           lufs=-20 verb=0.3
ravepiano   ch1     "Rural Brass"                            lufs=-20 pan=-10 verb=0.2 tune=-13
hoover      ch2     "Lagoon Stab"                            lufs=-20 pan=6 width=1.3 verb=0.15
scream      ch3     "Global Salute"                          lufs=-23 echo=0.3 verb=0.3
organbass   ch4     "Brass Blast"                            lufs=-20
pad         ch5     "Electric Canopy"                        lufs=-26 verb=0.35 width=1.4
chant       ch6     "Warm Chant"                             lufs=-22 echo=0.3 verb=0.35
timpani     ch7     "Lucid Haze"                             lufs=-24 verb=0.3
reese       ch8     "Electric Stab"                          lufs=-24 width=1.3

