# Polonaise in G minor: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Polonaise in G minor
pack     = retro-display
kind     = world
composer = attributed to Johann Sebastian Bach
source   = Polonaise in G minor, BWV Anh. 119, from the Notebook for Anna Magdalena Bach (1725). Score: The Mutopia Project, from the Bach-Gesellschaft Ausgabe.
licence  = The work: public domain (18th century). The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=1016
arranger = Algorithmic Industries house band
note     = Five times through as a synthwave waltz: the chrome lead, the rooftop sax and a kalimba line take turns, tine EP on the left hand, brass swells, the rumble bass, a pad. Drums: Kit Manager 98 (Echo Chamber Kit).
midi     = polonaise-in-g-minor.mid
script   = polonaise-in-g-minor.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3200
level    = -6

[reverb]
size     = 2.4
predelay = 20
tone     = 5500
level    = -5

[tracks]
# name      source  preset                                  mix
lead        ch1     "Chrome Brass Lead"                      lufs=-19 pan=4 echo=0.2 verb=0.3
sax         ch2     "Rooftop Sax Lead"                       lufs=-20 pan=-6 echo=0.2 verb=0.35
arp         ch3     "Violet Chords"                          lufs=-22 pan=22 echo=0.3 tune=-20
ep          ch4     "Shiny Tine Plaza"                       lufs=-24 pan=-18 verb=0.25
bass        ch6     "Saffron Rumble"                         lufs=-19
pad         ch7     "Northern Bloom"                         lufs=-27 verb=0.4 width=1.4
kit         ch10    "kit-manager:Echo Chamber Kit"           lufs=-18 verb=0.12

[dna]
