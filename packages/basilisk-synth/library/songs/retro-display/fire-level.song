# Fire Level: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Fire Level
pack     = retro-display
kind     = chiptune
composer = Spring Spring
source   = Fire_Level, a Standard MIDI File (Fire_Level.mid) from OpenGameArt (https://opengameart.org/sites/default/files/Fire%20Level.mid). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/fire-level
arranger = Algorithmic Industries house band
source_sha256= d2162064a0a20cdcd60d7b1e0d849d91c644c79ad99e1076c0d1f64e3ac162fd
note     = The MIDI file's 2A03 and VRC6 lines on the sun-glare lead, a pilot lead, kalimba chords and the basement bass, the noise channel on Kit Manager 98 (Echo Chamber Kit).
midi     = fire-level.mid
script   = fire-level.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
lead        ch1     "Sun Glare Lead"                         lufs=-20 pan=4 echo=0.2 verb=0.25
lead2       ch2     "Field Pilot"                            lufs=-23 pan=-16
arp         ch3     "Violet Chords"                          lufs=-24 pan=24 echo=0.3 tune=-20
bass        ch4     "Remote Basement"                        lufs=-19
kit         ch10    "kit-manager:Echo Chamber Kit"           lufs=-17 verb=0.12

