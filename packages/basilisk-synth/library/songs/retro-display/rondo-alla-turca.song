# Rondo alla Turca: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Rondo alla Turca
pack     = retro-display
kind     = world
composer = Wolfgang Amadeus Mozart (1756-1791)
source   = Piano Sonata No. 11 in A, K. 331, third movement "Alla Turca" (1783). Score: The Mutopia Project.
licence  = The work: public domain (18th century). The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=108
arranger = Algorithmic Industries house band
note     = Synthwave at 126 bpm, the whole movement: chrome lead (a sax in the F-sharp minor episode), inner voices on bright keys, the left hand on tine EP and an octave bass, brass on the A-major march, gated drums. Drums: Kit Manager 98 (Echo Chamber Kit) with the pack's Yellow Snare.
midi     = rondo-alla-turca.mid
script   = rondo-alla-turca.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.35
tone     = 3200
level    = -4

[reverb]
size     = 2.4
predelay = 18
tone     = 5500
level    = -5

[tracks]
# name      source  preset                                  mix
lead        ch1     "Chrome Brass Lead"                      lufs=-19 pan=4 echo=0.2 verb=0.3
keys        ch2     "Violet Chords"                          lufs=-25 pan=24 echo=0.2 verb=0.2 tune=-20
ep          ch3     "Shiny Tine Plaza"                       lufs=-24 pan=-18 verb=0.25
bass        ch4     "Saffron Rumble"                         lufs=-19
brass       ch5     "Digital Swell"                          lufs=-23 pan=10 verb=0.3 width=1.3
pad         ch6     "Northern Bloom"                         lufs=-27 verb=0.4 width=1.4
sax         ch7     "Rooftop Sax Lead"                       lufs=-19 pan=-6 echo=0.2 verb=0.35
sweep       ch8     "Laser Grid Sweep"                       lufs=-26 verb=0.4
kit         ch10    "kit-manager:Echo Chamber Kit"           lufs=-17 verb=0.12
snare2      ch11    "Yellow Snare"                           lufs=-26 verb=0.4

