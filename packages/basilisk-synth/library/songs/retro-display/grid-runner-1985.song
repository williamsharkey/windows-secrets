# Grid Runner 1985: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Grid Runner 1985
pack     = retro-display
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Outrun in A minor, 118 bpm: a driving sixteenth bass, four-on-the-floor gated drums, the laser grid sweep, the sun-glare lead, digital hammers, kalimba arpeggios, night-window strings and the rooftop sax on the last chorus. Drums: Kit Manager 98 (Echo Chamber Kit) with the pack's Yellow Snare.
midi     = grid-runner-1985.mid
script   = grid-runner-1985.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.38
tone     = 3200
level    = -3

[reverb]
size     = 2.6
predelay = 18
tone     = 5500
level    = -5

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Echo Chamber Kit"           lufs=-17 verb=0.12
bass        ch1     "Remote Basement"                        lufs=-19
lead        ch2     "Sun Glare Lead"                         lufs=-20 pan=4 echo=0.25 verb=0.3
hammers     ch3     "Digital Hammers"                        lufs=-24 pan=-18 verb=0.25
strings     ch4     "Night Window Strings"                   lufs=-24 pan=14 verb=0.35 width=1.3
sax         ch5     "Rooftop Sax Lead"                       lufs=-20 pan=-6 echo=0.2 verb=0.35
sweep       ch6     "Laser Grid Sweep"                       lufs=-26 verb=0.4
pad         ch7     "Laser Glow"                             lufs=-27 verb=0.4 width=1.4
snare2      ch8     "Yellow Snare"                           lufs=-26 verb=0.4
arp         ch9     "Violet Chords"                          lufs=-26 pan=24 echo=0.3 verb=0.2 tune=-20

[dna]
