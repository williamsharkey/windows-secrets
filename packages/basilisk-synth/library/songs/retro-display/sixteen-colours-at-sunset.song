# Sixteen Colours at Sunset: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Sixteen Colours at Sunset
pack     = retro-display
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE1993)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Synthwave in E minor, 100 bpm: gated drums, octave bass in eighths, tine EP, chrome lead, brass swells, a kalimba arpeggio, a sax solo. Drums: Kit Manager 98 (Echo Chamber Kit) with the pack's Yellow Snare.
midi     = sixteen-colours-at-sunset.mid
script   = sixteen-colours-at-sunset.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.38
tone     = 3200
level    = -3

[reverb]
size     = 2.6
predelay = 18
tone     = 5500
level    = -5

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Echo Chamber Kit"           lufs=-17 verb=0.12
bass        ch2     "Saffron Rumble"                         lufs=-19
ep          ch3     "Shiny Tine Plaza"                       lufs=-23 pan=-18 echo=0.15 verb=0.25
arp         ch4     "Violet Chords"                          lufs=-25 pan=22 echo=0.3 verb=0.2 tune=-20
lead        ch5     "Chrome Brass Lead"                      lufs=-20 pan=4 echo=0.25 verb=0.3
sax         ch6     "Rooftop Sax Lead"                       lufs=-20 pan=-6 echo=0.2 verb=0.35
brass       ch7     "Digital Swell"                          lufs=-23 pan=10 verb=0.3 width=1.3
pad         ch8     "Northern Bloom"                         lufs=-26 verb=0.4 width=1.4
sweep       ch9     "Laser Grid Sweep"                       lufs=-26 verb=0.4
snare2      ch11    "Yellow Snare"                           lufs=-26 verb=0.4
orch        ch12    "Waxed Orchestra"                        lufs=-23 verb=0.4

