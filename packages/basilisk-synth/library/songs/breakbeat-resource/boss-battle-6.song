# Boss Battle 6: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Boss Battle 6
pack     = breakbeat-resource
kind     = chiptune
composer = nene
source   = Boss_Battle_6, a Standard MIDI File (Boss_Battle_6.mid) from OpenGameArt (https://opengameart.org/sites/default/files/Boss%20Battle%206.mid). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/boss-battle-6-8-bit
arranger = Algorithmic Industries house band
source_sha256= 059a90730a4ebcb73662d4827564c47bc80581579dbc0e70f903840eb51a4c74
note     = A CC0 boss theme as breakbeat: its lead guitar on a lead, the two rhythm guitars on trombone stabs, its bass on the reese, strings on a pad, two synth lines on horns and a ray, its General MIDI drums on Kit Manager 98 (Breaker Box Kit).
midi     = boss-battle-6.mid
script   = boss-battle-6.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
lead        ch1     "Velvet Pilot"                           lufs=-20 pan=4 echo=0.2
gtr         ch2     "Rainy Chord"                            lufs=-24 pan=-24
gtr2        ch3     "Blue Accent"                            lufs=-24 pan=24
bass        ch4     "Neuro Growl"                            lufs=-19
pad         ch5     "Granite Pad"                            lufs=-26 verb=0.4
hit         ch6     "Northern Hit"                           lufs=-24 verb=0.3
signal      ch7     "Steady Ray"                             lufs=-25 pan=-14 echo=0.2 tune=-61
kit         ch10    "kit-manager:Breaker Box Kit"            lufs=-16.5 verb=0.06

