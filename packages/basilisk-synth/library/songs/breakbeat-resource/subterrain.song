# Subterrain: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Subterrain
pack     = breakbeat-resource
kind     = chiptune
composer = congusbongus
source   = subterrain, a FastTracker 2 module (subterrain.xm) from OpenGameArt (https://opengameart.org/sites/default/files/subterrain.xm_.zip). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/subterrain
arranger = Algorithmic Industries house band
source_sha256= 241c6c57aced4a669c98a0252831480694fabc93c1ccb4ae7f5796b15d622b16
note     = Drum and bass at 160 bpm: the module's Novation bass on the reese, its Korg synth on the square lead, its power chords on horns and a chord stab, its pad on the night-bus pad, its effects on a descent and the zap gun, its drums on Kit Manager 98 (Breaker Box Kit).
midi     = subterrain.mid
script   = subterrain.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
reese       ch2     "Neuro Growl"                            lufs=-19 width=1.2
kit         ch10    "kit-manager:Breaker Box Kit"            lufs=-16.5 verb=0.06
lead        ch1     "Freestyle Square"                       lufs=-21 pan=6 echo=0.2 verb=0.2
pad         ch3     "Night Bus Pad"                          lufs=-25 verb=0.4 width=1.3
horns       ch4     "Winter Horns"                           lufs=-23 pan=-14 verb=0.2
chord       ch5     "Hazy Chord"                             lufs=-24 pan=14 verb=0.2
sweep       ch6     "Elevated Descent"                       lufs=-27 verb=0.4
zap         ch7     "Zap Gun"                                lufs=-27 pan=25 echo=0.3
signal      ch8     "Silver Signal"                          lufs=-22 pan=-6 echo=0.2 verb=0.2 tune=82

