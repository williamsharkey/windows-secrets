# March of the Dwarfs: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = March of the Dwarfs
pack     = breakbeat-resource
kind     = world
composer = Edvard Grieg (1843-1907)
source   = Troldtog (March of the Dwarfs), Lyric Pieces Op. 54 No. 3 (1891): the first and second sections and the opening again. Score: The Mutopia Project, from C. F. Peters (c. 1891).
licence  = The work: public domain (published 1891; the composer died 1907). The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=2014
arranger = Algorithmic Industries house band
note     = Jungle at 170 bpm: the march on a square lead with orchestra hits on its accents, sub and reese on the left hand, chopped breaks, the block-party siren, a half-time breakdown on the night-bus pad, tines and voices. Breaks: Kit Manager 98 (Breaker Box Kit) with the pack's Office Snare and Plaza Shaker.
midi     = march-of-the-dwarfs.mid
script   = march-of-the-dwarfs.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/8
feedback = 0.35
tone     = 3000
level    = -4

[reverb]
size     = 2.0
predelay = 15
tone     = 5000
level    = -6

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Breaker Box Kit"            lufs=-16.5 verb=0.06
lead        ch1     "Freestyle Square"                       lufs=-20 pan=6 echo=0.2 verb=0.2
hit         ch2     "Breaker Orchestra Hit"                  lufs=-22 pan=-8 verb=0.3
reese       ch3     "Neuro Growl"                            lufs=-23 width=1.3
sub         ch4     "Sound System Sub"                       lufs=-19
pad         ch5     "Night Bus Pad"                          lufs=-25 verb=0.4 width=1.3
tine        ch6     "Liquid Tine"                            lufs=-23 pan=-20 echo=0.2 verb=0.3
siren       ch7     "Block Party Siren"                      lufs=-24 echo=0.35 verb=0.3
snare       ch8     "Office Snare"                           lufs=-27 pan=6
shaker      ch9     "Plaza Shaker"                           lufs=-30 pan=-30
voices      ch11    "Tidal Voices"                           lufs=-26 pan=-10 verb=0.5
zap         ch12    "Zap Gun"                                lufs=-26 pan=25 echo=0.4

