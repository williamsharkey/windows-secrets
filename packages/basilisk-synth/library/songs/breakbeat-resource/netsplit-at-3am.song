# Netsplit at 3AM: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Netsplit at 3AM
pack     = breakbeat-resource
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE1993)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Jungle in D minor, 170 bpm: night-bus pad, tine chords, chopped breaks, the block-party siren, orchestra hits, sub and reese, a whistle tune in the half-time break. Breaks: Kit Manager 98 (Breaker Box Kit) layered with the pack's Office Snare and Plaza Shaker.
midi     = netsplit-at-3am.mid
script   = netsplit-at-3am.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/8
feedback = 0.4
tone     = 3000
level    = -3

[reverb]
size     = 2.2
predelay = 15
tone     = 5000
level    = -6

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Breaker Box Kit"            lufs=-16.5 verb=0.06
sub         ch2     "Sound System Sub"                       lufs=-19
reese       ch3     "Neuro Growl"                            lufs=-22 pan=0 width=1.3
pad         ch4     "Night Bus Pad"                          lufs=-25 verb=0.4 width=1.3
tine        ch5     "Liquid Tine"                            lufs=-23 pan=-20 echo=0.2 verb=0.3
hit         ch6     "Breaker Orchestra Hit"                  lufs=-21 pan=8 verb=0.3
whistle     ch7     "Upper Whistle"                          lufs=-21 pan=12 echo=0.3 verb=0.35
voices      ch8     "Tidal Voices"                           lufs=-26 pan=-10 verb=0.5
siren       ch9     "Block Party Siren"                      lufs=-24 echo=0.35 verb=0.3
snare       ch11    "Office Snare"                           lufs=-27 pan=6
shaker      ch12    "Plaza Shaker"                           lufs=-30 pan=-30
zap         ch13    "Zap Gun"                                lufs=-26 pan=25 echo=0.4

