# Mailing List Riot: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Mailing List Riot
pack     = breakbeat-resource
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE1993)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Big beat in E minor, 124 bpm: a fat break with the pack's snare and clap on top, a growling bass riff, the stadium riff stab, orchestra hits, the block-party siren, a robot voice, a rising synth, a keys breakdown. Drums: Kit Manager 98 (Breaker Box Kit).
midi     = mailing-list-riot.mid
script   = mailing-list-riot.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.35
tone     = 3000
level    = -5

[reverb]
size     = 1.8
predelay = 15
tone     = 5000
level    = -6

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Breaker Box Kit"            lufs=-16 verb=0.08
bass        ch1     "Night End"                              lufs=-19
riff        ch2     "Stadium Riff Stab"                      lufs=-20 pan=-8 verb=0.2
hit         ch3     "Breaker Orchestra Hit"                  lufs=-21 verb=0.3
siren       ch4     "Block Party Siren"                      lufs=-23 echo=0.35 verb=0.3
robot       ch5     "Robot Workgroup Voice"                  lufs=-21 pan=10 echo=0.2 verb=0.3
keys        ch6     "Night Upright"                          lufs=-22 pan=-16 verb=0.3
lead        ch7     "Steady Ray"                             lufs=-22 pan=14 echo=0.25 verb=0.3 tune=-61
snare       ch8     "Office Snare"                           lufs=-26 pan=6
clap        ch9     "Inland Clap"                            lufs=-27 pan=-6 verb=0.2
fx          ch11    "Mint Uplink"                            lufs=-26 verb=0.4
pad         ch12    "Cathode Bloom"                          lufs=-26 verb=0.4 width=1.3 tune=-89

