# Gymnopedie No. 1: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Gymnopedie No. 1
pack     = screen-saver
kind     = world
composer = Erik Satie (1866-1925)
source   = Gymnopedie No. 1 for piano (1888). Score: The Mutopia Project, typeset from the Dover edition.
licence  = The work: public domain (published 1888; the composer died 1925). The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=37
arranger = Algorithmic Industries house band
note     = The whole piece at 66 bpm: breathy flute melody, glass-harp chords, singing-bowl bass, marimba, chimes, string pad in the middle phrase, the sea and a hermit thrush.
tail     = 6
midi     = gymnopedie-no-1.mid
script   = gymnopedie-no-1.py

[master]
loudness = -17
ceiling  = -1.0
fadeout  = 3

[echo]
time     = 3/8
feedback = 0.35
tone     = 3000
level    = -5

[reverb]
size     = 3.6
predelay = 30
tone     = 5000
level    = -3

[tracks]
# name      source  preset                                  mix
flute       ch1     "Breath Flute"                           lufs=-20 pan=4 echo=0.15 verb=0.45
glass       ch2     "Ivory Canopy"                           lufs=-24 pan=-14 verb=0.4
bassbowl    ch3     "Northern Dormant"                       lufs=-24 verb=0.3 tune=13
marimba     ch4     "Water Marimba"                          lufs=-27 pan=-26 echo=0.25 verb=0.35
chimes      ch5     "Sunday Chimes"                          lufs=-27 pan=28 echo=0.3 verb=0.5 tune=76
waves       ch6     "Ocean Shelf"                            lufs=-31 width=1.4
strings     ch7     "Lunar Canopy"                           lufs=-27 pan=12 verb=0.45 width=1.3
bird        ch8     "Thrush Morning"                         lufs=-29 pan=38 verb=0.4

[dna]
