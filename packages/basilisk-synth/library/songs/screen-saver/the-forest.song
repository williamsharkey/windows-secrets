# The Forest: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = The Forest
pack     = screen-saver
kind     = chiptune
composer = Wolfgang_
source   = The Forest, a FamiTracker module (TheForest.ftm) from OpenGameArt (https://opengameart.org/sites/default/files/TheForest.zip). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/8-bit-forest-theme
arranger = Algorithmic Industries house band
source_sha256= 7db40d51ccd13b769a2a4da4b4f0b0d2786b749d204155302c7bf7eba5c4c07e
note     = Played twice through: the NES module's pulse 1 on the breathy flute, pulse 2 on the marimba, the triangle on the horn pad, the noise on a wind chime.
midi     = the-forest.mid
script   = the-forest.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
flute       ch1     "Breath Flute"                           lufs=-20 pan=4 echo=0.2 verb=0.45
marimba     ch2     "Water Marimba"                          lufs=-22 pan=-16 echo=0.25 verb=0.35
bass        ch3     "Cathode Halo"                           lufs=-24 verb=0.3
chime       ch4     "Frosted Peal"                           lufs=-30 pan=28 verb=0.4 tune=45

[dna]
# the presets' DNA when this song was written (used before the pack discs' own)
"screen-saver:Breath Flute" = flute_vib_c5#12/recycle>>@8]#4FL30;A40R400K72G2
"screen-saver:Cathode Halo" = horn_sus_c3@t7500]@t300[#8U3~11/dingxpR#3T-19L33O181Q-13/spirit_breathE#3FL26Ja0,100.124,30.672,0/wind_chime_single@t2000]R#2T1L39O365Q-44;A618D617S73R1993V98K48G-10
"screen-saver:Frosted Peal" = wind_chime_single@t3000]E#13H0,12U2~3/xpstart#3FL40;A0D744S26R606V89K71G-6
"screen-saver:Water Marimba" = marimba_c4#10/drop_single_a#6FL40;A0R900K60G1
