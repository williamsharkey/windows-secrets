# Between Meetings: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Between Meetings
pack     = screen-saver
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Ambient in D major, 72 bpm: ocean waves, a singing-bowl drone, string pad, pipe-organ pad, marimba ostinato, glockenspiel, a breathy flute tune, a creek and a hermit thrush.
midi     = between-meetings.mid
script   = between-meetings.py

[master]
loudness = -17
ceiling  = -1.0

[echo]
time     = 3/8
feedback = 0.45
tone     = 3000
level    = -4

[reverb]
size     = 4.0
predelay = 30
tone     = 5000
level    = -3

[tracks]
# name      source  preset                                  mix
waves       ch1     "Ocean Shelf"                            lufs=-28 width=1.4
drone       ch2     "Northern Dormant"                       lufs=-27 verb=0.3 tune=13
pad         ch3     "Global Pad"                             lufs=-24 verb=0.45 width=1.4
organ       ch4     "Opal Bloom"                             lufs=-27 pan=-15 verb=0.4
marimba     ch5     "Water Marimba"                          lufs=-22 pan=-12 echo=0.3 verb=0.35
glock       ch6     "Sunday Chimes"                          lufs=-24 pan=24 echo=0.35 verb=0.45 tune=76
flute       ch7     "Breath Flute"                           lufs=-20 pan=6 echo=0.2 verb=0.45
bird        ch8     "Thrush Morning"                         lufs=-27 pan=38 verb=0.35
bell        ch9     "Felt Ring"                              lufs=-26 pan=-30 echo=0.4 verb=0.5
creek       ch11    "Creek Bed"                              lufs=-31 pan=-20 width=1.3

[dna]
