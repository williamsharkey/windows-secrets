# Kiosk at Dawn: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Kiosk at Dawn
pack     = screen-saver
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE1993)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Ambient in F Lydian, 64 bpm: crickets, a creek, a hermit thrush, singing bowls, the pipe-organ pad, a horizon horn's long call, glockenspiel, a corner peal, a string pad and choir, then the shopping-centre ambience as the doors open.
tail     = 6
midi     = kiosk-at-dawn.mid
script   = kiosk-at-dawn.py

[master]
loudness = -17
ceiling  = -1.0
fadeout  = 3

[echo]
time     = 3/8
feedback = 0.45
tone     = 3000
level    = -4

[reverb]
size     = 4.0
predelay = 30
tone     = 5000
level    = -3

[tracks]
# name      source  preset                                  mix
crickets    ch1     "Noble Static"                           lufs=-30 width=1.4
creek       ch2     "Creek Bed"                              lufs=-30 pan=-20 width=1.3
bird        ch3     "Thrush Morning"                         lufs=-27 pan=36 verb=0.4
bowl        ch4     "Granite Dormant"                        lufs=-27 verb=0.4 tune=22
organ       ch5     "Opal Bloom"                             lufs=-25 pan=-10 verb=0.45
horn        ch6     "Distant Horizon Horn"                   lufs=-20 pan=6 echo=0.2 verb=0.5
glock       ch7     "Sunday Chimes"                          lufs=-25 pan=26 echo=0.35 verb=0.5 tune=76
peal        ch8     "Corner Peal"                            lufs=-27 pan=-28 echo=0.3 verb=0.5
pad         ch9     "Vinyl Aurora"                           lufs=-26 verb=0.45 width=1.4
mall        ch11    "Daylight Traffic"                       lufs=-30 width=1.4
choir       ch12    "Sunlit Drift"                           lufs=-27 verb=0.5 width=1.3

