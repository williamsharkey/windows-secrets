# Napping on a Cloud: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Napping on a Cloud
pack     = screen-saver
kind     = chiptune
composer = congusbongus
source   = Napping on a cloud, a FastTracker 2 module (napping_on_a_cloud.xm) from OpenGameArt (https://opengameart.org/sites/default/files/napping_on_a_cloud.xm_.zip). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/napping-on-a-cloud
arranger = Algorithmic Industries house band
source_sha256= 5d0ff2a44bc0ff7c0eaad9a91da605f37f1d323e7af241b1521cc279dd3d1f9a
note     = Ambient at 81 bpm: the module's melody on the breathy flute, its dub chords on the glass harp, its bass on the horn pad, its buzz line on the marimba, its percussion on a gong and its hat on a wind chime.
midi     = napping-on-a-cloud.mid
script   = napping-on-a-cloud.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
flute       ch1     "Breath Flute"                           lufs=-20 pan=4 echo=0.2 verb=0.45
glass       ch2     "Ivory Canopy"                           lufs=-24 pan=-14 verb=0.4
bass        ch3     "Cathode Halo"                           lufs=-23 verb=0.2
marimba     ch4     "Water Marimba"                          lufs=-24 pan=24 echo=0.25 verb=0.35
gong        ch5     "Yellow Gong"                            lufs=-27 verb=0.4
chime       ch6     "Frosted Peal"                           lufs=-30 pan=30 verb=0.4 tune=45

[dna]
# the presets' DNA when this song was written (used before the pack discs' own)
