# Elite Syncopations: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Elite Syncopations
pack     = workgroup-house
kind     = world
composer = Scott Joplin (1868-1917)
source   = Elite Syncopations, a rag (1902): four-bar loops cut from its first, second and trio strains. Score: The Mutopia Project, from John Stark & Son (1902).
licence  = The work: public domain (published 1902; the composer died 1917). The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=1540
arranger = Algorithmic Industries house band
note     = Filtered house at 124 bpm: the rag's strains looped four bars at a time on the warehouse piano, the left hand on the slap disco bass, organ stabs, strings, a choir breakdown, dial-tone hats and a shaker. Drums: Kit Manager 98 (Jack Box Kit).
midi     = elite-syncopations.mid
script   = elite-syncopations.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.35
tone     = 3200
level    = -4

[reverb]
size     = 1.8
predelay = 16
tone     = 6000
level    = -5

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Jack Box Kit"               lufs=-17 verb=0.05
piano       ch1     "Warehouse Piano Stack"                  lufs=-19 pan=-6 echo=0.12 verb=0.2
inner       ch2     "Cable Upright"                          lufs=-24 pan=18 verb=0.2
bass        ch3     "Slap Disco Bass"                        lufs=-19 tune=-16
organ       ch4     "Jack Organ"                             lufs=-25 pan=20 verb=0.15
choir       ch5     "Plaza Cantor"                           lufs=-23 pan=-6 verb=0.45
strings     ch6     "Sampled Strings Swell"                  lufs=-25 pan=22 verb=0.35
fx          ch7     "Low-Pass Sweep Wash"                    lufs=-25 echo=0.3 verb=0.3
dialhat     ch8     "Dial Hat"                               lufs=-28 pan=30
shaker      ch9     "Bright Shaker"                          lufs=-30 pan=-34
pad         ch11    "Midnight Haze"                          lufs=-26 verb=0.35 width=1.3 tune=-11

