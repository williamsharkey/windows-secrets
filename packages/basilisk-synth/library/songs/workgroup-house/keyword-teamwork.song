# Keyword: Teamwork: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Keyword: Teamwork
pack     = workgroup-house
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = French-touch filter house in G minor, 124 bpm: an organ riff, a disco bass, strings, sixteenth plucks, the robot mouth's hook, a choir and tine-EP breakdown, a sweep, the modem in the outro. Drums: Kit Manager 98 (Jack Box Kit).
midi     = keyword-teamwork.mid
script   = keyword-teamwork.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.38
tone     = 3200
level    = -4

[reverb]
size     = 1.8
predelay = 16
tone     = 6000
level    = -5

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Jack Box Kit"               lufs=-17 verb=0.05
organ       ch1     "Humid Organ"                            lufs=-20 pan=-8 echo=0.15 verb=0.15
bass        ch2     "Round Floor Sub"                        lufs=-19 tune=-83
strings     ch3     "Cathode Strings"                        lufs=-25 pan=20 verb=0.35
robot       ch4     "Robot Mouth Lead"                       lufs=-20 pan=6 echo=0.25 verb=0.2
choir       ch5     "Felt Field"                             lufs=-25 verb=0.45 width=1.3
keys        ch6     "Coral Ballad"                           lufs=-23 pan=-20 echo=0.15 verb=0.25
fx          ch7     "Low-Pass Sweep Wash"                    lufs=-25 echo=0.3 verb=0.3
modem       ch8     "Polar Ascent"                           lufs=-25 echo=0.3 verb=0.3
dialhat     ch9     "Dial Hat"                               lufs=-28 pan=30
pluck       ch11    "Steel Flick"                            lufs=-25 pan=26 echo=0.25

