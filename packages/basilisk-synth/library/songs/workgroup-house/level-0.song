# Level 0: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Level 0
pack     = workgroup-house
kind     = chiptune
composer = controllerhead
source   = Level 0, a FamiTracker module (nrom_level0.ftm) from OpenGameArt (https://opengameart.org/sites/default/files/nrom_level0_famitracker.zip). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/nes-level-0
arranger = Algorithmic Industries house band
source_sha256= 1d2b56cdf317107b38ba7b9d8083741c39e4e2199e5a1ecb0d106d0c9e7b36a8
note     = Played twice through as house: the NES module's pulse 1 on an organ, pulse 2 on a stab, the triangle on the bass, the noise on Kit Manager 98 (Jack Box Kit).
midi     = level-0.mid
script   = level-0.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
organ       ch1     "Gentle Revival"                         lufs=-21 pan=-8 echo=0.15
stab        ch2     "Rainy Accent"                           lufs=-22 pan=14 echo=0.2
bass        ch3     "Remote Foundation"                      lufs=-19 tune=-57
kit         ch10    "kit-manager:Jack Box Kit"               lufs=-17 verb=0.05

[dna]
