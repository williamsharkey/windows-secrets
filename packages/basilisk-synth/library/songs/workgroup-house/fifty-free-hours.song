# Fifty Free Hours: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Fifty Free Hours
pack     = workgroup-house
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE1993)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Deep house in F minor, 122 bpm. The modem dials up, a one-finger minor-ninth stab, organ bass stab, talking-robot hook, choir breakdown. Drums: Kit Manager 98 (Jack Box Kit).
midi     = fifty-free-hours.mid
script   = fifty-free-hours.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.38
tone     = 3200
level    = -3

[reverb]
size     = 1.8
predelay = 16
tone     = 6000
level    = -5

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Jack Box Kit"               lufs=-17 pan=0 verb=0.05
bass        ch2     "Slap Disco Bass"                        lufs=-19 pan=0 tune=-16
stab        ch3     "Velvet Minor Nine"                      lufs=-21 pan=-12 echo=0.18 verb=0.18
organ       ch4     "Jack Organ"                             lufs=-24 pan=18 verb=0.15
keys        ch5     "Afterhours Tine"                        lufs=-24 pan=-25 echo=0.15 verb=0.25
pad         ch6     "Midnight Haze"                          lufs=-25 pan=0 verb=0.35 width=1.3 tune=-11
lead        ch7     "Robot Mouth Lead"                       lufs=-20 pan=6 echo=0.25 verb=0.2
choir       ch8     "Plaza Cantor"                           lufs=-23 pan=-6 verb=0.45
modem       ch9     "Polar Ascent"                           lufs=-24 pan=0 echo=0.3 verb=0.3
dialhat     ch11    "Dial Hat"                               lufs=-27 pan=30
shaker      ch12    "Bright Shaker"                          lufs=-29 pan=-34
strings     ch13    "Sampled Strings Swell"                  lufs=-25 pan=22 verb=0.35

