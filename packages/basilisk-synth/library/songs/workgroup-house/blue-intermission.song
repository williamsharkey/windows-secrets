# Blue Intermission: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Blue Intermission
pack     = workgroup-house
kind     = chiptune
composer = congusbongus
source   = Blue Intermission, a FastTracker 2 module (blue_intermission.xm) from OpenGameArt (https://opengameart.org/sites/default/files/blue_intermission.xm_.zip). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/blue-intermission
arranger = Algorithmic Industries house band
source_sha256= f28c417be6b073f49281e4c3ce1800dc6ef38d3f138cbb5cf1f99567975a009e
note     = Downtempo house at 87 bpm: the module's house bass on the slap disco bass, its Rhodes on the tine EP, its drums on Kit Manager 98 (Jack Box Kit), its shaker on the kit's closed hat.
midi     = blue-intermission.mid
script   = blue-intermission.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
bass        ch2     "Slap Disco Bass"                        lufs=-19 tune=-16
rhodes      ch3     "Afterhours Tine"                        lufs=-21 pan=-12 echo=0.18 verb=0.25
kit         ch10    "kit-manager:Jack Box Kit"               lufs=-17 verb=0.05

[dna]
