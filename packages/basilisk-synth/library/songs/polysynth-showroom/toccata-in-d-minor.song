# Toccata in D Minor: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Toccata in D Minor
pack     = polysynth-showroom
kind     = world
composer = Johann Sebastian Bach (1685-1750), attributed
source   = Toccata and Fugue in D minor, BWV 565: the toccata and the fugue's first fourteen bars. Score: The Mutopia Project, from the Bach-Gesellschaft Ausgabe (1867).
licence  = The work: public domain (18th century). The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=1780
arranger = Algorithmic Industries house band
note     = The toccata on poly brass and FM piano over a mono pedal bass with brass hits, string swells; the fugue's opening with a PWM lead, drums and the vocoder choir; the last D minor chord. Drums: Kit Manager 98 (Breaker Box Kit).
tail     = 5
midi     = toccata-in-d-minor.mid
script   = toccata-in-d-minor.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 3.2
predelay = 25
tone     = 5500
level    = -3

[tracks]
# name      source  preset                                  mix
brass       ch1     "Radiant Salute"                         lufs=-19 pan=-8 verb=0.35 width=1.2
fmpiano     ch2     "Stone Parlour"                          lufs=-24 pan=18 echo=0.1 verb=0.3
lefthand    ch3     "Lucid Herald"                           lufs=-22 pan=-18 verb=0.3
pedal       ch4     "Ivory Low"                              lufs=-20 verb=0.15
vchoir      ch5     "Static Chorus"                          lufs=-25 verb=0.5 width=1.3 tune=-12
vstrings    ch6     "Upper Ensemble"                         lufs=-25 pan=10 verb=0.45 width=1.3 tune=11
lead        ch7     "Silent Ray"                             lufs=-20 pan=4 echo=0.2 verb=0.3
kit         ch10    "kit-manager:Breaker Box Kit"            lufs=-18 verb=0.15
hit         ch11    "Lucid Herald"                           lufs=-24 verb=0.4

