# Fight for a Better Future: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Fight for a Better Future
pack     = polysynth-showroom
kind     = chiptune
composer = nene
source   = fight_for_better_future, a Standard MIDI File (fight_for_better_future.mid) from OpenGameArt (https://opengameart.org/sites/default/files/fight_for_better_future.mid). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/fight-for-better-future-rockmetal
arranger = Algorithmic Industries house band
source_sha256= 939a374f1f892f60bdf2cdf1380af32b7bda344a072a0865a7de4c0983862e43
note     = Played twice through as 1985 synth rock: the MIDI file's lead guitar on the buzzy lead, the rhythm guitars on poly brass, its synth on a PWM lead, strings on vocoder strings, its bass on the cream mono bass, its General MIDI drums on Kit Manager 98 (Breaker Box Kit).
midi     = fight-for-a-better-future.mid
script   = fight-for-a-better-future.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
lead        ch1     "Wired Call"                             lufs=-20 pan=4 echo=0.2
brass       ch2     "Azure Horns"                            lufs=-23 pan=-20 tune=14
brass2      ch3     "Lucid Herald"                           lufs=-24 pan=20
bass        ch4     "Ivory Low"                              lufs=-19
solo        ch5     "Molten Ray"                             lufs=-22 pan=-8 echo=0.2
strings     ch6     "Foggy Section"                          lufs=-25 verb=0.35
kit         ch10    "kit-manager:Breaker Box Kit"            lufs=-17 verb=0.15

