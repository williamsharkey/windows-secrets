# Demo Mode, Aisle 7: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Demo Mode, Aisle 7
pack     = polysynth-showroom
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = A 1985 power ballad in A-flat, 76 bpm: FM piano verses, the female vocoder on the verse, gasflower pads, big poly brass and a lead on the chorus, string swells, a buzzy solo, the last chorus up a tone. Drums: Kit Manager 98 (Breaker Box Kit).
midi     = demo-mode-aisle-seven.mid
script   = demo-mode-aisle-seven.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.32
tone     = 3200
level    = -5

[reverb]
size     = 2.8
predelay = 22
tone     = 5500
level    = -3

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Breaker Box Kit"            lufs=-17 verb=0.2
fmpiano     ch1     "Broadcast Etude"                        lufs=-21 pan=-14 verb=0.3
bass        ch2     "Waxed Basement"                         lufs=-20
pad         ch3     "Tinted Veil"                            lufs=-26 verb=0.4 width=1.3 tune=-18
vchoir      ch4     "Daylight Vowel"                         lufs=-20 pan=4 verb=0.4 tune=-11
brass       ch5     "Signal Stab"                            lufs=-22 pan=10 verb=0.3 width=1.2
lead        ch6     "Violet Pilot"                           lufs=-20 pan=-4 echo=0.2 verb=0.3
solo        ch7     "Yellow Solo"                            lufs=-20 pan=6 echo=0.25 verb=0.3
strings     ch8     "Arctic Chamber"                         lufs=-25 pan=-16 verb=0.4 width=1.3 tune=16
bells       ch9     "Zinc Felt"                              lufs=-26 pan=28 echo=0.3 verb=0.4

