# Saturday on the Keyboard Floor: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Saturday on the Keyboard Floor
pack     = polysynth-showroom
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = 1985 synth-pop in D minor, 120 bpm: poly brass stabs, a cream mono bass in eighths, FM piano and clav, a PWM lead, vocoder strings, male and female vocoder choirs, a buzzy solo, FM EP arpeggios. Drums: Kit Manager 98 (Breaker Box Kit).
midi     = saturday-on-the-keyboard-floor.mid
script   = saturday-on-the-keyboard-floor.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.35
tone     = 3500
level    = -4

[reverb]
size     = 2.2
predelay = 18
tone     = 6000
level    = -5

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Breaker Box Kit"            lufs=-17 verb=0.12
bass        ch2     "Broadcast Cellar"                       lufs=-19
brass       ch3     "Copper Salute"                          lufs=-20 pan=-8 verb=0.2 width=1.2
fmpiano     ch4     "Empty Hammers"                          lufs=-23 pan=-20 verb=0.25
clav        ch5     "Distant Parlour"                        lufs=-25 pan=26 tune=-22
lead        ch6     "Grey Beam"                              lufs=-19 pan=6 echo=0.2 verb=0.25
solo        ch7     "Amber Line"                             lufs=-20 pan=-4 echo=0.25 verb=0.25
vstrings    ch8     "Hollow Swell"                           lufs=-24 pan=14 verb=0.35 width=1.3 tune=-14
vchoir      ch9     "Marble Chorus"                          lufs=-25 pan=-12 verb=0.4 tune=-14
pad         ch11    "Wide Field"                             lufs=-26 verb=0.35 width=1.3
ep          ch12    "Broadcast Etude"                        lufs=-25 pan=30 echo=0.3 verb=0.2
female      ch13    "Broadcast Vox"                          lufs=-23 pan=8 verb=0.4 tune=-11

