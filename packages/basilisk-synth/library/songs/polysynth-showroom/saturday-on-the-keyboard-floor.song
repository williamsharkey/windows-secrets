# Saturday on the Keyboard Floor: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Saturday on the Keyboard Floor
pack     = polysynth-showroom
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE1993)
licence  = CC0-1.0 (the composition and this arrangement)
note     = 1985 synth-pop in D minor, 120 bpm: poly brass stabs, a cream mono bass in eighths, FM piano and clav, a PWM lead, vocoder strings, male and female vocoder choirs, a buzzy solo, FM EP arpeggios. Drums: Kit Manager 98 (Breaker Box Kit).
midi     = saturday-on-the-keyboard-floor.mid
script   = saturday-on-the-keyboard-floor.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.35
tone     = 3500
level    = -4

[reverb]
size     = 2.2
predelay = 18
tone     = 6000
level    = -5

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Breaker Box Kit"            lufs=-17 verb=0.12
bass        ch2     "Ivory Low"                              lufs=-19
brass       ch3     "Orbital Accent"                         lufs=-20 pan=-8 verb=0.2 width=1.2
fmpiano     ch4     "Stone Parlour"                          lufs=-23 pan=-20 verb=0.25
clav        ch5     "Paper Recital"                          lufs=-25 pan=26
lead        ch6     "Silent Ray"                             lufs=-19 pan=6 echo=0.2 verb=0.25
solo        ch7     "Wired Call"                             lufs=-20 pan=-4 echo=0.25 verb=0.25
vstrings    ch8     "Foggy Section"                          lufs=-24 pan=14 verb=0.35 width=1.3
vchoir      ch9     "Static Chorus"                          lufs=-25 pan=-12 verb=0.4 tune=-12
pad         ch11    "Plaza Field"                            lufs=-26 verb=0.35 width=1.3
ep          ch12    "Mild Chords"                            lufs=-25 pan=30 echo=0.3 verb=0.2
female      ch13    "Rose Breath"                            lufs=-23 pan=8 verb=0.4 tune=-11

