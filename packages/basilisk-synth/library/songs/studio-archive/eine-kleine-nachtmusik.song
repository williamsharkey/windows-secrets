# Eine kleine Nachtmusik: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Eine kleine Nachtmusik
pack     = studio-archive
kind     = world
composer = Wolfgang Amadeus Mozart (1756-1791)
source   = Serenade No. 13 in G, K. 525, "Eine kleine Nachtmusik", first movement (1787): the exposition and the last ten bars. Score: The Mutopia Project.
licence  = The work: public domain (18th century). The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=900
arranger = Algorithmic Industries house band
note     = The exposition on the studio's first and second violins, violas, cellos and a bass; the piano and the horns join for the second theme, glockenspiel and trumpet top the opening; then the last bars for everyone, with a tap for timpani.
midi     = eine-kleine-nachtmusik.mid
script   = eine-kleine-nachtmusik.py

[master]
loudness = -16
ceiling  = -1.0

[echo]
time     = 1/4
feedback = 0.2
tone     = 3000
level    = -12

[reverb]
size     = 2.4
predelay = 22
tone     = 5500
level    = -4

[tracks]
# name      source  preset                                  mix
violins1    ch1     "Humid Swell"                            lufs=-20 pan=-28 verb=0.35
violins2    ch2     "Daylight Bows"                          lufs=-23 pan=-10 verb=0.35
violas      ch3     "Static Swell"                           lufs=-24 pan=10 verb=0.35
cellos      ch4     "Crystal Legato"                         lufs=-22 pan=26 verb=0.3
bass        ch5     "Signal Bass"                            lufs=-25 pan=20 verb=0.2
horns       ch6     "Opal Fanfare"                           lufs=-24 pan=14 verb=0.4
piano       ch7     "Mild Ivories"                           lufs=-24 pan=-18 verb=0.3
glock       ch8     "Basement Chimes"                        lufs=-25 pan=30 verb=0.4
trumpet     ch9     "White Stab"                             lufs=-24 pan=-4 verb=0.4
timp        ch11    "Clear Snap"                             lufs=-28 verb=0.4

