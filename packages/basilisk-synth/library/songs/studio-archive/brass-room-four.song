# Brass Room Four: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Brass Room Four
pack     = studio-archive
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE1993)
licence  = CC0-1.0 (the composition and this arrangement)
note     = A concert march in B-flat, 112 bpm: a trumpet and horn fanfare, the march on horns and trumpet over trombone off-beats and a marimba bass, a trio for glockenspiel and keys with cellos, the strings on the last strain, snaps and taps for the drum line.
midi     = brass-room-four.mid
script   = brass-room-four.py

[master]
loudness = -16
ceiling  = -1.0

[echo]
time     = 1/4
feedback = 0.2
tone     = 3000
level    = -12

[reverb]
size     = 2.4
predelay = 22
tone     = 5500
level    = -4

[tracks]
# name      source  preset                                  mix
trumpet     ch1     "White Stab"                             lufs=-20 pan=-6 verb=0.35
horns       ch2     "Swift Fanfare"                          lufs=-21 pan=12 verb=0.4
trombones   ch3     "Upper Horns"                            lufs=-24 pan=24 verb=0.3
bass        ch4     "Signal Bass"                            lufs=-22 verb=0.2
bells       ch5     "Basement Chimes"                        lufs=-23 pan=30 echo=0.15 verb=0.4
keys        ch6     "Harbor Study"                           lufs=-23 pan=-20 verb=0.3
strings     ch7     "Humid Swell"                            lufs=-21 pan=-24 verb=0.4
cellos      ch8     "Crystal Legato"                         lufs=-25 pan=20 verb=0.35
snap        ch9     "Clear Snap"                             lufs=-28 pan=8 verb=0.3
tap         ch11    "Warm Tap"                               lufs=-27 pan=-10
piano       ch12    "Velvet Etude"                           lufs=-25 pan=-14 verb=0.3

