# A Visit to the Instrument Room: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = A Visit to the Instrument Room
pack     = studio-archive
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = A light-orchestral tour in F major, 104 bpm: one tune passed from the upright piano to the violins and cellos, the horns, trombones and trumpet, the glockenspiel and vibes, then everyone together.
midi     = a-visit-to-the-instrument-room.mid
script   = a-visit-to-the-instrument-room.py

[master]
loudness = -16
ceiling  = -1.0

[echo]
time     = 1/4
feedback = 0.25
tone     = 3000
level    = -8

[reverb]
size     = 2.4
predelay = 22
tone     = 5500
level    = -4

[tracks]
# name      source  preset                                  mix
piano       ch1     "Mild Ivories"                           lufs=-21 pan=-16 verb=0.3
bass        ch2     "Signal Bass"                            lufs=-22 verb=0.15
violins     ch3     "Humid Swell"                            lufs=-21 pan=-24 verb=0.4
cello       ch4     "Crystal Legato"                         lufs=-24 pan=22 verb=0.35
horns       ch5     "Opal Fanfare"                           lufs=-21 pan=12 verb=0.35
trombone    ch6     "Upper Horns"                            lufs=-25 pan=26 verb=0.3
trumpet     ch7     "White Stab"                             lufs=-22 pan=-4 verb=0.35
glock       ch8     "Basement Chimes"                        lufs=-23 pan=30 echo=0.15 verb=0.4
vibes       ch9     "Frosted Salon"                          lufs=-25 pan=-30 verb=0.35
block       ch11    "Warm Tap"                               lufs=-30 pan=-36
snap        ch12    "Clear Snap"                             lufs=-28 pan=8 verb=0.3
organ       ch13    "Wired Felt"                             lufs=-28 verb=0.35

[dna]
# the presets' DNA when this song was written (used before the pack discs' own)
