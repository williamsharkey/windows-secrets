"diagnostics:Copper Veil" = cello_section_sus_c3@t7500]@t300[>U2~18Q20;A755D624S85R1066V73K60G-11
"diagnostics:Digital Veil" = error<<EU2~10Ja0,0.365,100.1446,61Yd10l20q24;A500S90R2000K63G1
"diagnostics:Hollow Song" = erhu_d3@t4000]>U2~8Q-51;A1D245S89R282V75K62G-7
"diagnostics:Noble Bell" = ems_fm_register_bell_c6H0,12;A0D1038S10R1301V71K84G-9
