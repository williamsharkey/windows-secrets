# Fault Tolerance in Seven: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Fault Tolerance in Seven
pack     = diagnostics
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = An IDM study in 7/8 (2+2+3), 120 bpm, A minor: broken music box, a beat of critical-stop thuds, stamp snares, stamp ticks and floppy seeks, stutters, shattered glass, an erhu line, cello and error pads, a choir.
midi     = fault-tolerance-in-seven.mid
script   = fault-tolerance-in-seven.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.35
tone     = 3000
level    = -4

[reverb]
size     = 2.2
predelay = 18
tone     = 5500
level    = -5

[tracks]
# name      source  preset                                  mix
musicbox    ch1     "Broken Music Box"                       lufs=-20 pan=-10 echo=0.25 verb=0.3
bells       ch2     "Noble Bell"                             lufs=-24 pan=20 echo=0.3 verb=0.4
thud        ch3     "Echo Click"                             lufs=-19
snare       ch4     "Electric Snare"                         lufs=-22 pan=4 verb=0.15
tick        ch5     "Lunar Tick"                             lufs=-28 pan=28
seek        ch6     "Floppy Seek Perc"                       lufs=-24 pan=-28 echo=0.2
pad         ch7     "Copper Veil"                            lufs=-25 verb=0.35 width=1.3
errorpad    ch8     "Digital Veil"                           lufs=-28 verb=0.4 width=1.4
erhu        ch9     "Hollow Song"                            lufs=-20 pan=10 echo=0.15 verb=0.35
choir       ch11    "Inland Cantor"                          lufs=-25 verb=0.5
stutter     ch12    "Stutter Copy Paste"                     lufs=-26 pan=-20 echo=0.3
glass       ch13    "Shatter Transition"                     lufs=-24 verb=0.5
block       ch14    "Laser Block"                            lufs=-29 pan=36

