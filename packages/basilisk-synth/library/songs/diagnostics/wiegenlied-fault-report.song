# Wiegenlied (Fault Report): a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Wiegenlied (Fault Report)
pack     = diagnostics
kind     = world
composer = Johannes Brahms (1833-1897)
source   = Wiegenlied, Op. 49 No. 4 (1868). Score: The Mutopia Project, "Cancion de Cuna" for recorder and guitar.
licence  = The work: public domain (published 1868; the composer died 1897). The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=481
arranger = Algorithmic Industries house band
note     = The lullaby three times on a broken music box: over an error pad; over a beat of critical-stop thuds, stamps and floppy seeks with an erhu counter-line; with the choir and stutters. Then it winds down.
tail     = 5
midi     = wiegenlied-fault-report.mid
script   = wiegenlied-fault-report.py

[master]
loudness = -16
ceiling  = -1.0

[echo]
time     = 1/4
feedback = 0.35
tone     = 3000
level    = -4

[reverb]
size     = 2.6
predelay = 20
tone     = 5000
level    = -4

[tracks]
# name      source  preset                                  mix
musicbox    ch1     "Broken Music Box"                       lufs=-19 pan=-8 echo=0.25 verb=0.35
errorpad    ch2     "Digital Veil"                           lufs=-26 verb=0.4 width=1.4
cello       ch3     "Copper Veil"                            lufs=-24 pan=10 verb=0.3
erhu        ch4     "Hollow Song"                            lufs=-22 pan=14 echo=0.15 verb=0.35
choir       ch5     "Inland Cantor"                          lufs=-24 verb=0.5
bells       ch6     "Noble Bell"                             lufs=-24 pan=20 verb=0.5
thud        ch7     "Echo Click"                             lufs=-21
snare       ch8     "Electric Snare"                         lufs=-24 verb=0.2
tick        ch9     "Lunar Tick"                             lufs=-29 pan=26
seek        ch11    "Floppy Seek Perc"                       lufs=-25 pan=-26 echo=0.2
stutter     ch12    "Stutter Copy Paste"                     lufs=-27 pan=-20 echo=0.3
glass       ch13    "Shatter Transition"                     lufs=-25 verb=0.5

