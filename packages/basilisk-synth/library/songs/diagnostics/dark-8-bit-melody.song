# Dark 8-Bit Melody: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Dark 8-Bit Melody
pack     = diagnostics
kind     = chiptune
composer = qubodup
source   = Dark 8-Bit Melody, a FastTracker 2 module (8bitMelody.xm) from OpenGameArt (https://opengameart.org/sites/default/files/dark_8_bit_melody_sources.zip). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/dark-8bit-song
arranger = Algorithmic Industries house band
source_sha256= 52ee4abbded7d457abed7bbe1c9c7ee2981ac88b6cad0d1b300e6471908ee636
note     = Played twice through: the module's pianos on the broken music box and the erhu, its overdrive on stutters, its noises on critical-stop thuds.
midi     = dark-8-bit-melody.mid
script   = dark-8-bit-melody.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
musicbox    ch1     "Broken Music Box"                       lufs=-20 pan=-8 echo=0.25 verb=0.35
erhu        ch2     "Hollow Song"                            lufs=-21 pan=12 verb=0.35
stutter     ch3     "Stutter Copy Paste"                     lufs=-25 pan=18 echo=0.3
thud        ch4     "Echo Click"                             lufs=-21

[dna]
# the presets' DNA when this song was written (used before the pack discs' own)
"diagnostics:Broken Music Box" = music_box_note><E#10;A0D3000S0R1500K78G-4
"diagnostics:Echo Click" = critstop@t400]@t40[<#8/xprecycle#8L21Ja0,100.46,30.526,0;D108S0R48V95K24G5
"diagnostics:Hollow Song" = erhu_d3@t4000]>U2~8Q-51;A1D245S89R282V75K74G-7
"diagnostics:Stutter Copy Paste" = tadaxp@30[@4]@0CP@0CP@0CP@0CP@0CP#10;A0R60K60G15
