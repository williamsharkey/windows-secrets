# The Holly and the Ivy: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = The Holly and the Ivy
pack     = waulophone
credit   = Sounds by Paul Chauncy (Uncle Homunculus / Paulywauly)
kind     = world
composer = English traditional
source   = The Holly and the Ivy, English traditional carol. Score: The Mutopia Project.
licence  = The work: traditional, public domain. The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=644
arranger = Algorithmic Industries house band
note     = A Paulywaulyton singalong, five verses: the big-ears hum, the sax, the bee-buzzing organ and the chorus take the tune in turn, Barry on the bass, the doo-doo choir. Sounds by Paul Chauncy.
midi     = the-holly-and-the-ivy.mid
script   = the-holly-and-the-ivy.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3200
level    = -6

[reverb]
size     = 2.4
predelay = 20
tone     = 5500
level    = -5

[tracks]
# name      source  preset                                  mix
hum         ch1     "Hmm Held"                               lufs=-19 pan=4 verb=0.3
sax         ch2     "Crooner Sax"                            lufs=-20 pan=-20 echo=0.1 verb=0.3
organ       ch3     "Bee Organ Lead"                         lufs=-21 pan=20 verb=0.2 tune=-21
chorus      ch4     "Homunculus Choir"                       lufs=-21 pan=10 verb=0.4
bass        ch5     "Barry Sings Low"                        lufs=-20
doo         ch6     "Doo Choir"                              lufs=-25 verb=0.35 width=1.3
kit         ch10    "Honey Pine Kit"                         lufs=-21 verb=0.08

