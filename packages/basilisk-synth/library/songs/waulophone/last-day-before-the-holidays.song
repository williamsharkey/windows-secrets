# Last Day Before the Holidays: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Last Day Before the Holidays
pack     = waulophone
credit   = Sounds by Paul Chauncy (Uncle Homunculus / Paulywauly)
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE1993)
licence  = CC0-1.0 (the composition and this arrangement); sounds by Paul Chauncy
note     = An office singalong waltz in F, 3/4: the piano and the bass from Accounts, the hum from the back row, a doo-doo choir, glockenspiel answers, the sax and the bee-buzzing organ on the middle eight, everyone on the last chorus, a tuning fork at each end. Drums: the pack's Honey Pine Kit.
midi     = last-day-before-the-holidays.mid
script   = last-day-before-the-holidays.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 1/4
feedback = 0.25
tone     = 3000
level    = -8

[reverb]
size     = 1.8
predelay = 18
tone     = 5500
level    = -5

[tracks]
# name      source  preset                                  mix
piano       ch1     "Front Room Upright"                     lufs=-21 pan=-12 verb=0.25
bass        ch2     "Boop Bass"                              lufs=-21
hum         ch3     "Hmm Held"                               lufs=-19 pan=4 verb=0.3
doo         ch4     "Doo Choir"                              lufs=-25 pan=-6 verb=0.35 width=1.3
glock       ch5     "Glock Bird"                             lufs=-24 pan=28 echo=0.2 verb=0.35
sax         ch6     "Crooner Sax"                            lufs=-21 pan=-20 echo=0.1 verb=0.3
organ       ch7     "Bee Organ Lead"                         lufs=-25 pan=20 verb=0.2 tune=-21
fork        ch8     "Tuning Fork"                            lufs=-25 verb=0.4
chorus      ch9     "Homunculus Choir"                       lufs=-23 pan=10 verb=0.4
kit         ch10    "Honey Pine Kit"                         lufs=-21 verb=0.08
boop        ch11    "Boop Boop"                              lufs=-26 pan=-30 echo=0.25

