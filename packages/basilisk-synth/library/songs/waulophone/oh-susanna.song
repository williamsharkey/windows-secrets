# Oh! Susanna: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Oh! Susanna
pack     = waulophone
credit   = Sounds by Paul Chauncy (Uncle Homunculus / Paulywauly)
kind     = world
composer = Stephen Foster (1826-1864)
source   = Oh! Susanna, song (1848): verse and chorus, written out from the song.
licence  = The work: public domain (published 1848; the composer died 1864). This arrangement: CC0-1.0; sounds by Paul Chauncy.
proof    = https://en.wikipedia.org/wiki/Oh!_Susanna
arranger = Algorithmic Industries house band
note     = A Paulywaulyton singalong at 116 bpm: six rounds of verse and chorus, the big-ears hum, the front-room piano, Barry on the bass, guitar, the sax, the bee-buzzing organ, the doo-doo choir, boops, a glockenspiel and a tuning fork; up a tone for the last two rounds. Drums: the pack's Honey Pine Kit.
midi     = oh-susanna.mid
script   = oh-susanna.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 1/8
feedback = 0.25
tone     = 3000
level    = -7

[reverb]
size     = 1.8
predelay = 18
tone     = 5500
level    = -5

[tracks]
# name      source  preset                                  mix
hum         ch1     "Hmm Held"                               lufs=-19 pan=4 verb=0.3
piano       ch2     "Kettle On"                              lufs=-21 pan=-14 verb=0.25
bass        ch3     "Barry Sings Low"                        lufs=-20
sax         ch4     "Crooner Sax"                            lufs=-21 pan=-20 echo=0.1 verb=0.3
organ       ch5     "Bee Organ Lead"                         lufs=-23 pan=20 verb=0.2 tune=-21
doo         ch6     "Doo Choir"                              lufs=-25 pan=-6 verb=0.35 width=1.3
glock       ch7     "Glock Bird"                             lufs=-24 pan=28 echo=0.2 verb=0.35
boop        ch8     "Boop Boop"                              lufs=-26 pan=-30 echo=0.25
guitar      ch9     "OTOLITH Late"                           lufs=-25 pan=32 verb=0.2 tune=-14
kit         ch10    "Honey Pine Kit"                         lufs=-18 verb=0.08
chorus      ch11    "Homunculus Choir"                       lufs=-22 pan=10 verb=0.4
fork        ch12    "Tuning Fork"                            lufs=-25 verb=0.4

