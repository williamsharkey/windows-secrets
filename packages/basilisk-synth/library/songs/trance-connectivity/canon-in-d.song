# Canon in D: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Canon in D
pack     = trance-connectivity
kind     = world
composer = Johann Pachelbel (1653-1706)
source   = Canon in D for three violins and basso continuo (c. 1680): the ground and the first violin's opening variations, with one eighth-note division on the ground written by the arranger in the same manner.
licence  = The work: public domain (17th century). This arrangement: CC0-1.0.
proof    = https://imslp.org/wiki/Canon_and_Gigue_in_D_major,_P.37_(Pachelbel,_Johann)
arranger = Algorithmic Industries house band
note     = Uplifting trance at 136 bpm: the ground as a rolling offbeat bass and plinks, the variations climbing from strings and a piano breakdown to the lead an octave up, sixteenth plucks, brass chords. Drums: Kit Manager 98 (Punch Kick Kit).
midi     = canon-in-d.mid
script   = canon-in-d.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.4
tone     = 3500
level    = -3

[reverb]
size     = 2.8
predelay = 22
tone     = 6000
level    = -5

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Punch Kick Kit"             lufs=-16 verb=0.05
bass        ch2     "Waxed Weight"                           lufs=-19
pluck       ch3     "Echo Pluck 138"                         lufs=-23 pan=-18 echo=0.3 verb=0.2
lead        ch4     "Neon Solo"                              lufs=-19 pan=4 echo=0.25 verb=0.3
pad         ch5     "Grey Mist"                              lufs=-25 verb=0.4 width=1.4
brass       ch6     "Paper Brass"                            lufs=-23 pan=14 verb=0.25
piano       ch7     "Breakdown Grand"                        lufs=-20 pan=-4 echo=0.15 verb=0.45
riser       ch8     "Midnight Riser"                         lufs=-25 verb=0.4
burst       ch9     "Dusk Burst"                             lufs=-24 verb=0.5
plink       ch11    "Signal Plink"                           lufs=-25 pan=30 echo=0.35 tune=-10
strings     ch12    "Blue Signal"                            lufs=-22 pan=-14 echo=0.15 verb=0.35

