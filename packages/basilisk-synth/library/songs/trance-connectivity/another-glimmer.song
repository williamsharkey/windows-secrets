# Another Glimmer: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Another Glimmer
pack     = trance-connectivity
kind     = chiptune
composer = Spring Spring
source   = ANOTHER GLIMMER, an Impulse Tracker module (glimmerCLEAN.it) from OpenGameArt (https://opengameart.org/sites/default/files/OST.zip). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/haydenwoffle-it-soundtrack
arranger = Algorithmic Industries house band
source_sha256= be2f7c15efd2b36d2274e9fb029d091e806c361f699380a4a54b72ba39c497fb
note     = Trance re-voicing of the module "Another Glimmer": bells, a violin lead, a choir pad, three basses on the rolling bass, glimmer and santur plucks, blips; its kick, hats, snare and toms on Kit Manager 98 (Punch Kick Kit).
midi     = another-glimmer.mid
script   = another-glimmer.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
bell        ch1     "Quiet Plink"                            lufs=-22 pan=20 echo=0.3 verb=0.3
violin      ch2     "Blue Signal"                            lufs=-20 pan=-6 echo=0.2 verb=0.3
choir       ch3     "Coral Tide"                             lufs=-25 verb=0.45 width=1.3
bass        ch4     "Waxed Weight"                           lufs=-19
pluck       ch5     "Tinted Pluck"                           lufs=-24 pan=-22 echo=0.3
santur      ch6     "Echo Pluck 138"                         lufs=-23 pan=26 echo=0.3 verb=0.2
blip        ch7     "Frosted Lead"                           lufs=-24 pan=-14 echo=0.2
plink       ch8     "Signal Plink"                           lufs=-26 pan=30 echo=0.3 tune=-10
kit         ch10    "kit-manager:Punch Kick Kit"             lufs=-17 verb=0.05
fx          ch9     "Felt Wake"                              lufs=-26 verb=0.4

