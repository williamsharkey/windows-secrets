# Lakeport Summer Rave: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Lakeport Summer Rave
pack     = trance-connectivity
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE1993)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Progressive trance in E minor, 132 bpm: a gated pluck pattern, a rolling bass, plinks, a long breakdown on the breakdown grand and choir with a riser, then the motor-whine lead with brass chords. Drums: Kit Manager 98 (Punch Kick Kit).
midi     = lakeport-summer-rave.mid
script   = lakeport-summer-rave.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.4
tone     = 3500
level    = -3

[reverb]
size     = 2.8
predelay = 22
tone     = 6000
level    = -5

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Punch Kick Kit"             lufs=-16 verb=0.05
bass        ch2     "Northern Pulse"                         lufs=-19
pluck       ch3     "Broadcast Harp"                         lufs=-23 pan=-16 echo=0.3 verb=0.2
lead        ch4     "Opal Ray"                               lufs=-19 pan=4 echo=0.25 verb=0.3
pad         ch5     "Misty Veil"                             lufs=-25 verb=0.4 width=1.4
brass       ch6     "Civic Brass"                            lufs=-23 pan=14 verb=0.25
piano       ch7     "Hollow Salon"                           lufs=-20 pan=-4 echo=0.15 verb=0.45
riser       ch8     "Plaza Riser"                            lufs=-25 verb=0.4
choir       ch9     "Coral Tide"                             lufs=-25 verb=0.45 width=1.3
plink       ch11    "Echo Plink"                             lufs=-26 pan=30 echo=0.35
fx          ch12    "Washed Lift"                            lufs=-26 verb=0.4

