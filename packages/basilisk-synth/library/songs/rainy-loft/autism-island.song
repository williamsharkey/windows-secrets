# Autism Island: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Autism Island
pack     = rainy-loft
kind     = chiptune
composer = Spring Spring
source   = Autism Island, a 0CC-FamiTracker module (autism_island.0cc) from OpenGameArt (https://opengameart.org/sites/default/files/autism%20island.zip). Its notes are played here; its chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/autism-island
arranger = Algorithmic Industries house band
note     = A NES module (2A03) re-voiced as city pop: pulse 1 on the neon sign lead, pulse 2 on the disco clavinet, the triangle on the rubber taxi bass, the noise channel on the pack's Couch Disco kit.
midi     = autism-island.mid
script   = autism-island.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 1.8
predelay = 14
tone     = 5500
level    = -7

[tracks]
# name      source  preset                                  mix
lead        ch1     "Neon Sign Lead"                         lufs=-19 pan=-6 echo=0.2 verb=0.2 tune=-15
clav        ch2     "Disco Clavinet"                         lufs=-22 pan=18 verb=0.15 tune=-22
bass        ch4     "Rubber Taxi"                            lufs=-19
kit         ch10    "Couch Disco"                            lufs=-19 verb=0.08

[dna]
# the presets' DNA when this song was written (used before the pack discs' own)
