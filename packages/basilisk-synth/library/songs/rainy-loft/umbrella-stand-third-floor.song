# Umbrella Stand, Third Floor: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Umbrella Stand, Third Floor
pack     = rainy-loft
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = City pop in F major, 100 bpm: rain on the window, the loft tine piano, the rubber taxi bass, taxi rhythm guitar chops, the Couch Disco kit, the neon sign lead, rooftop brass stabs, the vocoder chorus, a telephone and a passing train.
midi     = umbrella-stand-third-floor.mid
script   = umbrella-stand-third-floor.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 1.8
predelay = 14
tone     = 5500
level    = -7

[tracks]
# name      source  preset                                  mix
lead        ch1     "Neon Sign Lead"                         lufs=-18 pan=-4 echo=0.15 verb=0.2 tune=-15
tine        ch2     "Loft Tine"                              lufs=-21 pan=-18 verb=0.2
guitar      ch3     "Taxi Rhythm Guitar"                     lufs=-24 pan=26 verb=0.1
bass        ch4     "Rubber Taxi"                            lufs=-18
brass       ch5     "Rooftop Brass"                          lufs=-22 pan=12 verb=0.2
vocoder     ch6     "Vocoder Chorus"                         lufs=-25 width=1.3 verb=0.3 tune=-11
rain        ch7     "Rain on the Window"                     lufs=-30 width=1.4
train       ch8     "Passing Train"                          lufs=-26 width=1.3 verb=0.2
phone       ch9     "Telephone, Two Rings"                   lufs=-26 pan=-30 verb=0.25
kit         ch10    "Couch Disco"                            lufs=-18 verb=0.06

