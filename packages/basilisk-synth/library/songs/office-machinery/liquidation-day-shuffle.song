# Liquidation Day Shuffle: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Liquidation Day Shuffle
pack     = office-machinery
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Machine funk in E minor, 104 bpm, shuffled: hard-disk spin-up, tape-deck start, a spacebar kit and a PC-speaker kit, floppy reads and latches, an OPL3 snare, keyboard clacks, twelve drives humming the bass, a PC-speaker riff and the civil-defence bugle.
midi     = liquidation-day-shuffle.mid
script   = liquidation-day-shuffle.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3000
level    = -6

[reverb]
size     = 1.4
predelay = 10
tone     = 5000
level    = -7

[tracks]
# name      source  preset                                  mix
kit         ch10    "Rubber Canopy"                          lufs=-17 verb=0.06
beepkit     ch9     "Coded Mist"                             lufs=-26 pan=-22
drives      ch2     "Ocean Crowd"                            lufs=-20
beep        ch3     "Cedar Hat"                              lufs=-22 pan=10 echo=0.2 verb=0.15 tune=78
bugle       ch4     "Signal Uplink"                          lufs=-20 pan=-6 echo=0.15 verb=0.35
spinup      ch5     "Open Uplink"                            lufs=-23 verb=0.2
tape        ch6     "Still Swoosh"                           lufs=-24 verb=0.2
floppy      ch7     "Rural Burst"                            lufs=-25 pan=26 echo=0.2
latch       ch8     "Lucid Surge"                            lufs=-25 pan=-28
opl3        ch11    "Bright Block"                           lufs=-25 pan=4 verb=0.15
clack       ch12    "Jade Clack"                             lufs=-28 pan=32
hum         ch13    "Velvet Room"                            lufs=-31 width=1.3
insert      ch14    "Yellow Hat"                             lufs=-26 pan=18

[dna]
# the presets' DNA when this song was written (used before the pack discs' own)
