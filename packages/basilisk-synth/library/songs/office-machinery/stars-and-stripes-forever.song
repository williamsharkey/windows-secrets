# The Stars and Stripes Forever: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = The Stars and Stripes Forever
pack     = office-machinery
kind     = world
composer = John Philip Sousa (1854-1932)
source   = The Stars and Stripes Forever, march (1896), piano edition: the introduction and first strain, the trio, the break strain and the grandioso. Score: The Mutopia Project, from The John Church Company (Cincinnati, 1897).
licence  = The work: public domain (published 1897; the composer died 1932). The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=626
arranger = Algorithmic Industries house band
note     = A march for the computer room in cut time: the civil-defence bugle on the tune (a lower bugle in the break strain), the PC speaker on the grandioso's piccolo line, twelve drives on the bass, a spacebar kit side drum, an OPL3 snare, floppy drives, keyboard clacks and a hard disk spinning up.
midi     = stars-and-stripes-forever.mid
script   = stars-and-stripes-forever.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 1/4
feedback = 0.2
tone     = 3000
level    = -10

[reverb]
size     = 1.6
predelay = 12
tone     = 5000
level    = -6

[tracks]
# name      source  preset                                  mix
bugle       ch1     "Signal Uplink"                          lufs=-19 pan=-4 verb=0.3
beep        ch2     "Cedar Hat"                              lufs=-23 pan=16 echo=0.15 tune=78
lowbugle    ch3     "White Dive"                             lufs=-22 pan=-18 verb=0.3
drives      ch4     "Ocean Crowd"                            lufs=-20
kit         ch10    "Rubber Canopy"                          lufs=-18 verb=0.08
beepkit     ch9     "Coded Mist"                             lufs=-27 pan=-22
floppy      ch5     "Rural Burst"                            lufs=-26 pan=26 echo=0.2
clack       ch6     "Jade Clack"                             lufs=-29 pan=32
opl3        ch7     "Bright Block"                           lufs=-26 pan=4 verb=0.15
spinup      ch8     "Open Uplink"                            lufs=-24 verb=0.2
hum         ch11    "Velvet Room"                            lufs=-32 width=1.3

