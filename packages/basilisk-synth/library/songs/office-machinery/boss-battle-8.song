# Boss Battle 8: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Boss Battle 8
pack     = office-machinery
kind     = chiptune
composer = nene
source   = boss_battle_08, a Standard MIDI File (boss_battle_08.mid) from OpenGameArt (https://opengameart.org/sites/default/files/boss_battle_08.mid). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/boss-battle-8-retro
arranger = Algorithmic Industries house band
source_sha256= 52da0aa33ad0a76eaa47b2135f6de4cd5da9c4dbd4b9d1b4b80a568f52b365d1
note     = Played twice through on office machinery: the MIDI file's lead on the civil-defence bugle, its rhythm lines on PC-speaker beeps and the low bugle, its bass on twelve drives, its strings on a hard-disk inductor, its General MIDI drums on the spacebar kit.
midi     = boss-battle-8.mid
script   = boss-battle-8.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
bugle       ch1     "Signal Uplink"                          lufs=-20 pan=-4 verb=0.3
beep        ch2     "Cedar Hat"                              lufs=-24 pan=16 tune=78
lowbugle    ch3     "White Dive"                             lufs=-23 pan=-18 verb=0.3
drives      ch4     "Ocean Crowd"                            lufs=-19
beep2       ch5     "Harbor Snare"                           lufs=-26 pan=24 tune=78
inductor    ch6     "Steady Texture"                         lufs=-26 pan=-24
kit         ch10    "Rubber Canopy"                          lufs=-17 verb=0.06

