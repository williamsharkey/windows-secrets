# Fax Machine Fanfare: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Fax Machine Fanfare
pack     = office-machinery
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE1993)
licence  = CC0-1.0 (the composition and this arrangement)
note     = An industrial march in C, 104 bpm: a bugle call, march and trio on the civil-defence bugle, the PC speaker on the trio, twelve drives on the bass, a spacebar-kit side drum, OPL3 snare, floppy drives, keyboard clacks, a floppy latch, a hard disk spinning up.
midi     = fax-machine-fanfare.mid
script   = fax-machine-fanfare.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 1/4
feedback = 0.2
tone     = 3000
level    = -10

[reverb]
size     = 1.6
predelay = 12
tone     = 5000
level    = -6

[tracks]
# name      source  preset                                  mix
bugle       ch1     "Signal Uplink"                          lufs=-19 pan=-4 verb=0.3
lowbugle    ch2     "White Dive"                             lufs=-23 pan=-18 verb=0.3
beep        ch3     "Cedar Hat"                              lufs=-23 pan=16 echo=0.15 tune=78
drives      ch4     "Ocean Crowd"                            lufs=-20
kit         ch10    "Solar Haze"                             lufs=-18 verb=0.08
beepkit     ch9     "Winter Canopy"                          lufs=-27 pan=-22
floppy      ch5     "Silent Uplink"                          lufs=-26 pan=26 echo=0.2
clack       ch6     "Electric Clack"                         lufs=-29 pan=32
opl3        ch7     "Bright Block"                           lufs=-26 pan=4 verb=0.15
spinup      ch8     "Open Uplink"                            lufs=-24 verb=0.2
hum         ch11    "Honey Murmur"                           lufs=-32 width=1.3
latch       ch12    "Lucid Surge"                            lufs=-25 pan=-28

[dna]
