# Rhythmove: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Rhythmove
pack     = office-machinery
kind     = chiptune
composer = northivanastan
source   = Rhythmove, a Standard MIDI File (rhythmove.mid) from OpenGameArt (https://opengameart.org/sites/default/files/rhythmove.mid). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/rhythmove
arranger = Algorithmic Industries house band
source_sha256= c37e73690ce553261a794f70a1ec1aed3d6bac82e91c32e9826486e9c1683c55
note     = A CC0 MIDI file on office machinery: its strings on the PC speaker, its synth brass on the civil-defence bugle, its square lead on the low bugle, its bass on twelve drives, its General MIDI drums on the spacebar kit, its guitars on a hard-disk inductor.
midi     = rhythmove.mid
script   = rhythmove.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
beep        ch1     "Cedar Hat"                              lufs=-24 pan=16 echo=0.15 tune=78
bugle       ch2     "Signal Uplink"                          lufs=-20 pan=-4 verb=0.3
lowbugle    ch3     "White Dive"                             lufs=-22 pan=-18 verb=0.3
drives      ch4     "Ocean Crowd"                            lufs=-20
kit         ch10    "Rubber Canopy"                          lufs=-17 verb=0.06
inductor    ch5     "Steady Texture"                         lufs=-25 pan=24

[dna]
