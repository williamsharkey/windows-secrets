# Wedding Day at Troldhaugen: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Wedding Day at Troldhaugen
pack     = rom-reference
kind     = world
composer = Edvard Grieg (1843-1907)
source   = Wedding Day at Troldhaugen, Lyric Pieces Op. 65 No. 6 (1896): bars 1-48 and the last eight bars. Score: The Mutopia Project, from Schirmer (1903).
licence  = The work: public domain (published 1896; the composer died 1907). The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=781
arranger = Algorithmic Industries house band
note     = Late-80s workstation pop at 116 bpm: the tune on a lead over brass stabs, the left hand on bass and piano, a vocal pad then string swells, gamelan and harp runs, an organ on the last chord. Drums: Kit Manager 98 (Breaker Box Kit).
midi     = wedding-day-at-troldhaugen.mid
script   = wedding-day-at-troldhaugen.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.32
tone     = 3500
level    = -5

[reverb]
size     = 2.6
predelay = 20
tone     = 6000
level    = -4

[tracks]
# name      source  preset                                  mix
lead        ch1     "Cathode Lead"                           lufs=-19 pan=4 echo=0.2 verb=0.35
brass       ch2     "Lunar Brass"                            lufs=-23 pan=16 verb=0.25
piano       ch3     "Lagoon Piano"                           lufs=-23 pan=-18 verb=0.3
bass        ch4     "Neon Basement"                          lufs=-20
strings     ch5     "Blue Swell"                             lufs=-24 pan=-10 verb=0.4 width=1.3
gamelan     ch6     "Hazy Gamelan"                           lufs=-26 pan=-26 echo=0.3 verb=0.3 tune=-57
harp        ch7     "Copper Harp"                            lufs=-26 pan=30 echo=0.2 verb=0.35
vox         ch8     "Slate Vox"                              lufs=-26 verb=0.45 width=1.3
organ       ch9     "Pastel Bark"                            lufs=-26 pan=24 verb=0.2
kit         ch10    "kit-manager:Breaker Box Kit"            lufs=-18 verb=0.12

