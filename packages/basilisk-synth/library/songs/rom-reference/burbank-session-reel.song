# Burbank Session Reel: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Burbank Session Reel
pack     = rom-reference
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Late-80s workstation pop-fusion in E-flat, 108 bpm: gamelan pluck and drone, piano, tines, slap bass line, brass stabs, organ, string swells, a vocal pad, harp runs and a lead. Drums: Kit Manager 98 (Breaker Box Kit).
midi     = burbank-session-reel.mid
script   = burbank-session-reel.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.35
tone     = 3500
level    = -4

[reverb]
size     = 2.6
predelay = 20
tone     = 6000
level    = -4

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Breaker Box Kit"            lufs=-17 verb=0.12
bass        ch2     "Neon Basement"                          lufs=-19
piano       ch3     "Lagoon Piano"                           lufs=-21 pan=-18 verb=0.3
tines       ch4     "Jade Tines"                             lufs=-22 pan=14 echo=0.2 verb=0.3
gamelan     ch5     "Hazy Gamelan"                           lufs=-25 pan=-26 echo=0.3 verb=0.3 tune=-57
lead        ch6     "Cathode Lead"                           lufs=-19 pan=4 echo=0.25 verb=0.35
brass       ch7     "Lunar Brass"                            lufs=-22 pan=16 verb=0.25
organ       ch8     "Pastel Bark"                            lufs=-25 pan=24 verb=0.2
strings     ch9     "Blue Swell"                             lufs=-22 pan=-10 verb=0.4 width=1.3
vox         ch11    "Slate Vox"                              lufs=-26 verb=0.45 width=1.3
drone       ch12    "Daylight Continuum"                     lufs=-28 verb=0.4
harp        ch13    "Copper Harp"                            lufs=-26 pan=30 echo=0.2 verb=0.35

