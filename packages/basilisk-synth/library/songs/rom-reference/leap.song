# Leap: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Leap
pack     = rom-reference
kind     = chiptune
composer = nene
source   = leap, a Standard MIDI File (leap.mid) from OpenGameArt (https://opengameart.org/sites/default/files/leap.mid). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/leap-8bit
arranger = Algorithmic Industries house band
source_sha256= c6d21f3d5416168c75f2f9cc1913d7293b4ac3e86f8aabee5939ec1f2346fc29
note     = The MIDI file's lead guitar, keyboards, strings, bass and rhythm guitar on workstation voices, its General MIDI drums on Kit Manager 98 (Breaker Box Kit).
midi     = leap.mid
script   = leap.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
lead        ch1     "Cathode Lead"                           lufs=-19 pan=4 echo=0.2 verb=0.3
keys        ch2     "Lagoon Piano"                           lufs=-22 pan=-16 verb=0.3
keys2       ch3     "Jade Tines"                             lufs=-25 pan=18
strings     ch4     "Blue Swell"                             lufs=-25 verb=0.4
bass        ch5     "Neon Basement"                          lufs=-19
gtr         ch6     "Floor Pluck"                            lufs=-26 pan=-26
kit         ch10    "kit-manager:Breaker Box Kit"            lufs=-17 verb=0.1

