# Session Musician on Call: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Session Musician on Call
pack     = rom-reference
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = New jack swing in G minor, 100 bpm: a swung machine beat, a bouncing bass, brass stabs, an organ bark, the hook on a lead and the vocal pad, tines, a piano bridge, strings and plinks. Drums: Kit Manager 98 (Breaker Box Kit).
midi     = session-musician-on-call.mid
script   = session-musician-on-call.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -5

[reverb]
size     = 2.0
predelay = 15
tone     = 6000
level    = -5

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Breaker Box Kit"            lufs=-16.5 verb=0.08
bass        ch1     "Digital Low"                            lufs=-19
brass       ch2     "Granite Horns"                          lufs=-22 pan=14 verb=0.2
organ       ch3     "Pastel Bark"                            lufs=-26 pan=-22 verb=0.2
vox         ch4     "Dial Ahh"                               lufs=-21 pan=-4 echo=0.15 verb=0.35
tines       ch5     "Jade Tines"                             lufs=-24 pan=-16 verb=0.3
lead        ch6     "Rubber Line"                            lufs=-20 pan=6 echo=0.2 verb=0.3
piano       ch7     "Still Ballad"                           lufs=-22 pan=-10 verb=0.3
plink       ch8     "Orbital Plink"                          lufs=-27 pan=28 echo=0.3
strings     ch9     "Zinc Ensemble"                          lufs=-25 pan=10 verb=0.4 width=1.3

[dna]
