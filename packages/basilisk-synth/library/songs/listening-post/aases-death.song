# Aase's Death: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Aase's Death
pack     = listening-post
kind     = world
composer = Edvard Grieg (1843-1907)
source   = Aase's Death, Peer Gynt Suite No. 1, Op. 46 No. 2 (1875), piano version. Score: The Mutopia Project, from Kunkel Brothers (1891).
licence  = The work: public domain (composed 1875; the composer died 1907). The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=246
arranger = Algorithmic Industries house band
note     = Slowly, at 52 bpm, in the deep ocean: a humpback on the tune, a singing bowl on the inner voices, fin-whale drones on the bass line, blue-whale drones holding the chords.
midi     = aases-death.mid
script   = aases-death.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3200
level    = -6

[reverb]
size     = 2.4
predelay = 20
tone     = 5500
level    = -5

[tracks]
# name      source  preset                                  mix
humpback    ch1     "Ocean Shoreline"                        lufs=-20 pan=4 echo=0.2 verb=0.5
bowl        ch2     "Saffron Dormant"                        lufs=-26 pan=-14 verb=0.5 tune=22
fin         ch3     "Dial Depth"                             lufs=-23 pan=-10 verb=0.45
blue        ch4     "Lattice Dormant"                        lufs=-25 pan=12 verb=0.45

