# A Basin Away: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = A Basin Away
pack     = listening-post
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement); the hydrophone recordings are NOAA PMEL's (public domain)
note     = Deep-ocean ambient in D minor, 60 bpm: the bloop and an iceberg calving, fin-whale and blue-whale drones in slow chords with a singing bowl, a humpback singing a line, the upsweep, a ship overhead and a tremor.
tail     = 8
midi     = a-basin-away.mid
script   = a-basin-away.py

[master]
loudness = -18
ceiling  = -1.0
fadeout  = 4

[echo]
time     = 1/2
feedback = 0.45
tone     = 2000
level    = -5

[reverb]
size     = 6.0
predelay = 40
tone     = 3500
level    = -2

[tracks]
# name      source  preset                                  mix
fin         ch1     "Dial Depth"                             lufs=-23 pan=-14 verb=0.4
blue        ch2     "Lattice Dormant"                        lufs=-24 pan=14 verb=0.4
bowl        ch3     "Saffron Dormant"                        lufs=-28 verb=0.5 tune=22
humpback    ch4     "Ocean Shoreline"                        lufs=-21 pan=4 echo=0.25 verb=0.5
bloop       ch5     "Cedar Murmur"                           lufs=-23 verb=0.4
iceberg     ch6     "Swift Room"                             lufs=-24 pan=-24 verb=0.5
upsweep     ch7     "Lattice Dive"                           lufs=-25 pan=22 echo=0.4 verb=0.5
ship        ch8     "Second Launch"                          lufs=-23 width=1.4 verb=0.3
tremor      ch9     "Still Lift"                             lufs=-24 verb=0.3
nets        ch11    "White Shoreline"                        lufs=-26 pan=30 verb=0.5
murmur      ch12    "Broadcast Murmur"                       lufs=-31 width=1.4
dive        ch13    "Tropic Sweep"                           lufs=-26 pan=-30 echo=0.4 verb=0.5

