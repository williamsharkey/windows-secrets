# Clair de lune: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Clair de lune
pack     = listening-post
kind     = world
composer = Claude Debussy (1862-1918)
source   = Clair de lune, from Suite bergamasque, L. 75 (published 1905): bars 1-18 and 65 to the end. Score: The Mutopia Project, from E. Fromont (1905).
licence  = The work: public domain (published 1905; the composer died 1918). The edition used: public domain (Mutopia). This arrangement: CC0-1.0. The hydrophone recordings: NOAA PMEL, public domain.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=1778
arranger = Algorithmic Industries house band
note     = The opening and closing pages at 60 bpm: a humpback on the top line, a singing bowl on the inner voices, fin-whale and blue-whale drones on the left hand; ice calving, the bloop and the upsweep between.
tail     = 8
midi     = clair-de-lune.mid
script   = clair-de-lune.py

[master]
loudness = -18
ceiling  = -1.0
fadeout  = 4

[echo]
time     = 3/8
feedback = 0.4
tone     = 2200
level    = -6

[reverb]
size     = 5.5
predelay = 40
tone     = 3500
level    = -2

[tracks]
# name      source  preset                                  mix
humpback    ch1     "Ocean Shoreline"                        lufs=-20 pan=4 echo=0.2 verb=0.5
bowl        ch2     "Saffron Dormant"                        lufs=-25 pan=-14 verb=0.5 tune=22
fin         ch3     "Dial Depth"                             lufs=-23 pan=-10 verb=0.45
blue        ch4     "Lattice Dormant"                        lufs=-25 pan=14 verb=0.45
upsweep     ch5     "Lattice Dive"                           lufs=-26 pan=24 echo=0.4 verb=0.5
bloop       ch6     "Cedar Murmur"                           lufs=-24 verb=0.4
iceberg     ch7     "Swift Room"                             lufs=-25 pan=-24 verb=0.5
murmur      ch8     "Broadcast Murmur"                       lufs=-31 width=1.4
dive        ch9     "Tropic Sweep"                           lufs=-27 pan=-30 echo=0.4 verb=0.5

