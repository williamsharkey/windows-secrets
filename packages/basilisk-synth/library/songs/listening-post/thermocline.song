# Thermocline: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Thermocline
pack     = listening-post
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE1993)
licence  = CC0-1.0 (the composition and this arrangement); the hydrophone recordings are NOAA PMEL's (public domain)
note     = A slow descent in E minor, 56 bpm: a ship overhead, blue-whale and fin-whale drones settling a fifth lower each section, a humpback line, distant airguns, the white shoreline, the bloop and ice at the bottom.
tail     = 8
midi     = thermocline.mid
script   = thermocline.py

[master]
loudness = -18
ceiling  = -1.0
fadeout  = 4

[echo]
time     = 1/2
feedback = 0.45
tone     = 2000
level    = -5

[reverb]
size     = 6.0
predelay = 40
tone     = 3500
level    = -2

[tracks]
# name      source  preset                                  mix
fin         ch1     "Dial Depth"                             lufs=-23 pan=-12 verb=0.45
blue        ch2     "Lattice Dormant"                        lufs=-24 pan=12 verb=0.45
bowl        ch3     "Saffron Dormant"                        lufs=-28 verb=0.5 tune=22
humpback    ch4     "Ocean Shoreline"                        lufs=-20 pan=4 echo=0.25 verb=0.5
ship        ch5     "Second Launch"                          lufs=-23 width=1.4 verb=0.3
airgun      ch6     "Waxed Murmur"                           lufs=-27 pan=-30 echo=0.4 verb=0.5
bloop       ch7     "Cedar Murmur"                           lufs=-23 verb=0.4
ice         ch8     "Swift Room"                             lufs=-24 pan=24 verb=0.5
upsweep     ch9     "Lattice Dive"                           lufs=-26 pan=22 echo=0.4 verb=0.5
murmur      ch11    "Broadcast Murmur"                       lufs=-31 width=1.4
shoreline   ch12    "White Shoreline"                        lufs=-26 pan=-20 verb=0.5

