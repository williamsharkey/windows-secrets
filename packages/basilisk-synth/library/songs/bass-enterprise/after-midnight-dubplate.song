# After Midnight Dubplate: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = After Midnight Dubplate
pack     = bass-enterprise
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Dark 2-step in F minor, 134 bpm: the wobbling speed sub over a sub thump, the error growl, the two-step minor stab, a trombone call, the vowel pad, the still salute, an impact on every section. Drums: Kit Manager 98 (Half-Time Kit).
midi     = after-midnight-dubplate.mid
script   = after-midnight-dubplate.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.35
tone     = 3000
level    = -4

[reverb]
size     = 1.6
predelay = 12
tone     = 5500
level    = -7

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Half-Time Kit"              lufs=-17 verb=0.05
wobble      ch1     "Wobbly Speed Sub"                       lufs=-19 tune=-57
growl       ch2     "Error Growl"                            lufs=-23 pan=8
sub         ch3     "Half-Step Sub"                          lufs=-25
stab        ch4     "Two-Step Minor Stab"                    lufs=-21 pan=-14 echo=0.22 verb=0.15
horn        ch5     "Lattice Accent"                         lufs=-21 pan=12 echo=0.2 verb=0.2
vowel       ch6     "Marble Vowel"                           lufs=-25 verb=0.4 width=1.3
doom        ch7     "Impact Doom"                            lufs=-24 verb=0.3
fx          ch8     "Basement Swoosh"                        lufs=-26 verb=0.4
salute      ch9     "Still Salute"                           lufs=-25 pan=-20 verb=0.3

[dna]
# the presets' DNA when this song was written (used before the pack discs' own)
"bass-enterprise:Basement Swoosh" = restore<<E#6/balloon<<<#4FL80/minimize<<#4FL60;A0R1500K24G21
"bass-enterprise:Error Growl" = error@5]+++C@2XC@4X<<<@0CP@0CP#16U2~20;A0R100K51G-6
"bass-enterprise:Half-Step Sub" = print@15[@50]@0CP@0CP@0CP<<<#8;A5S100R150K46G19
"bass-enterprise:Impact Doom" = critstop<<E#6/balloon<<<#4FL80/minimize<<#4FL60;A0R1500K24G5
"bass-enterprise:Lattice Accent" = trombone_sus_c3@t3000]>U2~6;A11D216S12R154V71K72G-6
"bass-enterprise:Marble Vowel" = organ_pedal_25#12U3~14/chimes>#4T-7L25O51Q-40;A776D105S93R1592V81K60G-11
"bass-enterprise:Still Salute" = tadaxp#10U3~11/kalimba_c4@t1500]#3T-24L50Q27/em_metal_click_a>#3FL43;A32D203S66R420V99K48G6
"bass-enterprise:Two-Step Minor Stab" = xpnotify@8]E#10H0,3,7,14;A0D300S0R200V80K70G15
"bass-enterprise:Wobbly Speed Sub" = ringout@20[@40]@0CP@0CP@0CP++<<<#12Ja0,100.111,30.222,100.333,30.444,100;A0R100K33G-2
"kit-manager:Half-Time Kit" = ringout@20[@40]@0CP<<<+Ja0,100.80,50.400,0#3F/recycle@20]+E#4F/xprecycle>>>@40]#5F/critstop<@10]#4;R200V90k36k35i80k38l2k39l2s.3i90k40l2t40k42l3e.12c1k44l3e.05i70c1k46l3c1k37l4k41,50l4r45p100w7
