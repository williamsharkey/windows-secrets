# Hectic: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Hectic
pack     = bass-enterprise
kind     = chiptune
composer = Phillip Miller (redactionary)
source   = hectic song, a FamiTracker module (nes_05-hectic.ftm) from OpenGameArt (https://opengameart.org/sites/default/files/Free_NES_Music_Pack.zip). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/free-nes-music-pack
arranger = Algorithmic Industries house band
source_sha256= 678f3481bd0af420c5ca5d4cf6a807c5e767f2890bd6b4165f965fa11c0546f2
note     = A NES module (2A03 + VRC6) re-voiced as garage: pulse 2 on the 2-step organ bass, the VRC6 saw on the wobbling sub, the triangle on the trombone hook, the VRC6 pulses and pulse 1 on organ chords, a brass section and a punch; DPCM and noise on Kit Manager 98 (Half-Time Kit).
midi     = hectic.mid
script   = hectic.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
organbass   ch2     "Organ Bass 2-Step"                      lufs=-19 tune=-57
wobble      ch3     "Wobbly Speed Sub"                       lufs=-21 tune=-57
horn        ch1     "Lattice Accent"                         lufs=-20 pan=12 echo=0.2 verb=0.2
chord       ch4     "Golden Chord"                           lufs=-24 pan=-16 verb=0.2
section     ch5     "Lagoon Section"                         lufs=-23 pan=20 verb=0.2
punch       ch6     "Federal Punch"                          lufs=-26 pan=-24
kit         ch10    "kit-manager:Half-Time Kit"              lufs=-17 verb=0.05

