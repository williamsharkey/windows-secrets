# Fairest Isle: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Fairest Isle
pack     = bass-enterprise
kind     = world
composer = Henry Purcell (1659-1695)
source   = Fairest Isle, from King Arthur (1691), as a four-part setting. Score: The Mutopia Project.
licence  = The work: public domain (17th century). The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=268
arranger = Algorithmic Industries house band
note     = UK garage at 132 bpm in a 6/8 shuffle: the air on a trombone hook, inner voices on the organ chord, the bass voice on the 2-step organ bass and a sub, a bass-guitar breakdown, then four to the floor on the wobbling sub. Drums: Kit Manager 98 (Half-Time Kit).
midi     = fairest-isle.mid
script   = fairest-isle.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.35
tone     = 3000
level    = -4

[reverb]
size     = 1.6
predelay = 12
tone     = 5500
level    = -7

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Half-Time Kit"              lufs=-17 verb=0.05
horn        ch1     "Lattice Accent"                         lufs=-20 pan=12 echo=0.2 verb=0.2
chord       ch2     "Golden Chord"                           lufs=-24 pan=-16 verb=0.25
organbass   ch3     "Organ Bass 2-Step"                      lufs=-19 tune=-57
sub         ch4     "Floor Rumble"                           lufs=-25
wobble      ch5     "Wobbly Speed Sub"                       lufs=-19 tune=-57
vowel       ch6     "Marble Vowel"                           lufs=-25 verb=0.4 width=1.3
fx          ch7     "Cedar Ascent"                           lufs=-26 verb=0.4
doom        ch8     "Impact Doom"                            lufs=-24 verb=0.3
bassgtr     ch9     "Ocean Bass"                             lufs=-20 tune=-11
stab        ch11    "Federal Punch"                          lufs=-25 pan=-10 echo=0.25

