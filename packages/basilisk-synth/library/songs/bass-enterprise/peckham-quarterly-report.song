# Peckham Quarterly Report: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Peckham Quarterly Report
pack     = bass-enterprise
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = UK garage in G minor, 132 bpm: 2-step beat, parallel minor stabs, organ bass, trombone hook, a bass-guitar bridge, then speed garage on the wobbling sub. Drums: Kit Manager 98 (Half-Time Kit).
midi     = peckham-quarterly-report.mid
script   = peckham-quarterly-report.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.35
tone     = 3000
level    = -4

[reverb]
size     = 1.6
predelay = 12
tone     = 5500
level    = -7

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Half-Time Kit"              lufs=-16.5 verb=0.05
organbass   ch2     "Organ Bass 2-Step"                      lufs=-19 tune=-57
wobble      ch3     "Wobbly Speed Sub"                       lufs=-19 tune=-57
sub         ch4     "Floor Rumble"                           lufs=-24
stab        ch5     "Two-Step Minor Stab"                    lufs=-21 pan=-14 echo=0.22 verb=0.15
horn        ch6     "Lattice Accent"                         lufs=-20 pan=12 echo=0.2 verb=0.2
vowel       ch7     "Marble Vowel"                           lufs=-25 verb=0.4 width=1.3
chord       ch8     "Golden Chord"                           lufs=-24 pan=20 verb=0.25
bassgtr     ch9     "Ocean Bass"                             lufs=-20 tune=-11
fx          ch11    "Cedar Ascent"                           lufs=-26 verb=0.4
doom        ch12    "Impact Doom"                            lufs=-24 verb=0.3

[dna]
