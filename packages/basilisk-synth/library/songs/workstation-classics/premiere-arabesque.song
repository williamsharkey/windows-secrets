# Premiere Arabesque: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Premiere Arabesque
pack     = workstation-classics
kind     = world
composer = Claude Debussy (1862-1918)
source   = Deux arabesques, L. 66: No. 1 (1891), bars 1-46. Score: The Mutopia Project, from Durand et Fils (1904).
licence  = The work: public domain (published 1891; the composer died 1918). The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=1777
arranger = Algorithmic Industries house band
note     = The opening runs on glass plucks, then the tune on the flute solo and a violin lead, inner voices on keys, a bass, glass and choir pads, a light pop beat from the second theme. Drums: Kit Manager 98 (Pop Studio Kit).
midi     = premiere-arabesque.mid
script   = premiere-arabesque.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -5

[reverb]
size     = 2.4
predelay = 20
tone     = 6000
level    = -4

[tracks]
# name      source  preset                                  mix
pluck       ch1     "Glass Pluck Plus"                       lufs=-21 pan=-14 echo=0.2 verb=0.3
flute       ch2     "Global Solo"                            lufs=-20 pan=6 echo=0.15 verb=0.35
violin      ch3     "Opal Lead"                              lufs=-20 pan=-4 echo=0.15 verb=0.35
keys        ch4     "Azure Ticks"                            lufs=-25 pan=24 verb=0.3
bass        ch5     "Meadow Low"                             lufs=-21
pad         ch6     "Bright Pad"                             lufs=-26 verb=0.4 width=1.3
choir       ch7     "Night Mist"                             lufs=-26 verb=0.45 width=1.3
fx          ch8     "Clear Warp"                             lufs=-27 verb=0.5
kit         ch10    "kit-manager:Punch Kick Kit"             lufs=-19 verb=0.08

