# 100% Compatible: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = 100% Compatible
pack     = workstation-classics
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Eurodance in D minor, 132 bpm: offbeat mono bass, arena plucks, choir pad, poly-brass stabs, a degaussed monitor and the chorus lead. Drums: Kit Manager 98 (Punch Kick Kit).
midi     = one-hundred-percent-compatible.mid
script   = one-hundred-percent-compatible.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.32
tone     = 3500
level    = -4

[reverb]
size     = 2.0
predelay = 15
tone     = 6000
level    = -6

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Punch Kick Kit"             lufs=-16.5 verb=0.06
bass        ch2     "Ladder Mono Bass"                       lufs=-19
pluck       ch3     "Arena Pluck"                            lufs=-23 pan=-20 echo=0.2 verb=0.15
brass       ch4     "Poly Brass Circuit"                     lufs=-22 pan=16 verb=0.2
lead        ch5     "Chrome Pilot"                           lufs=-19 pan=0 echo=0.25 verb=0.25 tune=-24
verse       ch6     "Lobby Song"                             lufs=-20 pan=-6 echo=0.2 verb=0.25
choir       ch7     "Night Mist"                             lufs=-25 verb=0.4 width=1.3
strings     ch8     "Pale Cloud"                             lufs=-24 pan=10 verb=0.35 width=1.3
lift        ch9     "Brass Lift"                             lufs=-26 verb=0.4
degauss     ch11    "Dusk Sweep"                             lufs=-23 verb=0.3
stab        ch12    "Saffron Stab"                           lufs=-26 pan=-14 echo=0.3 verb=0.2

