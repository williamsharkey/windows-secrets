# Clamshell Pack Anthem: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Clamshell Pack Anthem
pack     = workstation-classics
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Happy-trance pop in F, 136 bpm: an offbeat bass, glass plucks, a ladder arpeggio, a choir hook, the flute solo lead on the chorus, arena-pluck chords, a salute stab, a pad. Drums: Kit Manager 98 (Punch Kick Kit).
midi     = clamshell-pack-anthem.mid
script   = clamshell-pack-anthem.py

[master]
loudness = -14
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.32
tone     = 3500
level    = -4

[reverb]
size     = 2.0
predelay = 15
tone     = 6000
level    = -6

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Punch Kick Kit"             lufs=-16.5 verb=0.06
bass        ch1     "Neon Rumble"                            lufs=-19
pluck       ch2     "Glass Pluck Plus"                       lufs=-23 pan=-18 echo=0.2 verb=0.15
ladder      ch3     "Ultra Ladder"                           lufs=-25 pan=22 echo=0.25
chords      ch4     "Elevated Horns"                         lufs=-22 pan=12 verb=0.2
choir       ch5     "Night Mist"                             lufs=-21 pan=-6 verb=0.4
lead        ch6     "Global Solo"                            lufs=-19 pan=4 echo=0.25 verb=0.3
pad         ch7     "Rapid Glow"                             lufs=-26 verb=0.4 width=1.3
fx          ch8     "Rusty Ascent"                           lufs=-26 verb=0.4
stab        ch9     "Washed Salute"                          lufs=-25 pan=-14 echo=0.3 verb=0.2

[dna]
