# Battle: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Battle
pack     = workstation-classics
kind     = chiptune
composer = Spring Spring
source   = Battle, an Impulse Tracker module (battleCLEAN.it) from OpenGameArt (https://opengameart.org/sites/default/files/OST.zip). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/haydenwoffle-it-soundtrack
arranger = Algorithmic Industries house band
source_sha256= d1bbd78bf5367647f078945be36546bdc93aefabc357eb0576b14583baf2ddcb
note     = A battle theme on the workstation set: square and lead lines on two leads, plucks, pizzicato and strums, two basses on the mono bass, the triangle arpeggio on a ticking pluck, a distorted-guitar stab, a pad, its kick, hats and cymbal on Kit Manager 98 (Punch Kick Kit).
midi     = battle.mid
script   = battle.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
lead        ch1     "Flat Ray"                               lufs=-20 pan=-6 echo=0.15 verb=0.2
lead2       ch2     "Chrome Pilot"                           lufs=-21 pan=8 echo=0.2 verb=0.2 tune=-24
pluck       ch3     "Arena Pluck"                            lufs=-24 pan=-22 echo=0.2
pizz        ch4     "Felt Pizz"                              lufs=-25 pan=22 tune=-43
strum       ch5     "Orbital Strum"                          lufs=-25 pan=-30
bass        ch6     "Ladder Mono Bass"                       lufs=-19
tri         ch11    "Azure Ticks"                            lufs=-25 pan=-14 echo=0.1
stab        ch7     "Molten Stab"                            lufs=-24 pan=14 verb=0.2
pad         ch8     "Pale Cloud"                             lufs=-26 verb=0.35 width=1.3
pick        ch9     "Distant Pick"                           lufs=-26 pan=28
kit         ch10    "kit-manager:Punch Kick Kit"             lufs=-17 verb=0.06

