# Uninstall Complete: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Uninstall Complete
pack     = kit-manager
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE1993)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Drum and bass at 172 bpm, all on Kit Manager 98: breaks on the Breaker Box, Noise Channel and Twelve-Bit Crate kits, the bass line on Mainframe Hall's tuned keys, the tune on Teletype 33's, bells on Message Center, a Card Room arpeggio and the Echo Chamber kit in the breakdown.
midi     = uninstall-complete.mid
script   = uninstall-complete.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/8
feedback = 0.3
tone     = 3500
level    = -5

[reverb]
size     = 1.8
predelay = 15
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
breakerbox  ch1     "Breaker Box Kit"                        lufs=-17 verb=0.05
noisechannel ch2     "Noise Channel Kit"                      lufs=-18 verb=0.05
twelvebit   ch3     "Twelve-Bit Crate Kit"                   lufs=-18 verb=0.05
mainframe   ch4     "Mainframe Hall"                         lufs=-19 verb=0.1
teletype    ch5     "Teletype 33"                            lufs=-20 pan=8 echo=0.2 verb=0.25
message     ch6     "Message Center"                         lufs=-25 pan=-24 echo=0.3 verb=0.4
cardroom    ch7     "Card Room"                              lufs=-23 pan=24 echo=0.2 verb=0.3
echochamber ch8     "Echo Chamber Kit"                       lufs=-19 verb=0.2

[dna]
