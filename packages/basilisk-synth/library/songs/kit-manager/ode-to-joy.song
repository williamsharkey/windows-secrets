# Ode to Joy: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Ode to Joy
pack     = kit-manager
kind     = world
composer = Ludwig van Beethoven (1770-1827)
source   = The "Ode to Joy" theme from the finale of Symphony No. 9, Op. 125 (1824), as a four-part hymn. Score: The Mutopia Project.
licence  = The work: public domain. The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=528
arranger = Algorithmic Industries house band
note     = Four verses in D, each over another kit (Punch Kick, Twelve-Bit Crate, Breaker Box, Assembly Line), between the Rain Clock kit; the tune on Calculator Bureau and Typing Pool's tuned keys, the alto on Signal Bells, the bass on Relay Room. Every sound is a Kit Manager 98 kit.
midi     = ode-to-joy.mid
script   = ode-to-joy.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -5

[reverb]
size     = 1.8
predelay = 15
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
calculator  ch1     "Calculator Bureau"                      lufs=-19 pan=6 echo=0.2 verb=0.3
typingpool  ch2     "Typing Pool"                            lufs=-21 pan=24 echo=0.15 verb=0.25
signalbells ch3     "Signal Bells"                           lufs=-24 pan=-22 echo=0.2 verb=0.35
relayroom   ch4     "Relay Room"                             lufs=-22 pan=-4 verb=0.15
punchkick   ch5     "Punch Kick Kit"                         lufs=-18 verb=0.06
swingpad    ch6     "Twelve-Bit Crate Kit"                   lufs=-18 verb=0.06
bigbreak    ch7     "Breaker Box Kit"                        lufs=-18 verb=0.06
assembly    ch8     "Assembly Line Kit"                      lufs=-18 verb=0.06
rainclock   ch9     "Rain Clock Kit"                         lufs=-20 verb=0.2

