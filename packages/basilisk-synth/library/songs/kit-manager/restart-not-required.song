# Restart Not Required: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Restart Not Required
pack     = kit-manager
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = A drum-kit showcase in C major, 116 bpm, eight kits: Rain Clock, Breaker Box, Half-Time and Twelve-Bit Crate take turns; Calculator Bureau, Signal Bells and Typing Pool play the tune and chords on their tuned keys, Relay Room plays a relay line. Every sound is a Kit Manager 98 kit.
midi     = restart-not-required.mid
script   = restart-not-required.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -5

[reverb]
size     = 1.8
predelay = 15
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
rainclock   ch1     "Rain Clock Kit"                         lufs=-19 verb=0.2
bigbreak    ch2     "Breaker Box Kit"                        lufs=-17 verb=0.06
halftime808 ch3     "Half-Time Kit"                          lufs=-18 verb=0.08
swingpad    ch4     "Twelve-Bit Crate Kit"                   lufs=-19 pan=-10 verb=0.08
calculator  ch5     "Calculator Bureau"                      lufs=-19 pan=8 echo=0.2 verb=0.3
signalbells ch6     "Signal Bells"                           lufs=-23 pan=-22 echo=0.2 verb=0.35
typingpool  ch7     "Typing Pool"                            lufs=-23 pan=26 echo=0.15 verb=0.25
relayroom   ch8     "Relay Room"                             lufs=-22 pan=-4 verb=0.15

[dna]
