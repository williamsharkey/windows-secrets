# Fur Elise: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Fur Elise
pack     = beat-management
kind     = world
composer = Ludwig van Beethoven (1770-1827)
source   = Bagatelle No. 25 in A minor, WoO 59, "Fur Elise" (1810, first published 1867). Score: The Mutopia Project, from Breitkopf & Hartel (1888).
licence  = The work: public domain. The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=931
arranger = Algorithmic Industries house band
note     = A lo-fi beat in 6/8 at 100 bpm, the whole bagatelle: upright piano, tines on the left hand, vibes, a flute in the F major episode, strings under the stormy part, the choir at the end, upright bass, rain and scratches. Drums: Kit Manager 98 (Twelve-Bit Crate Kit).
midi     = fur-elise.mid
script   = fur-elise.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 2500
level    = -6

[reverb]
size     = 1.6
predelay = 15
tone     = 4500
level    = -6

[tracks]
# name      source  preset                                  mix
piano       ch1     "Cedar Study"                            lufs=-19 pan=-8 verb=0.25 lp=9000
tines       ch2     "Wide Flick"                             lufs=-23 pan=16 verb=0.25
vibes       ch3     "Study Vibes"                            lufs=-25 pan=26 echo=0.2 verb=0.3 tune=-17
bass        ch4     "Upright Thump"                          lufs=-20
flute       ch5     "Civic Wire"                             lufs=-21 pan=6 echo=0.2 verb=0.3
strings     ch6     "Golden Section"                         lufs=-25 pan=-20 verb=0.35
rain        ch7     "Window Rain Room"                       lufs=-31 width=1.4
scratch     ch8     "Desk Scratch"                           lufs=-25 pan=-8
choir       ch9     "Winter Choir"                           lufs=-27 verb=0.45 width=1.3
kit         ch10    "kit-manager:Twelve-Bit Crate Kit"       lufs=-18 verb=0.06

