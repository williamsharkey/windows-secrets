# Cover Mount (Issue 14): a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Cover Mount (Issue 14)
pack     = beat-management
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Lo-fi boom bap, 88 bpm, swung: rain on the window, upright-piano loop, upright bass, vibes, flute hook, violins, desk scratches, a choir at the end. Drums: Kit Manager 98 (Twelve-Bit Crate Kit).
midi     = cover-mount-issue-14.mid
script   = cover-mount-issue-14.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 1/8
feedback = 0.3
tone     = 2500
level    = -5

[reverb]
size     = 1.5
predelay = 15
tone     = 4500
level    = -6

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Twelve-Bit Crate Kit"       lufs=-17 verb=0.06
bass        ch2     "Upright Thump"                          lufs=-19
piano       ch3     "Cedar Study"                            lufs=-21 pan=-14 verb=0.25 lp=9000
vibes       ch4     "Study Vibes"                            lufs=-23 pan=24 echo=0.2 verb=0.3 tune=-17
flute       ch5     "Civic Wire"                             lufs=-20 pan=8 echo=0.25 verb=0.3
strings     ch6     "Golden Section"                         lufs=-25 pan=-20 verb=0.35
rain        ch7     "Window Rain Room"                       lufs=-31 width=1.4
scratch     ch8     "Desk Scratch"                           lufs=-24 pan=-8
choir       ch9     "Winter Choir"                           lufs=-26 verb=0.45 width=1.3
ep          ch11    "Wide Flick"                             lufs=-22 pan=-10 echo=0.15 verb=0.25

[dna]
