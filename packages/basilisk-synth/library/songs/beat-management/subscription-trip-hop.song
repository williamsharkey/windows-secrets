# Subscription (Trip-Hop Edition): a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Subscription (Trip-Hop Edition)
pack     = beat-management
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE1993)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Trip-hop in D minor, 82 bpm: a slow heavy break, the long-boom glide bass, noir strings, a tremolo erhu, felt-ding piano, the flute line, a choir, scratches, a floor murmur and a bell coda. Drums: Kit Manager 98 (Twelve-Bit Crate Kit).
midi     = subscription-trip-hop.mid
script   = subscription-trip-hop.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.35
tone     = 2500
level    = -5

[reverb]
size     = 2.2
predelay = 20
tone     = 4500
level    = -4

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Twelve-Bit Crate Kit"       lufs=-17 verb=0.08
bass        ch1     "Long Boom Glide"                        lufs=-19 tune=-56
strings     ch2     "Noir Strings"                           lufs=-24 pan=-16 verb=0.4 width=1.3
erhu        ch3     "Dusk Tremolo"                           lufs=-22 pan=16 echo=0.15 verb=0.35
piano       ch4     "Felt Ding Piano"                        lufs=-22 pan=-10 verb=0.3 tune=-17
flute       ch5     "Flute Loop Lead"                        lufs=-20 pan=6 echo=0.2 verb=0.35
murmur      ch6     "Steady Murmur"                          lufs=-31 width=1.4
bell        ch7     "Dusty Vibes"                            lufs=-23 pan=24 echo=0.25 verb=0.4
choir       ch8     "Night Choir Pad"                        lufs=-26 verb=0.45 width=1.3
scratch     ch9     "Desk Scratch"                           lufs=-25 pan=-8

[dna]
