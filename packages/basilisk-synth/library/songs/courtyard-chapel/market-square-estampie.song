"courtyard-chapel:Pewter Gong" = hand_chime_c3E#3L80Z36,72,60/hand_chime_c5#3L80Z73,90,84/hand_chime_c6#3L80Z91,103,96/tubular_bell_c3#3L55Z36,53,48/tubular_bell_as3#2L55Z54,59,58/tubular_bell_c4#2L55Z60,96,60;A2D655S12R1197V85K60G-1
