# Market Square Estampie: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Market Square Estampie
pack     = courtyard-chapel
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE1993)
licence  = CC0-1.0 (the composition and this arrangement)
note     = A medieval-style estampie in D Mixolydian, 6/8: three puncta each played with open and closed endings, on dan tranh and psaltery over a didgeridoo bourdon, strumstick, balafon tabor, mbira, kalimba, hand chimes and a gong.
midi     = market-square-estampie.mid
script   = market-square-estampie.py

[master]
loudness = -16
ceiling  = -1.0

[echo]
time     = 3/8
feedback = 0.3
tone     = 3000
level    = -5

[reverb]
size     = 2.6
predelay = 24
tone     = 5000
level    = -3

[tracks]
# name      source  preset                                  mix
dantranh    ch1     "Chrome Pick"                            lufs=-19 pan=-14 verb=0.3
psaltery    ch2     "Amber Ticks"                            lufs=-20 pan=14 echo=0.05 verb=0.32
strumstick  ch3     "Floor Harp"                             lufs=-23 pan=-6 verb=0.15
drone       ch4     "Hotel Uplink"                           lufs=-28 verb=0.35 tune=-23
tabor       ch5     "Field Carillon"                         lufs=-24 pan=-30 verb=0.25
mbira       ch6     "Vinyl Pizz"                             lufs=-24 pan=26 echo=0.1 verb=0.3
kalimba     ch7     "Vinyl Pizz"                             lufs=-26 pan=32 echo=0.2 verb=0.35
bells       ch8     "Pewter Gong"                            lufs=-25 pan=20 echo=0.15 verb=0.45
gong        ch9     "Faded Gong"                             lufs=-26 verb=0.5

[dna]
# the presets' DNA when this song was written (used before the pack discs' own)
"courtyard-chapel:Amber Ticks" = psaltery_pluck_c4E#8Z36,78,72/psaltery_pluck_c5E#8Z79,96,84;A1D208S7R217V91K60
"courtyard-chapel:Chrome Pick" = dan_tranh_b1#4Z35,53,47/dan_tranh_b2#4Z54,65,59/dan_tranh_b3#4Z66,76,71/dan_tranh_b4#4Z77,96,83;A2D204S29R71V78K60G-2
"courtyard-chapel:Faded Gong" = nepalese_bell_b<<<H0,12;A3D2497S21R946V90K59G-5
"courtyard-chapel:Field Carillon" = balafon_cs3#6Z36,66,61/balafon_c4E#5Z67,77,72/balafon_c5E#5Z78,96,84;A0D2520S25R1903V75K60G2
"courtyard-chapel:Floor Harp" = strumstick_d2#8Z36,52,50/strumstick_g2E#8Z53,96,55;A2D103S2R64V99K60G1
