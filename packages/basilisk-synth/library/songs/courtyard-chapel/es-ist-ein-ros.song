# Es ist ein' Ros entsprungen: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Es ist ein' Ros entsprungen
pack     = courtyard-chapel
kind     = world
composer = German traditional (16th century)
source   = Es ist ein' Ros entsprungen, a German carol first printed in the Speierisches Gebetbuch (1599), in a four-part hymn setting. Score: The Mutopia Project.
licence  = The work: traditional, public domain (16th century). The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=1240
arranger = Algorithmic Industries house band
note     = The carol three times: the tune on psaltery, folk harp and dan tranh in turn, the lower voices on the harpsichord, hand chimes on the alto, a strumstick bass and a didgeridoo bourdon.
midi     = es-ist-ein-ros.mid
script   = es-ist-ein-ros.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3200
level    = -6

[reverb]
size     = 2.4
predelay = 20
tone     = 5500
level    = -5

[tracks]
# name      source  preset                                  mix
psaltery    ch1     "Slate Pick"                             lufs=-19 pan=8 verb=0.35
harp        ch2     "Faded Pluck"                            lufs=-20 pan=24 verb=0.35
dantranh    ch3     "Arctic Steps"                           lufs=-20 pan=-18 verb=0.3
harpsichord ch4     "Soft Etude"                             lufs=-23 pan=-28 verb=0.25
bells       ch5     "Noble Ring"                             lufs=-25 pan=20 verb=0.45 tune=16
strumstick  ch6     "Kinetic Harp"                           lufs=-23 pan=-6 verb=0.15
drone       ch7     "White Dormant"                          lufs=-29 verb=0.35

[dna]
# the presets' DNA when this song was written (used before the pack discs' own)
"courtyard-chapel:Arctic Steps" = dan_tranh_b2#16;A2D201S4R139V84K59
"courtyard-chapel:Faded Pluck" = folk_harp_c3#16;A2D416S4R83V75K60G-2
"courtyard-chapel:Kinetic Harp" = strumstick_g2#16;A2D155S8R154V96K55
"courtyard-chapel:Noble Ring" = hand_chime_c3#8L80/tubular_bell_c4#8L55;A1D1007S26R2356V83K60G-4
"courtyard-chapel:Slate Pick" = psaltery_pluck_c4#15/defaultRE#2T9L10O53Q26;A2D201S2R136V78K72G-1
"courtyard-chapel:Soft Etude" = harpsichord_flemish_c3#16;A4D2188S37R474V71K60G-8
"courtyard-chapel:White Dormant" = didgeridoo_sus_a>>#13U4~18/didgeridoo_phrase#3T-3L41;A769D0S100R836V93K61G-6
