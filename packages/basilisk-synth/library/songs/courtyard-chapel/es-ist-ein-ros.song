# Es ist ein' Ros entsprungen: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Es ist ein' Ros entsprungen
pack     = courtyard-chapel
kind     = world
composer = German traditional (16th century)
source   = Es ist ein' Ros entsprungen, a German carol first printed in the Speierisches Gebetbuch (1599), in a four-part hymn setting. Score: The Mutopia Project.
licence  = The work: traditional, public domain (16th century). The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=1240
arranger = Algorithmic Industries house band
note     = The carol three times: the tune on psaltery, folk harp and dan tranh in turn, the lower voices on the harpsichord, hand chimes on the alto, a strumstick bass and a didgeridoo bourdon.
midi     = es-ist-ein-ros.mid
script   = es-ist-ein-ros.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3200
level    = -6

[reverb]
size     = 2.4
predelay = 20
tone     = 5500
level    = -5

[tracks]
# name      source  preset                                  mix
psaltery    ch1     "Amber Ticks"                            lufs=-19 pan=8 verb=0.35
harp        ch2     "Glass Spool"                            lufs=-20 pan=24 verb=0.35
dantranh    ch3     "Chrome Pick"                            lufs=-20 pan=-18 verb=0.3
harpsichord ch4     "Brass Ballad"                           lufs=-23 pan=-28 verb=0.25
bells       ch5     "Orbital Ring"                           lufs=-25 pan=20 verb=0.45
strumstick  ch6     "Floor Harp"                             lufs=-23 pan=-6 verb=0.15
drone       ch7     "Hotel Uplink"                           lufs=-29 verb=0.35 tune=-23

[dna]
# the presets' DNA when this song was written (used before the pack discs' own)
"courtyard-chapel:Amber Ticks" = psaltery_pluck_c4E#8Z36,78,72/psaltery_pluck_c5E#8Z79,96,84;A1D208S7R217V91K60
"courtyard-chapel:Brass Ballad" = harpsichord_flemish_c2E#4Z36,54,48/harpsichord_flemish_c3#4Z55,66,60/harpsichord_flemish_c4#4Z67,78,72/harpsichord_flemish_c5#4Z79,96,84;A0D625S16R438V96K60G-1
"courtyard-chapel:Chrome Pick" = dan_tranh_b1#4Z35,53,47/dan_tranh_b2#4Z54,65,59/dan_tranh_b3#4Z66,76,71/dan_tranh_b4#4Z77,96,83;A2D204S29R71V78K60G-2
"courtyard-chapel:Floor Harp" = strumstick_d2#8Z36,52,50/strumstick_g2E#8Z53,96,55;A2D103S2R64V99K60G1
"courtyard-chapel:Glass Spool" = folk_harp_c2#4Z36,54,48/folk_harp_c3#4Z55,65,60/folk_harp_c4E#4Z66,77,72/folk_harp_c5#4Z78,96,84;A0D169S1R254V97K60G-2
