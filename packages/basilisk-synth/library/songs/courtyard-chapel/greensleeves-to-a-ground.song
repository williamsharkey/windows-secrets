# Greensleeves to a Ground: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Greensleeves to a Ground
pack     = courtyard-chapel
kind     = world
composer = Anonymous (English, 16th century tune)
source   = Greensleeves to a Ground, with divisions: The Division Violin, second part (John Playford, 4th edition, 1705), No. 27. Score: The Mutopia Project, from the 1705 facsimile.
licence  = The work: public domain (published 1705). The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=1730
arranger = Algorithmic Industries house band
note     = The tune and five divisions on psaltery, folk harp and dan tranh, the vibes doubling the last; a harpsichord continuo and strumstick bass on a ground read from the tune; a didgeridoo bourdon, balafon tabor, hand chimes at the cadences; a Picardy G major at the end.
midi     = greensleeves-to-a-ground.mid
script   = greensleeves-to-a-ground.py

[master]
loudness = -16
ceiling  = -1.0

[echo]
time     = 3/8
feedback = 0.3
tone     = 3000
level    = -5

[reverb]
size     = 2.6
predelay = 24
tone     = 5000
level    = -3

[tracks]
# name      source  preset                                  mix
psaltery    ch1     "Amber Ticks"                            lufs=-19 pan=6 echo=0.05 verb=0.32
harp        ch2     "Glass Spool"                            lufs=-20 pan=26 echo=0.1 verb=0.3
dantranh    ch3     "Chrome Pick"                            lufs=-20 pan=-20 verb=0.3
harpsichord ch4     "Brass Ballad"                           lufs=-23 pan=-30 verb=0.22
strumstick  ch5     "Floor Harp"                             lufs=-23 pan=-8 verb=0.15
drone       ch6     "Hotel Uplink"                           lufs=-29 verb=0.35 tune=-23
bells       ch7     "Pewter Gong"                            lufs=-25 pan=22 echo=0.15 verb=0.45
tabor       ch8     "Field Carillon"                         lufs=-26 pan=-36 verb=0.25
vibes       ch9     "Pastel Bell"                            lufs=-27 pan=30 verb=0.35

[dna]
# the presets' DNA when this song was written (used before the pack discs' own)
