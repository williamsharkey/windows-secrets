# Banchieri, Registro 1 (chip arrangement): a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Banchieri, Registro 1 (chip arrangement)
pack     = courtyard-chapel
kind     = chiptune
composer = TheOuterLinux
source   = Banchieri_-_Reg_1, a Standard MIDI File (Banchieri_-_Reg_1.mid) from OpenGameArt (https://opengameart.org/sites/default/files/NES%20-%20Banchieri.zip). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/nes-or-gameboy-banchieri-reg-1
arranger = Algorithmic Industries house band
source_sha256= d638e2bb7c08a37883c2a7c2d49e5df68b06c6343b75df16dec28770986b27a0
note     = An NES and Game Boy arrangement of Adriano Banchieri's organ registro (1605) played on the courtyard's plucked strings: psaltery, folk harp, dan tranh and harpsichord, the composer's voices kept apart.
midi     = banchieri-registro.mid
script   = banchieri-registro.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
psaltery    ch1     "Amber Ticks"                            lufs=-20 pan=8 verb=0.32
harp        ch2     "Glass Spool"                            lufs=-21 pan=26 verb=0.3
dantranh    ch3     "Chrome Pick"                            lufs=-21 pan=-18 verb=0.3
harpsichord ch4     "Brass Ballad"                           lufs=-22 pan=-30 verb=0.22

[dna]
# the presets' DNA when this song was written (used before the pack discs' own)
"courtyard-chapel:Amber Ticks" = psaltery_pluck_c4E#8Z36,78,72/psaltery_pluck_c5E#8Z79,96,84;A1D208S7R217V91K60
"courtyard-chapel:Brass Ballad" = harpsichord_flemish_c2E#4Z36,54,48/harpsichord_flemish_c3#4Z55,66,60/harpsichord_flemish_c4#4Z67,78,72/harpsichord_flemish_c5#4Z79,96,84;A0D625S16R438V96K60G-1
"courtyard-chapel:Chrome Pick" = dan_tranh_b1#4Z35,53,47/dan_tranh_b2#4Z54,65,59/dan_tranh_b3#4Z66,76,71/dan_tranh_b4#4Z77,96,83;A2D204S29R71V78K60G-2
"courtyard-chapel:Glass Spool" = folk_harp_c2#4Z36,54,48/folk_harp_c3#4Z55,65,60/folk_harp_c4E#4Z66,77,72/folk_harp_c5#4Z78,96,84;A0D169S1R254V97K60G-2
