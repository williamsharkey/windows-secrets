# Forest: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Forest
pack     = courtyard-chapel
kind     = chiptune
composer = Spring Spring
source   = Forest, an Impulse Tracker module (forestCLEAN.it) from OpenGameArt (https://opengameart.org/sites/default/files/OST.zip). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/haydenwoffle-it-soundtrack
arranger = Algorithmic Industries house band
source_sha256= 578ba7fa3d652d87383c16b039eb5db38550e1c2b945c499d5b725ba02d107eb
note     = Medieval-style: the module's forest harp on the folk harp, its flute on the psaltery, its bagpipe on the high harpsichord, its harpsiclavichord on the Flemish harpsichord, its war drum on the balafon tabor, its wind on a dan tranh glissando.
midi     = forest.mid
script   = forest.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
harp        ch1     "Glass Spool"                            lufs=-20 pan=20 echo=0.1 verb=0.3
psaltery    ch2     "Amber Ticks"                            lufs=-20 pan=-6 echo=0.05 verb=0.32
felt        ch3     "Arctic Salon"                           lufs=-22 pan=-20 verb=0.25
harpsichord ch4     "Brass Ballad"                           lufs=-22 pan=-30 verb=0.22
tabor       ch5     "Field Carillon"                         lufs=-23 pan=30 verb=0.25
warp        ch6     "Polished Dive"                          lufs=-27 verb=0.4

[dna]
# the presets' DNA when this song was written (used before the pack discs' own)
"courtyard-chapel:Amber Ticks" = psaltery_pluck_c4E#8Z36,78,72/psaltery_pluck_c5E#8Z79,96,84;A1D208S7R217V91K60
"courtyard-chapel:Arctic Salon" = harpsichord_flemish_hi_cs3#5Z36,72,61/harpsichord_flemish_hi_c5#4Z73,89,84/harpsichord_flemish_hi_c6#5Z90,102,96/dingxpRE#2T-7L17O84Q10;A3D1531S33R417V82K60G-6
"courtyard-chapel:Brass Ballad" = harpsichord_flemish_c2E#4Z36,54,48/harpsichord_flemish_c3#4Z55,66,60/harpsichord_flemish_c4#4Z67,78,72/harpsichord_flemish_c5#4Z79,96,84;A0D625S16R438V96K60G-1
