# The Leaning Cloister Galliard: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = The Leaning Cloister Galliard
pack     = courtyard-chapel
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = A galliard in D Dorian, 3/4, with hemiola cadences: psaltery, harpsichord continuo, folk harp, strumstick, didgeridoo bourdon, hand-chime and tubular bells, balafon tabor.
midi     = galliard-leaning-cloister.mid
script   = galliard-leaning-cloister.py

[master]
loudness = -16
ceiling  = -1.0

[echo]
time     = 3/8
feedback = 0.3
tone     = 3000
level    = -4

[reverb]
size     = 2.6
predelay = 24
tone     = 5000
level    = -3

[tracks]
# name      source  preset                                  mix
psaltery    ch1     "Amber Ticks"                            lufs=-19 pan=8 echo=0.05 verb=0.32
harpsi      ch2     "Brass Ballad"                           lufs=-22 pan=-28 verb=0.22
harp        ch3     "Glass Spool"                            lufs=-24 pan=34 echo=0.12 verb=0.3
strum       ch4     "Floor Harp"                             lufs=-23 pan=-8 verb=0.15
drone       ch5     "Hotel Uplink"                           lufs=-28 pan=0 verb=0.35 tune=-23
bells       ch6     "Pewter Gong"                            lufs=-24 pan=22 echo=0.15 verb=0.45
tabor       ch7     "Field Carillon"                         lufs=-25 pan=-36 verb=0.25
swoosh      ch8     "Polished Dive"                          lufs=-28 pan=0 echo=0.3 verb=0.5

[dna]
# the presets' DNA when this song was written (used before the pack discs' own)
"courtyard-chapel:Amber Ticks" = psaltery_pluck_c4E#8Z36,78,72/psaltery_pluck_c5E#8Z79,96,84;A1D208S7R217V91K60
"courtyard-chapel:Brass Ballad" = harpsichord_flemish_c2E#4Z36,54,48/harpsichord_flemish_c3#4Z55,66,60/harpsichord_flemish_c4#4Z67,78,72/harpsichord_flemish_c5#4Z79,96,84;A0D625S16R438V96K60G-1
"courtyard-chapel:Field Carillon" = balafon_cs3#6Z36,66,61/balafon_c4E#5Z67,77,72/balafon_c5E#5Z78,96,84;A0D2520S25R1903V75K60G2
"courtyard-chapel:Floor Harp" = strumstick_d2#8Z36,52,50/strumstick_g2E#8Z53,96,55;A2D103S2R64V99K60G1
