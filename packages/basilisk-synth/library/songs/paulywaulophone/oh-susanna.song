# Oh! Susanna: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Oh! Susanna
pack     = paulywaulophone
kind     = world
composer = Stephen Foster (1826-1864)
source   = Oh! Susanna, song (1848): verse and chorus, written out from the song.
licence  = The work: public domain (published 1848; the composer died 1864). This arrangement: CC0-1.0; sounds by Paul Chauncy.
proof    = https://en.wikipedia.org/wiki/Oh!_Susanna
arranger = Algorithmic Industries house band
note     = An office singalong at 116 bpm: six rounds of verse and chorus, the hum from the back row, office piano, the bass from Accounts, guitar, the sax, the bee-buzzing organ, the doo-doo choir, boops, a glockenspiel and a tuning fork; up a tone for the last two rounds. Drums: the pack's Honey Drift kit.
midi     = oh-susanna.mid
script   = oh-susanna.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 1/8
feedback = 0.25
tone     = 3000
level    = -7

[reverb]
size     = 1.8
predelay = 18
tone     = 5500
level    = -5

[tracks]
# name      source  preset                                  mix
hum         ch1     "Electric Vox"                           lufs=-19 pan=4 verb=0.3
piano       ch2     "Humid Practice"                         lufs=-21 pan=-14 verb=0.25
bass        ch3     "Wired Anchor"                           lufs=-20
sax         ch4     "Dial Beam"                              lufs=-21 pan=-20 echo=0.1 verb=0.3
organ       ch5     "Mint Voice"                             lufs=-23 pan=20 verb=0.2 tune=-21
doo         ch6     "Remote Haze"                            lufs=-25 pan=-6 verb=0.35 width=1.3
glock       ch7     "Orbital Beam"                           lufs=-24 pan=28 echo=0.2 verb=0.35
boop        ch8     "Humid Chop"                             lufs=-26 pan=-30 echo=0.25
guitar      ch9     "Night Ballad"                           lufs=-25 pan=32 verb=0.2 tune=-14
kit         ch10    "Honey Drift"                            lufs=-18 verb=0.08
chorus      ch11    "Felt Chorus"                            lufs=-22 pan=10 verb=0.4
fork        ch12    "Winter Chimes"                          lufs=-25 verb=0.4

