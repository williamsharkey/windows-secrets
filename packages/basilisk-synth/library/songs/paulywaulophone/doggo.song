# Doggo: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Doggo
pack     = paulywaulophone
kind     = chiptune
composer = Spring Spring
source   = Doggo, an Impulse Tracker module (doggoCLEAN.it) from OpenGameArt (https://opengameart.org/sites/default/files/OST.zip). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/haydenwoffle-it-soundtrack
arranger = Algorithmic Industries house band
source_sha256= 9362e4128d8fa85cafc44198b66ecc801fe6c3cf60999d3fadd86a237d1aea5a
note     = The module's piano, organ, sax and bass parts on the office piano, the bee-buzzing organ, the sax and the bass from Accounts; its second organ on the hum from the back row; its woofs on the boop. Sounds by Paul Chauncy.
midi     = doggo.mid
script   = doggo.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
piano       ch1     "Humid Practice"                         lufs=-19 pan=-12 verb=0.25
organ       ch2     "Mint Voice"                             lufs=-23 pan=18 verb=0.2 tune=-21
sax         ch3     "Dial Beam"                              lufs=-21 pan=-20 echo=0.1 verb=0.3
bass        ch4     "Wired Anchor"                           lufs=-20
hum         ch5     "Electric Vox"                           lufs=-23 pan=6 verb=0.3
boop        ch6     "Humid Chop"                             lufs=-25 pan=30 echo=0.2

