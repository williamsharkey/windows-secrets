# Old Hundredth: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Old Hundredth
pack     = electromech-heritage
kind     = world
composer = Louis Bourgeois (attributed), Genevan Psalter (1551)
source   = Old Hundredth (Psalm 134 in the Genevan Psalter, 1551), the original rhythm, in four parts. Score: The Mutopia Project.
licence  = The work: public domain (published 1551). The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=194
arranger = Algorithmic Industries house band
note     = The psalm tune twice for the telephone exchange: the 1961 vowel and then the CSIRAC pulse on the melody, sounder keys and a relay marimba on the inner and lower voices, a Ferranti-hoot bass, the dial-tone organ. Drums: Kit Manager 98 (Relay Room).
midi     = old-hundredth.mid
script   = old-hundredth.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3200
level    = -6

[reverb]
size     = 2.4
predelay = 20
tone     = 5500
level    = -5

[tracks]
# name      source  preset                                  mix
vowel       ch1     "1961 Vowel"                             lufs=-19 pan=4 echo=0.15 verb=0.35
pulse       ch2     "CSIRAC Pulse"                           lufs=-20 pan=10 echo=0.2
sounder     ch3     "Sounder Keys"                           lufs=-25 pan=-16 verb=0.2
marimba     ch4     "Relay Marimba"                          lufs=-23 pan=-20 verb=0.2
hootbass    ch5     "Ferranti Hoot"                          lufs=-20
organ       ch6     "Dial Tone Organ"                        lufs=-26 pan=18 verb=0.3
kit         ch10    "kit-manager:Relay Room"                 lufs=-21 verb=0.08

[dna]
# the presets' DNA when this song was written (used before the pack discs' own)
"electromech-heritage:1961 Vowel" = ems_704_vowel_a3#12U3~8;A40R400V70K57G-17
"electromech-heritage:CSIRAC Pulse" = ems_csirac_pulse_e4#16;A2R80V60K64G-3
"electromech-heritage:Dial Tone Organ" = ems_dial_toneRJa0,0.60,100;R400V40K69G-14
"electromech-heritage:Ferranti Hoot" = ems_ferranti_hoot_c4Ja0,100.563,54.1420,25;A3R60V60G-5
"electromech-heritage:Relay Marimba" = ems_relay_marimba_c4E#11U2~4L78/ems_relay_release#5FL40Q25;R350V95G-3
"electromech-heritage:Sounder Keys" = ems_fm_sounder_c4#8/glockenspiel_c6#8L34O21Q5;R305V90G1
"kit-manager:Relay Room" = ems_relay_pull@t30000Iems_relay_release@t30000Iems_relay_pair@t30000Iems_relay_bouncy@t30000Iems_relay_tiny@t30000Iems_contactor_pull@t30000Iems_contactor_release@t30000Iem_relay_click_a@t30000Iem_relay_click_b@t30000Iem_relay_hs_a@t30000Iem_relay_large_a@t30000Iem_contactor_a#10/ems_relay_rack_chatter#2/ems_relay_buzz_ac#2/ems_relay_mallet_c5#2;R200V90k36j6k37j7k38j1y1,100k38j4i120y101,127k39j2k40j3k41j5k42j8h70k43j9h130k44j10k45j11k46j12k47l2gc1k48l3gc1k60,72l4r72p100w12
