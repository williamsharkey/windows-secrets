# Teleprinter Polka: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Teleprinter Polka
pack     = electromech-heritage
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = A polka in B-flat, 2/4: a Ferranti-hoot bass, relay-marimba and sounder-key oom-pah, the CSIRAC pulse and the typewriter bell on the tune, the exchange ringer and relay mallet on the trio, the teleprinter kit, a contact spring and the newsroom teleprinter. Drums: Kit Manager 98 (Teletype 33).
midi     = teleprinter-polka.mid
script   = teleprinter-polka.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 1/8
feedback = 0.2
tone     = 3000
level    = -9

[reverb]
size     = 1.6
predelay = 12
tone     = 5000
level    = -6

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Teletype 33"                lufs=-21 verb=0.1
hootbass    ch1     "Ferranti Hoot"                          lufs=-20
marimba     ch2     "Relay Marimba"                          lufs=-23 pan=-20 verb=0.2
sounder     ch3     "Sounder Keys"                           lufs=-26 pan=18 verb=0.2
pulse       ch4     "CSIRAC Pulse"                           lufs=-20 pan=6 echo=0.15 verb=0.15
typebell    ch5     "Teletype Bell Keyboard"                 lufs=-22 pan=-10 verb=0.3
ringer      ch6     "Exchange Ringer"                        lufs=-22 pan=10 verb=0.35
mallet      ch7     "Relay Mallet"                           lufs=-23 pan=24 verb=0.25
news        ch8     "Newsroom"                               lufs=-25 pan=-24
spring      ch9     "Contact Spring"                         lufs=-25 verb=0.3

[dna]
# the presets' DNA when this song was written (used before the pack discs' own)
"electromech-heritage:CSIRAC Pulse" = ems_csirac_pulse_e4#16;A2R80V60K64G-3
"electromech-heritage:Contact Spring" = ems_ks_spring_g3#12U2~5/ems_relay_release#4FL35;R350V90K55G-6
"electromech-heritage:Exchange Ringer" = ems_exchange_bell_c4#12H0,12L85/ems_relay_pull#4FL35;R1800V80G-4
"electromech-heritage:Ferranti Hoot" = ems_ferranti_hoot_c4Ja0,100.563,54.1420,25;A3R60V60G-5
"electromech-heritage:Newsroom" = ems_tty_burst#8FQ-40Ja0,0.200,100/em_tty_machine_loop#8FL70Q40;R800V60G-4
"electromech-heritage:Relay Mallet" = ems_relay_mallet_c5#12/ems_relay_pull#4FL55Q-25;A0R450V90K72G-3
"electromech-heritage:Relay Marimba" = ems_relay_marimba_c4E#11U2~4L78/ems_relay_release#5FL40Q25;R350V95G-3
"electromech-heritage:Sounder Keys" = ems_fm_sounder_c4#8/glockenspiel_c6#8L34O21Q5;R305V90G1
"electromech-heritage:Teletype Bell Keyboard" = ems_ttybell_g5#12/ems_selector_magnet#4FL45;R900V85K79G-5
"kit-manager:Teletype 33" = ems_tty_char@t30000Iems_tty_cr@t30000Iems_tty_lf@t30000Iems_selector_magnet@t30000Iems_tty_bell@t30000Iems_typebar@t30000Iem_tty_machine_hit_a@t30000Iem_tty_machine_hit_b#9/ems_tty_motor_start#2/ems_tty_motor_stop#1/ems_tty_burst#2/ems_tape_punch_burst#2;R200V90k36j2k37j3k38j1k39j7k40j8k41j4k42j6k44l2c2k45l3c2k46l4gc1k47l5gc1k72,84j5r78p100w7
