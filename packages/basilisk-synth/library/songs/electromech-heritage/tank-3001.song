# Tank 3001: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Tank 3001
pack     = electromech-heritage
kind     = chiptune
composer = Spring Spring
source   = Tank 3001, a 0CC-FamiTracker module (Coding_Pirates_Showcase_OST_3_2a03.0cc) from OpenGameArt (https://opengameart.org/sites/default/files/Guropper.zip). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/guropper
arranger = Algorithmic Industries house band
source_sha256= 5cfdc3475f49dc5d3f352a9a6be67d21dd4209d35ddb7077c85fe7e3769f1ace
note     = Played four times through: the NES module's pulse 1 on the Ferranti hoot, pulse 2 on the CSIRAC pulse, the triangle on the relay marimba, the noise on Kit Manager 98 (Solenoid Lab).
midi     = tank-3001.mid
script   = tank-3001.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
hootbass    ch1     "Ferranti Hoot"                          lufs=-19
pulse       ch2     "CSIRAC Pulse"                           lufs=-20 pan=8 echo=0.2
marimba     ch3     "Relay Marimba"                          lufs=-22 pan=-18 verb=0.2
kit         ch10    "kit-manager:Solenoid Lab"               lufs=-20 verb=0.08

[dna]
# the presets' DNA when this song was written (used before the pack discs' own)
"electromech-heritage:CSIRAC Pulse" = ems_csirac_pulse_e4#16;A2R80V60K64G-3
"electromech-heritage:Ferranti Hoot" = ems_ferranti_hoot_c4Ja0,100.563,54.1420,25;A3R60V60G-5
"electromech-heritage:Relay Marimba" = ems_relay_marimba_c4E#11U2~4L78/ems_relay_release#5FL40Q25;R350V95G-3
"kit-manager:Solenoid Lab" = ems_relay_pull@t30000Iems_relay_release@t30000Iems_relay_bouncy@t30000Iems_contactor_pull@t30000Iems_contactor_release@t30000Iems_print_hammer@t30000Iems_punch_magnet@t30000Iems_flipdot@t30000Iems_stepper_step@t30000Iem_solenoid12v_a@t30000Iem_solenoid_sw_a@t30000Iem_kontaktor_a@t30000Iem_relay_large_b@t30000Iem_metal_click_a@t30000Iem_switch_a@t30000Iems_clutch_trip#12/ems_relay_buzz_ac#2/ems_splitflap#2;R200V90k36j4u1k37j5k38j1y1,95k38j3y96,127k39j2k40j6k41j7k42j8k43j9k44j10k45j11k46j12k47j13k48j14k49j15k50j16k51l2gc1k52l3k60,64j1r63p100w2
