# Daisy Bell: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Daisy Bell
pack     = electromech-heritage
kind     = world
composer = Harry Dacre (1857-1922)
source   = Daisy Bell (Bicycle Built for Two), song (1892): the first strain of the chorus, written out from the song.
licence  = The work: public domain (published 1892; the composer died 1922). This arrangement: CC0-1.0.
proof    = https://en.wikipedia.org/wiki/Daisy_Bell
arranger = Algorithmic Industries house band
note     = A waltz at 120 bpm, the chorus's first strain four times: the 1961 vowel voice, a relay-marimba oom-pah-pah, a Ferranti-hoot bass, the CSIRAC pulse, exchange ringer, typewriter bell, dial-tone organ, sounder keys, a motor drone. Drums: Kit Manager 98 (Teletype 33).
midi     = daisy-bell.mid
script   = daisy-bell.py

[master]
loudness = -16
ceiling  = -1.0

[echo]
time     = 1/4
feedback = 0.3
tone     = 3000
level    = -6

[reverb]
size     = 1.8
predelay = 15
tone     = 5000
level    = -5

[tracks]
# name      source  preset                                  mix
vowel       ch1     "1961 Vowel"                             lufs=-19 pan=4 echo=0.15 verb=0.35
marimba     ch2     "Relay Marimba"                          lufs=-23 pan=-20 verb=0.2
hootbass    ch3     "Ferranti Hoot"                          lufs=-21
pulse       ch4     "CSIRAC Pulse"                           lufs=-21 pan=12 echo=0.2 verb=0.15
ringer      ch5     "Exchange Ringer"                        lufs=-24 pan=-10 verb=0.4
typebell    ch6     "Typewriter Bell Keys"                   lufs=-26 pan=30 echo=0.3 verb=0.4
organ       ch7     "Dial Tone Organ"                        lufs=-26 pan=18 verb=0.3
motor       ch8     "Motor Room"                             lufs=-30 verb=0.2
kit         ch10    "kit-manager:Teletype 33"                lufs=-23 verb=0.1
sounder     ch9     "Sounder Keys"                           lufs=-26 pan=-16 verb=0.2

[dna]
# the presets' DNA when this song was written (used before the pack discs' own)
"electromech-heritage:1961 Vowel" = ems_704_vowel_a3#12U3~8;A40R400V70K57G-17
