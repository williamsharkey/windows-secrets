# Fernamt Bielefeld: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Fernamt Bielefeld
pack     = electromech-heritage
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Electro in A minor, 112 bpm: motor drone, relay rain, dial-tone organ, a Ferranti-hoot sequencer bass, relay-marimba arpeggios, the 1961 vowel, a CSIRAC pulse hook, exchange ringers, a party line and the newsroom teleprinter. Drums: Kit Manager 98 (Exchange).
midi     = fernamt-bielefeld.mid
script   = fernamt-bielefeld.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.35
tone     = 3000
level    = -4

[reverb]
size     = 1.8
predelay = 15
tone     = 5000
level    = -6

[tracks]
# name      source  preset                                  mix
kit         ch10    "kit-manager:Exchange"                   lufs=-17 verb=0.08
hootbass    ch2     "Ferranti Hoot"                          lufs=-19
marimba     ch3     "Relay Marimba"                          lufs=-23 pan=-22 echo=0.2 verb=0.2
vowel       ch4     "1961 Vowel"                             lufs=-20 pan=4 echo=0.15 verb=0.35
pulse       ch5     "CSIRAC Pulse"                           lufs=-21 pan=12 echo=0.25 verb=0.15
ringer      ch6     "Exchange Ringer"                        lufs=-24 pan=-10 verb=0.4
organ       ch7     "Dial Tone Organ"                        lufs=-26 pan=18 verb=0.3
motor       ch8     "Motor Room"                             lufs=-29 verb=0.2
rain        ch9     "Relay Rain"                             lufs=-28 pan=-30 verb=0.3
party       ch11    "Party Line"                             lufs=-26 verb=0.3
news        ch12    "Newsroom"                               lufs=-26 pan=20
typebell    ch13    "Typewriter Bell Keys"                   lufs=-26 pan=30 echo=0.3 verb=0.4
sounder     ch14    "Sounder Keys"                           lufs=-25 pan=-16 verb=0.2

[dna]
# the presets' DNA when this song was written (used before the pack discs' own)
