# The Fridge Is Hungry: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = The Fridge Is Hungry
pack     = leisure
kind     = chiptune
composer = congusbongus
source   = The fridge is hungry, a FastTracker 2 module (the_fridge_is_hungry.xm) from OpenGameArt (https://opengameart.org/sites/default/files/the_fridge_is_hungry.xm_.zip). Its notes are played here; its samples or chip voices are not used.
licence  = The music: CC0-1.0 (public-domain dedication on the OpenGameArt page). This arrangement: CC0-1.0.
proof    = https://opengameart.org/content/the-fridge-is-hungry
arranger = Algorithmic Industries house band
source_sha256= 2ef31100b67bfc79f565901dd8b8e67336da36c7251536b468339103267a9050
note     = Exotica at 119 bpm: the module's oboe on the lounge flute, its marimba, trumpet, tings and bells on the pack's marimba, solo, bells and glockenspiel, its bass on the cello, its bass drum, clave, cowbell and shaker on the pack's percussion.
midi     = the-fridge-is-hungry.mid
script   = the-fridge-is-hungry.py

[master]
loudness = -15
ceiling  = -1.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 3500
level    = -6

[reverb]
size     = 2.0
predelay = 16
tone     = 5500
level    = -6

[tracks]
# name      source  preset                                  mix
flute       ch1     "Polished Call"                          lufs=-20 pan=4 echo=0.15 verb=0.35
marimba     ch2     "Island Marimba"                         lufs=-22 pan=-20 verb=0.3
trumpet     ch3     "Tidal Solo"                             lufs=-22 pan=14 verb=0.3
bells       ch4     "Soft Bells"                             lufs=-25 pan=26 echo=0.2 verb=0.4
glock       ch5     "Late Toll"                              lufs=-26 pan=-28 verb=0.4
cello       ch6     "Opal Section"                           lufs=-21 verb=0.15
kick        ch7     "Grey Clack"                             lufs=-22
claves      ch8     "Steel Block"                            lufs=-27 pan=-30
cowbell     ch9     "Distant Knock"                          lufs=-27 pan=24
shaker      ch11    "Twilight Tap"                           lufs=-29 pan=32

