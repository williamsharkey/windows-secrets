# Volcano View Cha-Cha: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Volcano View Cha-Cha
pack     = leisure
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
note     = A lounge cha-cha in F, 118 bpm: claves, bongo taps and a scrape on the cha-cha-cha, vibes-bells and marimba on the tune, the tiki piano montuno, cello bass, strings, a lead in the bridge, a gong and a robin.
midi     = volcano-view-cha-cha.mid
script   = volcano-view-cha-cha.py

[master]
loudness = -16
ceiling  = -1.0

[echo]
time     = 3/8
feedback = 0.3
tone     = 2800
level    = -6

[reverb]
size     = 2.4
predelay = 22
tone     = 5000
level    = -4

[tracks]
# name      source  preset                                  mix
bells       ch1     "Soft Bells"                             lufs=-20 pan=8 echo=0.2 verb=0.4
piano       ch2     "Tiki Lounge Piano"                      lufs=-24 pan=-16 verb=0.3
cello       ch3     "Opal Section"                           lufs=-21 verb=0.15
strings     ch4     "White Cellos"                           lufs=-26 pan=14 verb=0.4 width=1.3
lead        ch5     "Granite Lead"                           lufs=-21 pan=-6 echo=0.15 verb=0.35 tune=-84
marimba     ch6     "Mint Ballad"                            lufs=-23 pan=-24 verb=0.3
claves      ch7     "Steel Block"                            lufs=-26 pan=-32
bongo       ch8     "Twilight Tap"                           lufs=-26 pan=30
guiro       ch9     "Grey Clack"                             lufs=-29 pan=18
gong        ch11    "Cedar Gong"                             lufs=-25 verb=0.5
bird        ch12    "Half-Speed Mockingbird"                 lufs=-28 pan=38 verb=0.4

