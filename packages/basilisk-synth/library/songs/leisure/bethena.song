# Bethena: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Bethena
pack     = leisure
kind     = world
composer = Scott Joplin (1868-1917)
source   = Bethena, a concert waltz (1905): the introduction and the first strains. Score: The Mutopia Project, from the original manuscript.
licence  = The work: public domain (published 1905; the composer died 1917). The edition used: public domain (Mutopia). This arrangement: CC0-1.0.
proof    = https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=463
arranger = Algorithmic Industries house band
note     = A lounge waltz at 138 bpm: vibes-bells then a flute on the tune, marimba on the inner voices, lounge piano on the left hand, cello bass, strings in the second half, brushes on two and three, crickets, a gong and bird calls.
midi     = bethena.mid
script   = bethena.py

[master]
loudness = -16
ceiling  = -1.0

[echo]
time     = 3/8
feedback = 0.3
tone     = 2800
level    = -6

[reverb]
size     = 2.6
predelay = 25
tone     = 5000
level    = -4

[tracks]
# name      source  preset                                  mix
bells       ch1     "Soft Bells"                             lufs=-20 pan=10 echo=0.2 verb=0.4
flute       ch2     "Polished Call"                          lufs=-20 pan=4 echo=0.15 verb=0.4
piano       ch3     "Tiki Lounge Piano"                      lufs=-24 pan=-18 verb=0.3
marimba     ch4     "Island Marimba"                         lufs=-26 pan=-26 verb=0.3
cello       ch5     "Opal Section"                           lufs=-22 verb=0.15
strings     ch6     "Volcano Strings"                        lufs=-25 pan=12 verb=0.4 width=1.3
brush       ch7     "Twilight Tap"                           lufs=-30 pan=30
crickets    ch8     "Mild Rain"                              lufs=-33 width=1.4
gong        ch9     "Cedar Gong"                             lufs=-25 verb=0.5
birds       ch11    "Half-Speed Mockingbird"                 lufs=-28 pan=38 verb=0.4

