# Complimentary Lanai: a SNDWAVE1993 song demo (tools/songrender/README.md has the format)

title    = Complimentary Lanai
pack     = leisure
kind     = original
composer = Algorithmic Industries house band (an original for SNDWAVE1993)
licence  = CC0-1.0 (the composition and this arrangement)
note     = Exotica lounge in C major, 96 bpm: crickets, bird calls and a gong, a beguine on claves and bongo taps, marimba, vibes-bells, lounge piano, strings, cello bass and a flute tune.
midi     = complimentary-lanai.mid
script   = complimentary-lanai.py

[master]
loudness = -16
ceiling  = -1.0

[echo]
time     = 3/8
feedback = 0.3
tone     = 2800
level    = -5

[reverb]
size     = 2.6
predelay = 25
tone     = 5000
level    = -4

[tracks]
# name      source  preset                                  mix
flute       ch1     "Polished Call"                          lufs=-20 pan=6 echo=0.15 verb=0.4
marimba     ch2     "Island Marimba"                         lufs=-23 pan=-22 verb=0.3
piano       ch3     "Tiki Lounge Piano"                      lufs=-25 pan=18 verb=0.3
strings     ch4     "Volcano Strings"                        lufs=-23 pan=-8 verb=0.4 width=1.3
cello       ch5     "Opal Section"                           lufs=-21 verb=0.15
bells       ch6     "Soft Bells"                             lufs=-24 pan=28 echo=0.25 verb=0.4
claves      ch7     "Steel Block"                            lufs=-27 pan=-34
bongo       ch8     "Twilight Tap"                           lufs=-26 pan=30
clap        ch9     "Golden Clap"                            lufs=-30 pan=-10 verb=0.3
crickets    ch11    "Mild Rain"                              lufs=-32 width=1.4
birds       ch12    "Half-Speed Mockingbird"                 lufs=-27 pan=40 verb=0.4
gong        ch13    "Cedar Gong"                             lufs=-25 verb=0.5

