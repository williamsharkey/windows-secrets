  "text": {
    "tagline": "The great workstations, archived.",
    "blurb": "{count} programs that reference the classic workstations, samplers and synthesizers of 1985 to 1994, programmed from scratch for the Sound Recorder synthesizers. Volumes 1, 2 and 3 of the ROM Reference series on one disc.",
    "intro": [
      "HAA-CD 0094 collects Volumes 1, 2 and 3 of the ROM Reference series: {count} programs that reference the factory sounds of the workstations and samplers found in professional studios between 1985 and 1994.",
      "No sample or program from any instrument maker was used. Every program was built from the operating-system sounds with Sound Recorder, then compared by ear against the reference in Studio C."
    ],
    "maker_note": [
      "Programs are sorted by category. Names describe the sound, not the instrument it references. A cross-reference sheet is available to registered studios on request.",
      "Halvorsen Audio Archives libraries are used in film, television and game post-production. Ask your dealer for the full HAA catalogue.",
      "E. Halvorsen, Producer"
    ],
    "install": [
      "Load HAA-CD 0094. In the Library tab the disc appears as HAA_CD0094.",
      "Programs are in one directory per category. Double-click a program file (.BSP) to load it.",
      "The program index is HAA0094.PDF and PRESETS.TSV."
    ],
    "license": [
      "HALVORSEN AUDIO ARCHIVES LICENCE",
      "The purchaser may use the programs on this disc in commercial and non-commercial productions without further fees.",
      "The programs may not be resold, lent or distributed as a library, in whole or in part, on any medium.",
      "One licence per facility. Multi-room facilities: contact HAA."
    ],
