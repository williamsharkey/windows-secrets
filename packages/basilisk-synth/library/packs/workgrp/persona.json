  "text": {
    "tagline": "Four-on-the-floor productivity for the whole department.",
    "blurb": "Bring the dance floor to your desktop! Twenty deep, classic and French house presets, made for teams that groove together. Plus: 50 FREE hours on the InfoLane online service and our exclusive Keyword WORKGROUP area!",
    "intro": [
      "Welcome to Workgroup House Edition, the first interactive house music collection for the networked office! {count} presets of deep, classic and French house are ready to play on your Sound Recorder synthesizer. No samplers. No studio. Just point, click and groove!",
      "Workgroup House Edition is also your passport to the Velvetline online area. Use Keyword WORKGROUP to download new presets every month, chat with other house heads in the Groove Room, and enter our monthly Mix Contest."
    ],
    "maker_note": [
      "At Velvetline Multimedia, we believe the information superhighway should have a beat. Workgroup House Edition is the result of six months of late nights by the Groove Team, and we think it is our best CD-ROM yet.",
      "See you online!",
      "The Velvetline Groove Team"
    ],
    "install": [
      "Insert the Workgroup House Edition CD-ROM. In the Library tab, it appears as the drive WORKHOUSE97.",
      "Open a folder (Bass, Keys, Stabs and more) and double-click any preset to load it.",
      "To go online, see FREEHRS.TXT for your 50 free hours, then use Keyword WORKGROUP."
    ],
    "license": [
      "VELVETLINE MULTIMEDIA, INC. LICENSE AGREEMENT",
      "You may use Workgroup House Edition on one computer at a time. Music you make with the presets is yours, royalty-free, for any purpose, including office parties.",
      "You may not copy this CD-ROM except for one backup copy. The online trial offer is limited to one per household and requires a credit card. Hourly charges apply after the trial period.",
      "THE SOFTWARE IS PROVIDED AS IS. VELVETLINE IS NOT RESPONSIBLE FOR LOST PRODUCTIVITY."
    ],
    "copyright": "Copyright (C) 1997 Velvetline Multimedia, Inc. All rights reserved.",
    "files": {
      "FREEHRS.TXT": [
        "|=================================================",
        "|  50 FREE HOURS ON THE INFOLANE ONLINE SERVICE!",
        "|=================================================",
        "Try the InfoLane online service FREE for 50 hours in your first month! Get e-mail, chat rooms, news, games and the Velvetline area, all for one low monthly price after your trial.",
        "To sign up, run the InfoLane setup from the InfoLane folder of your trial disk, or call 1-800-555-0165 for a free trial disk. Have your credit card ready. Your registration number is WGH-97-0117-5546.",
        "Free hours must be used in the first calendar month. Phone charges may apply."
      ],
      "ONLINE.TXT": [
        "VELVETLINE ONLINE",
        "Keyword WORKGROUP takes you to the Workgroup House area. There you can download Preset of the Month, chat in the Groove Room every Thursday at 9 pm Eastern, and enter the Mix Contest.",
        "On the World Wide Web: http://www.velvetline-mm.com/house/ (best viewed with a 4.0 browser at 800x600)."
      ]
    }
