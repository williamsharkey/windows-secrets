# Var. IX: Steam and Static: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Var. IX: Steam and Static
track    = 10
note     = The interlude, in G-flat at 60 with no drums: grain clouds made from the steam wand, the rain and the glass piano follow the harmony; the theme crosses once on the crystal bell, every note twice as long.
pack     = rainy-loft
kind     = original
album    = CITYPOP DEPROGRAMMED
composer = Algorithmic Industries (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
midi     = 10-steam-and-static.mid
script   = 10-steam-and-static.py

[master]
loudness = -17
ceiling  = -1.0
fadeout  = 5.0

[echo]
time     = 3/8
feedback = 0.4
tone     = 2400
pingpong = yes
level    = -7
lowcut   = 250

[reverb]
size     = 4.0
predelay = 30
tone     = 4800
level    = -4
seed     = 3120

[tracks]
# name      source  preset                                  mix
rain        ch13    "Rain on the Window"                     lufs=-30
static      ch8     "Radio Static"                           lufs=-38 hp=400 lp=6000 pan=-30
wand        ch7     "Steam Wand"                             lufs=-32 pan=34 verb=0.3
cloud       ch1     "Glass Cloud"                            lufs=-21 verb=0.5 echo=0.2
steam       ch2     "Steam Cloud"                            lufs=-30 hp=300 verb=0.4
bell        ch3     "Crystal Bb"                             lufs=-21 pan=-16 verb=0.5 echo=0.25
bass        ch4     "Fretless Harbour"                       lufs=-25 lp=900
glass       ch5     "Glass Tine"                             lufs=-24 pan=28 verb=0.55 echo=0.3
choir       ch6     "Mist Choir"                             lufs=-30 pan=-10 verb=0.6
