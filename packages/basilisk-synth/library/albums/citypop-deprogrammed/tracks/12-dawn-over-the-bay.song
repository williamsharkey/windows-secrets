# Finale: Dawn over the Bay, Deprogrammed: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Finale: Dawn over the Bay, Deprogrammed
track    = 12
note     = The theme comes home in E-flat with the night around it (the inversion as a counter-line, the motto traded, the fast version), the caprice figure as a hinge into F, everything pushed and full, then the motto slowly on the bell; the first track ended on the IV, this one on the I, as the birds start.
pack     = rainy-loft
kind     = original
album    = CITYPOP DEPROGRAMMED
composer = Algorithmic Industries (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
midi     = 12-dawn-over-the-bay.mid
script   = 12-dawn-over-the-bay.py

[master]
loudness = -16
ceiling  = -1.0
fadeout  = 5.0

[echo]
time     = 3/16
feedback = 0.3
tone     = 2800
pingpong = yes
level    = -7
lowcut   = 220

[reverb]
size     = 2.6
predelay = 22
tone     = 5200
level    = -5
seed     = 3122

[tracks]
# name      source  preset                                  mix
rain        ch13    "Rain on Glass"                          lufs=-32
dawn        ch14    'dna:bird_dawn_chorus_bryce#4F;A4000R4000V70' lufs=-32 hp=300 pan=-10 verb=0.2
harbour     ch15    "Harbour Horn"                           lufs=-34 pan=40 verb=0.4 lp=3000
ep          ch1     "Loft Tine"                              lufs=-20 pan=-16 verb=0.22 echo=0.05
bass        ch2     "Fretless Harbour"                       lufs=-20
reed        ch3     "Harbour Reed"                           lufs=-18 pan=8 verb=0.28 echo=0.12
trumpet     ch4     "Harmon Glow"                            lufs=-21 pan=-8 verb=0.3 echo=0.1
strings     ch5     "studio-archive:Humid Swell"             lufs=-23 pan=-36 verb=0.45
choir       ch6     "Mist Choir"                             lufs=-27 pan=22 verb=0.55
glass       ch7     "Glass Tine"                             lufs=-24 pan=36 verb=0.35 echo=0.18
flute       ch8     "Night Flute"                            lufs=-22 pan=-24 verb=0.35 echo=0.12
brass       ch9     "polysynth-showroom:Signal Stab"         lufs=-25 pan=26 verb=0.2
synth       ch16    "polysynth-showroom:Violet Pilot"        lufs=-24 pan=10 verb=0.25 echo=0.15
bell        ch12    "Crystal Bb"                             lufs=-22 pan=-20 verb=0.5 echo=0.25
kit         ch10    "Loft Sticks"                            lufs=-20 verb=0.1
perc        ch11    "Loft Percussion"                        lufs=-28 pan=30 verb=0.12
