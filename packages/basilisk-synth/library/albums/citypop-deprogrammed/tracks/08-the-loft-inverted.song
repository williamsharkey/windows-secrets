# Var. VII: The Loft, Inverted: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Var. VII: The Loft, Inverted
track    = 8
note     = The slow heart: the theme inverted in D-flat at 66, re-harmonised; soft piano alone, then violins and cellos, choir and glass piano on the inverted B, a climax a tone higher with horns, the piano alone again.
pack     = rainy-loft
kind     = original
album    = CITYPOP DEPROGRAMMED
composer = Algorithmic Industries (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
midi     = 08-the-loft-inverted.mid
script   = 08-the-loft-inverted.py

[master]
loudness = -16
ceiling  = -1.0
fadeout  = 4.0

[echo]
time     = 1/4
feedback = 0.3
tone     = 2600
pingpong = yes
level    = -9
lowcut   = 250

[reverb]
size     = 3.4
predelay = 28
tone     = 5000
level    = -4
seed     = 3118

[tracks]
# name      source  preset                                  mix
rain        ch13    "Balcony Rain"                           lufs=-36
piano       ch1     "Felt Upright"                           lufs=-19 pan=-8 verb=0.35
violins     ch2     "Legato Violins"                         lufs=-21 pan=-26 verb=0.45
cellos      ch3     "Legato Cellos"                          lufs=-23 pan=24 verb=0.4
choir       ch4     "Mist Choir"                             lufs=-26 pan=8 verb=0.55
harp        ch5     "Harbour Harp"                           lufs=-27 pan=40 verb=0.4 echo=0.1
horns       ch6     "Ferry Horns"                            lufs=-24 pan=-14 verb=0.45
bass        ch7     "Fretless Harbour"                       lufs=-24
glass       ch8     "Glass Tine"                             lufs=-22 pan=30 verb=0.4 echo=0.15
flute       ch9     "Late Flute"                             lufs=-26 pan=-36 verb=0.5 echo=0.2
kit         ch10    "Loft Brushes"                           lufs=-28 verb=0.25
