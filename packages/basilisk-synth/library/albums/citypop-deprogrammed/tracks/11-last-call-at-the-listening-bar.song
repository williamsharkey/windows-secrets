# Var. X: Last Call at the Listening Bar: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Var. X: Last Call at the Listening Bar
track    = 11
note     = Jazz-funk in D-flat at 88, swung: the theme over tritone substitutions, sixteen bars of electric piano, reed and piano trading fours, B on strings, the last A a semitone up; glasses on the counter.
pack     = rainy-loft
kind     = original
album    = CITYPOP1993
composer = Algorithmic Industries (an original for SNDWAVE1993)
licence  = CC0-1.0 (the composition and this arrangement)
midi     = 11-last-call-at-the-listening-bar.mid
script   = 11-last-call-at-the-listening-bar.py

[master]
loudness = -16
ceiling  = -1.0
fadeout  = 3.0

[echo]
time     = 3/16
feedback = 0.28
tone     = 2800
pingpong = yes
level    = -8
lowcut   = 250

[reverb]
size     = 2.0
predelay = 18
tone     = 5200
level    = -6
seed     = 3121

[tracks]
# name      source  preset                                  mix
room        ch13    "City Hush"                              lufs=-36
glasses     ch7     "Glasses on the Counter"                 lufs=-30 pan=36 verb=0.3
ep          ch1     "Loft Tine"                              lufs=-18 pan=-10 verb=0.22 echo=0.05
bass        ch2     "Pluck Avenue"                           lufs=-20 vel=0.75
reed        ch3     "Harbour Reed"                           lufs=-19 pan=14 verb=0.28 echo=0.12
clarinet    ch4     "Clarinet After Hours"                   lufs=-24 pan=-24 verb=0.3
strings     ch5     "Velvet Strings"                         lufs=-26 pan=32 verb=0.45
vibes       ch6     "Lobby Vibraphone"                       lufs=-25 pan=40 verb=0.35 echo=0.15
kit         ch10    "Loft Sticks"                            lufs=-22 verb=0.12
perc        ch11    "Loft Percussion"                        lufs=-32 pan=-30 verb=0.1
