# Var. I: Espresso, Two Sugars: a SNDWAVE2000 song demo (tools/songrender/README.md has the format)

title    = Var. I: Espresso, Two Sugars
track    = 2
note     = The theme in F, as a light shuffle: the motto traded between vibraphone and suitcase piano (once as written, once upside down), the flute an eighth late, muted trumpet on B, two choruses, a stop-time.
pack     = rainy-loft
kind     = original
album    = CITYPOP DEPROGRAMMED
composer = Harborlight Audio Works House Ensemble (an original for SNDWAVE2000)
licence  = CC0-1.0 (the composition and this arrangement)
midi     = 02-espresso-two-sugars.mid
script   = 02-espresso-two-sugars.py

[master]
loudness = -16
ceiling  = -1.0
fadeout  = 3.0

[echo]
time     = 1/8
feedback = 0.28
tone     = 3000
pingpong = yes
level    = -7
lowcut   = 220

[reverb]
size     = 1.8
predelay = 16
tone     = 5500
level    = -6
seed     = 3112

[tracks]
# name      source  preset                                  mix
room        ch13    "City Hush"                              lufs=-36
vinyl       ch14    "Vinyl Dust"                             lufs=-40 hp=150
cafe        ch12    "Espresso Bar"                           lufs=-30 pan=-35 verb=0.15
spoon       ch9     "Cup and Spoon"                          lufs=-32 pan=30 verb=0.15
ep          ch1     "Suitcase Night"                         lufs=-19 pan=-14 verb=0.2
bass        ch2     "Pluck Avenue"                           lufs=-20
flute       ch3     "Night Flute"                            lufs=-20 pan=10 verb=0.3 echo=0.12
vibes       ch4     "courtyard-chapel:Delta Tower"           lufs=-21 pan=24 verb=0.25 echo=0.1
horn        ch5     "Harmon Glow"                            lufs=-21 pan=-8 verb=0.3 echo=0.08
organ       ch6     "tape-parlour:Night Stops"               lufs=-29 pan=16 verb=0.2 tune=-25
kit         ch10    "Loft Sticks"                            lufs=-20 verb=0.1
perc        ch11    "Loft Percussion"                        lufs=-27 pan=-24 verb=0.12
