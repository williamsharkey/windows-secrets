\pard\sa30\li395\ri175\plain\f0\fs20 {\ul semitone}{\v term_semitone}\par
\pard\sa30\li395\ri175\plain\f0\fs20 {\ul step}{\v term_step}\par
\pard\sa30\li395\ri175\plain\f0\fs20 {\ul transpose}{\v term_transpose}\par
