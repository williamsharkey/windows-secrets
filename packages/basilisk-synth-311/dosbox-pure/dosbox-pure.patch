 	else if (!strcasecmp(ext, "IMG") || !strcasecmp(ext, "IMA") || !strcasecmp(ext, "VHD") || !strcasecmp(ext, "JRC"))
@@ -1499,9 +1505,11 @@ Bit8u* GFX_GetPixels(Bitu& pitch)
 	return (Bit8u*)(buf.video + (buf.width * buf.pad_y + buf.pad_x));
 }
 
+extern bool BSYN_NoVideo(void);
 bool GFX_StartUpdate(Bit8u*& pixels, Bitu& pitch)
 {
 	if (dbp_state == DBPSTATE_BOOT) return false;
+	if (BSYN_NoVideo()) { dbp_framecount += 1 + render.frameskip.max; return false; } // SNDWAVE2000: nobody watches (a headless engine, or no editor open): no scaling, no frame; the frame still counts (retro_run waits for it)
 	DBP_FPSCOUNT(dbp_fpscount_gfxstart)
 	Bit32u w = (Bit32u)render.src.width, h = (Bit32u)render.src.height, pad_x = 0, pad_y = 0, pad_offset = 0;
 	if (dbp_doublescan)
@@ -3619,6 +3627,7 @@ void retro_run(void)
 
 	bool skip_emulate = (fpsboost > 1 && (((fpsboost_count++)%fpsboost)!=0)) || DBP_NeedFrameSkip(false);
 	DBP_ThreadControl(skip_emulate ? TCM_PAUSE_FRAME : TCM_FINISH_FRAME);
+	{ extern void BSYN_FrameBoundary(void); if (!skip_emulate) BSYN_FrameBoundary(); } // BASILISK 16: the host's events and reports pass here (offline: renders independent of the wall clock)
 
 	Bit32u tpfActual = 0, tpfTarget = 0, tpfDraws = 0;
 	#ifdef DBP_ENABLE_WAITSTATS
@@ -3663,6 +3672,11 @@ void retro_run(void)
 	if (dbp_opengl_draw && voodoo_ogl_mainthread()) { view_width *= voodoo_ogl_scale; view_height *= voodoo_ogl_scale; }
 
 	DBP_ThreadControl(skip_emulate ? TCM_RESUME_FRAME : TCM_NEXT_FRAME);
+	{ // BASILISK 16, offline (the card's gate on): the frame is emulated now, not on its own thread after we return, so
+	  // the host writes only while the machine stands still and its events pass at the next frame's start
+		extern bool BSYN_Gated(void); extern void BSYN_FrameBoundary(void);
+		if (!skip_emulate && BSYN_Gated()) { DBP_ThreadControl(TCM_FINISH_FRAME); BSYN_FrameBoundary(); }
